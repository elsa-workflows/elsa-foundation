<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Every package of the prototype comes from nuget.org, with a version pinned in its project. -->
  <packageSourceMapping>
    <clear />
    <!-- One source. The Bpmn.* packages (valence-works/bpmn, MIT) are named so their origin is explicit. -->
    <packageSource key="nuget.org">
      <package pattern="Bpmn.Model" />
      <package pattern="Bpmn.Semantics" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
