<Project>
  <!-- Standalone prototype: nothing is inherited from the repository. -->
  <Target Name="CheckKernelContractReferences" BeforeTargets="ResolveReferences" Condition="'$(KernelContractOnly)' == 'true'">
    <ItemGroup>
      <!-- ResolveReferences includes Native's SDK-supplied transitive dependencies on Graph and Native.Activities.
           Statecharts.Native may use those transitively, but may declare only Native and Statecharts beyond contracts. -->
      <_UnexpectedKernelProject Include="@(ProjectReference)" Condition="'%(ProjectReference.Filename)' != 'Elsa.ActorFoundation.Contracts' And '%(ProjectReference.Filename)' != 'Elsa.ActorFoundation.Model.Contracts' And
        ('$(MSBuildProjectName)' != 'Kernel.Statecharts.Native' Or ('%(ProjectReference.Filename)' != 'Kernel.Native' And '%(ProjectReference.Filename)' != 'Kernel.Statecharts')) And
        (('$(MSBuildProjectName)' != 'Kernel.Native' And ('$(MSBuildProjectName)' != 'Kernel.Statecharts.Native' Or '%(ProjectReference.DefiningProjectName)' != 'Microsoft.PackageDependencyResolution')) Or ('%(ProjectReference.Filename)' != 'Kernel.Graph' And '%(ProjectReference.Filename)' != 'Kernel.Native.Activities'))" />
    </ItemGroup>
    <Error Condition="'@(_UnexpectedKernelProject)' != ''" Text="Layer 3 may reference only the kernel contract projects. Unexpected project: @(_UnexpectedKernelProject)" />
  </Target>
</Project>
