<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Kernel.Ef.Run</RootNamespace>
    <NoWarn>$(NoWarn);EF1002</NoWarn>
    <!-- ENGINES.md E2: Microsoft.Data.SqlClient refuses to open a connection in invariant-globalization mode. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../sim/Models.cs" Link="Models.cs" />
    <Compile Include="../../sim/Correlation.cs" Link="Correlation.cs" />
    <ProjectReference Include="../Kernel.EntityFramework/Kernel.EntityFramework.csproj" />
    <ProjectReference Include="../../src/Kernel.Workflows/Kernel.Workflows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Kernel.Runtime" />
    <Using Include="Kernel.Durable" />
    <Using Include="Kernel.Workflows" />
  </ItemGroup>
</Project>
