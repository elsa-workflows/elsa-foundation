<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Kernel.Ef.Conformance</RootNamespace>
    <NoWarn>$(NoWarn);EF1002</NoWarn>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- ENGINES.md E2: Microsoft.Data.SqlClient refuses to open a connection in invariant-globalization mode. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Kernel.EntityFramework/Kernel.EntityFramework.csproj" />
    <ProjectReference Include="../../conformance/Kernel.Store.Conformance/Kernel.Store.Conformance.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Kernel.Runtime" />
    <Using Include="Kernel.Durable" />
    <Using Include="Kernel.Workflows" />
  </ItemGroup>
</Project>
