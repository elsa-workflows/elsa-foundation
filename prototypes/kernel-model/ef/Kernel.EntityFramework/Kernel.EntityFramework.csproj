<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Kernel.EntityFramework</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);EF1002</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Carry these central floors into prototype projects which do not use central package management. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Kernel.Durable/Kernel.Durable.csproj" />
    <ProjectReference Include="../../../../essentials/src/ActorFoundation/Contracts/Elsa.ActorFoundation.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kernel.Ef.Conformance" />
    <InternalsVisibleTo Include="Kernel.Foundation.Postgres" />
    <InternalsVisibleTo Include="Kernel.Native.Run" />
    <Using Include="Kernel.Runtime" />
    <Using Include="Kernel.Durable" />
  </ItemGroup>
</Project>
