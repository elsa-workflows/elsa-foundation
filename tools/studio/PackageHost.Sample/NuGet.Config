<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="candidate" value="./packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="CShells" value="https://f.feedz.io/valence-works/cshells/nuget/index.json" />
    <add key="Nuplane" value="https://f.feedz.io/valence-works/nuplane/nuget/index.json" />
    <add key="Specifications" value="https://f.feedz.io/elsa-workflows/elsa-4/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="candidate">
      <package pattern="Elsa.Studio.*" />
      <package pattern="Elsa.Modularity.*" />
    </packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="CShells"><package pattern="CShells" /><package pattern="CShells.*" /></packageSource>
    <packageSource key="Nuplane"><package pattern="Nuplane" /><package pattern="Nuplane.*" /></packageSource>
    <packageSource key="Specifications"><package pattern="Elsa.Specifications.*" /></packageSource>
  </packageSourceMapping>
</configuration>
