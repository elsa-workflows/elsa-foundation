using System.Text.Json;
using Elsa.Weaver.Core.Contracts;
using Elsa.Weaver.Core.Models;

namespace Acme.Home.Weaver;

internal sealed class WidgetCapabilities : IWeaverCapabilityProvider
{
    public ValueTask<IReadOnlyCollection<WeaverCapability>> GetCapabilitiesAsync(CancellationToken cancellationToken = default)
    {
        cancellationToken.ThrowIfCancellationRequested();
        return ValueTask.FromResult<IReadOnlyCollection<WeaverCapability>>([
            new("acme.home.read", WidgetContract.Module, "Explain Acme status card", "Read current personal visibility without exposing the full Home layout.",
                WeaverCapabilityKind.Answer, WeaverRisk.ReadOnly, WidgetContract.Scopes, [WidgetContract.ReadPermission], [WidgetContract.ContextType]) { Modes = ["explain"] },
            new("acme.home.visibility", WidgetContract.Module, "Review Acme status card visibility", "Review showing or hiding the existing card in the current personal Home layout.",
                WeaverCapabilityKind.Proposal, WeaverRisk.ReviewRequired, WidgetContract.Scopes,
                [WidgetContract.ReadPermission, WidgetContract.WritePermission], [WidgetContract.ContextType]) { Modes = ["build"] },
            new("acme.home.size", WidgetContract.Module, "Change Acme status card size", "Set the existing personal card size to small or medium under the current session policy.",
                WeaverCapabilityKind.Action, WeaverRisk.ReviewRequired, WidgetContract.Scopes,
                [WidgetContract.ReadPermission, WidgetContract.WritePermission], [WidgetContract.ContextType]) { Modes = ["build"] }
        ]);
    }
}

internal sealed class WidgetContextSource(WidgetResource resource, IWeaverSessionService sessions) : IWeaverContextProvider
{
    public WeaverContextProviderDescriptor Descriptor { get; } = new("acme.home.widget-context", WidgetContract.Module, "acme-home",
        [WidgetContract.ContextType, WidgetContract.GuidanceType], ["1"], [WidgetContract.ResourceType]);

    public async ValueTask<WeaverContextContribution> CollectAsync(WeaverContextRequest request, CancellationToken cancellationToken = default)
    {
        try
        {
            var session = await sessions.FindAsync(request.SessionId, cancellationToken);
            if (session is null || string.IsNullOrWhiteSpace(session.ActorId) || string.IsNullOrWhiteSpace(session.TenantId))
                WidgetContract.Refuse("session_denied", "A current personal Weaver session is required.", 403);
            var state = await resource.ObserveAsync(session!.ActorId, session.TenantId, false, cancellationToken);
            if (request.Target is not null && !WidgetContract.SameTarget(request.Target, state))
                WidgetContract.Refuse("context_stale", "The requested Acme status card reference is foreign or stale.");
            // Caller content, labels, references and origin never become installed instructions or owner data.
            if (request.CallerAttachments.Count > 1 || request.CallerAttachments.Any(item => item.ModuleId != WidgetContract.Module ||
                    item.ContentType != WidgetContract.ContextType || item.SchemaVersion != "1" || !WidgetContract.SameTarget(item.Target, state)))
                WidgetContract.Refuse("context_invalid", "Only a current Acme status card reference is supported.");
            var sensitivity = request.CallerAttachments.Select(item => item.Sensitivity == WeaverContextSensitivity.SecretRedacted
                ? WeaverContextSensitivity.Secret : item.Sensitivity).Append(WeaverContextSensitivity.Internal).Max();
            var canonical = new WeaverContextAttachment("acme.home:widget:" + state.Document.Revision, WidgetContract.ContextType, WidgetContract.WidgetId,
                "Acme status card", WidgetContract.ContextType, sensitivity, WidgetContract.Route,
                "Current personal Acme status card visibility, reread from the owning Home layout.",
                JsonSerializer.SerializeToElement(new { widgetId = WidgetContract.WidgetId, visible = state.Visible, revision = state.Document.Revision }),
                new Dictionary<string, string>())
            {
                ModuleId = WidgetContract.Module, SchemaVersion = "1", Target = WidgetContract.Target(state),
                Origin = WeaverContextOrigin.AuthoritativeRead, AgentScopes = WidgetContract.Scopes
            };
            return new([canonical, InstalledGuidance()], []);
        }
        catch (WidgetRefusal refusal) { return new([], [new(Descriptor.Id, refusal.Error.Code, refusal.Error.Message, true)]); }
    }

    public async ValueTask<WeaverContextContribution> AdmitDisclosureAsync(WeaverContextDisclosureRequest request, CancellationToken cancellationToken = default)
    {
        try
        {
            var session = await sessions.FindAsync(request.SessionId, cancellationToken);
            if (session is not { Status: WeaverSessionStatus.Active } || string.IsNullOrWhiteSpace(session.ActorId)
                || string.IsNullOrWhiteSpace(session.TenantId) || session.ExpiresAt <= DateTimeOffset.UtcNow)
                WidgetContract.Refuse("session_denied", "A current personal Weaver session is required.", 403);
            // The actual owner enforces current principal, tenant, host and read permission.
            // This observation does not repeat a reviewed effect or rewrite its stored receipt.
            var state = await resource.ObserveAsync(session!.ActorId, session.TenantId, false, cancellationToken);
            var retained = new List<WeaverContextAttachment>();
            foreach (var item in request.Context)
            {
                if (item.ModuleId != WidgetContract.Module || item.SchemaVersion != "1")
                    WidgetContract.Refuse("disclosure_invalid", "The retained context belongs to another module or schema.");
                if (item.ContentType == WidgetContract.GuidanceType && item.Origin == WeaverContextOrigin.InstalledGuidance) continue;
                if (item.ContentType != WidgetContract.ContextType)
                    WidgetContract.Refuse("disclosure_invalid", "The retained context kind is unsupported.");
                if (item.Sensitivity != WeaverContextSensitivity.SecretRedacted)
                {
                    if (!OwnTarget(item.Target))
                        WidgetContract.Refuse("disclosure_invalid", "The retained context does not identify this personal status card.");
                    if (!request.IsHistorical && !request.IsReceiptContinuation && !WidgetContract.SameTarget(item.Target, state))
                        WidgetContract.Refuse("context_stale", "The accepted Acme status card reference has changed; submit fresh context.");
                }
                retained.Add(item);
            }
            foreach (var result in request.Results)
                if (result.Access is { } access && access.ModuleId != Descriptor.ModuleId
                    || !OwnTarget(result.Access?.Target ?? result.Receipt?.After))
                    WidgetContract.Refuse("disclosure_invalid", "The retained result does not identify this module's status card.");
            if (request.IsReceiptContinuation)
                return new([InstalledGuidance()], [new(Descriptor.Id, "acme.home.context.receipt_only",
                    "The prior resource snapshot is withheld; the accepted outcome is historical evidence, not a fresh read.", false)]);
            retained.Add(InstalledGuidance());
            return new(retained, []);
        }
        catch (WidgetRefusal refusal) { return new([], [new(Descriptor.Id, refusal.Error.Code, refusal.Error.Message, true)]); }
    }

    private static bool OwnTarget(WeaverResourceTarget? target) => target is
        { ModuleId: WidgetContract.Module, ResourceType: WidgetContract.ResourceType, ResourceId: WidgetContract.WidgetId };

    private static WeaverContextAttachment InstalledGuidance() => new("acme.home:installed-guidance", "acme.home.module", null, "Acme Home guidance",
        WidgetContract.GuidanceType, WeaverContextSensitivity.Public, "module",
        "The Acme module reads the existing personal status card, proposes one reviewed boolean visibility change, and can set its size to exactly small or medium. " +
        "The size operation is eligible for automatic execution only when the current server session policy permits it; visibility always requires review. Use only the declared tools. " +
        "A persisted receipt confirms the personal Home layout; reload native Home to observe it. Missing personal layouts/cards, stale revisions and no-op changes are refused. " +
        "Other widgets, options and default layouts are outside this contribution. An uncertain result must be reread and never replayed automatically.",
        null, new Dictionary<string, string>())
    {
        ModuleId = WidgetContract.Module, SchemaVersion = "1", Origin = WeaverContextOrigin.InstalledGuidance, AgentScopes = []
    };
}
