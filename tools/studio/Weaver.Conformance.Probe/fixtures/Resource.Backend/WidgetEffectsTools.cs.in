using System.Text.Json;
using Elsa.Agent.Core.Contracts;
using Elsa.Agent.Core.Models;

namespace Acme.Home.Weaver;

internal abstract class WidgetEffectsTool(WidgetEffectOwner owner, WidgetFaultControl faults, string name,
    AgentRisk descriptorRisk, AgentRisk preparedRisk, IReadOnlyList<AgentPrivilegeClass> classes, bool check = false)
    : IAgentTool, IAgentToolAuthorization
{
    public AgentToolDescriptor Descriptor { get; } = new(name,
        check ? "Check Acme status card" : "Classed Acme visibility change",
        check ? "Run a check against the actual personal widget without changing its persisted layout."
            : "Change only personal widget visibility with this fixture's explicitly declared privilege requirement.",
        AgentToolMutability.Mutating, descriptorRisk,
        check ? """{"type":"object","required":["expectedVisible"],"properties":{"expectedVisible":{"type":"boolean"}},"additionalProperties":false}"""
            : """{"type":"object","required":["visible"],"properties":{"visible":{"type":"boolean"}},"additionalProperties":false}""",
        [WidgetContract.ReadPermission, WidgetContract.WritePermission], WidgetContract.Scopes)
    {
        ModuleId = WidgetContract.Module, ModuleCodes = WidgetEffects.Codes,
        ResultType = check ? WidgetEffects.CheckResult : WidgetContract.ChangeResult, ResultSchemaVersion = "1",
        ResultJsonSchema = check ? WidgetEffects.CheckSchema : WidgetToolValidation.ChangeSchema,
        ResultRendererId = check ? WidgetEffects.CheckRenderer : WidgetContract.Renderer,
        DisclosureSourceId = WidgetEffects.Source, CanPerformWithoutPersistence = check
    };

    public async ValueTask<AgentPolicyDecision> AuthorizeAsync(string actorId, string tenantId, AgentResourceTarget? target,
        CancellationToken cancellationToken = default)
    {
        try
        {
            await owner.AuthorizeAsync(actorId, tenantId, true, cancellationToken);
            if (target is not null && !Own(target))
                throw WidgetEffects.Refusal(WidgetEffects.Foreign, "This operation belongs to the personal widget.", 403);
            if (faults.Read("authorization") is { } fault)
                return new(false, [new(fault.Code, fault.Message) { OwnerUnavailable = fault.OwnerUnavailable }]);
            return new(true, []);
        }
        catch (WidgetRefusal error)
        { return new(false, [new(error.Error.Code, error.Error.Message) { OwnerUnavailable = error.Error.OwnerUnavailable }]); }
    }

    public async Task<AgentResult<AgentToolPreparation>> PrepareAsync(AgentToolInvocation invocation, CancellationToken cancellationToken = default)
    {
        try
        {
            if (invocation.ToolName != Descriptor.Name || !invocation.AllowMutations)
                throw WidgetEffects.Refusal(WidgetEffects.Invalid, "This request does not admit the widget operation.", 400);
            var value = Boolean(JsonSerializer.SerializeToElement(invocation.Arguments), check ? "expectedVisible" : "visible");
            var state = await owner.ObserveAsync(invocation.ActorId, invocation.TenantId, true, cancellationToken);
            var references = invocation.Context.Where(item => item.ContentType == WidgetEffects.Context).ToArray();
            if (references.Length != 1 || references[0].ModuleId != WidgetContract.Module || references[0].SchemaVersion != "1"
                || !WidgetContract.SameTarget(references[0].Target, state))
                throw WidgetEffects.Refusal(WidgetEffects.Stale, "One current owner effects reference is required.");
            if (faults.Read("preparation") is { } fault) return Failure<AgentToolPreparation>(fault);
            if (!check && state.Visible == value)
                throw WidgetEffects.Refusal(WidgetEffects.Invalid, "The personal widget already has this visibility.");
            var preview = check ? CheckPreview(state, value) : WidgetContract.Preview(state, value);
            return AgentResult<AgentToolPreparation>.Success(new(WidgetContract.Target(state),
                check ? JsonSerializer.SerializeToElement(new { expectedVisible = value }) : JsonSerializer.SerializeToElement(new { visible = value }),
                preparedRisk, preview, true) { RequiredPrivilegeClasses = classes });
        }
        catch (WidgetRefusal error) { return new(default, error.Error); }
    }

    public async Task<AgentResult<AgentToolResult>> ExecuteAsync(AgentPreparedToolInvocation invocation, CancellationToken cancellationToken = default)
    {
        try
        {
            if (invocation.ToolName != Descriptor.Name || invocation.ModuleId != WidgetContract.Module || invocation.ToolContractVersion != "1"
                || invocation.ExecutionLocation != AgentExecutionLocation.Server || invocation.Client is not null || !invocation.RequiresApproval
                || string.IsNullOrWhiteSpace(invocation.InvocationId) || string.IsNullOrWhiteSpace(invocation.ToolCallId)
                || invocation.ExpiresAt <= DateTimeOffset.UtcNow || invocation.Risk != Max(descriptorRisk, preparedRisk))
                throw WidgetEffects.Refusal(WidgetEffects.Invalid, "The prepared widget operation is invalid.", 400);
            var value = Boolean(invocation.Arguments, check ? "expectedVisible" : "visible");
            var state = await owner.ObserveAsync(invocation.ActorId, invocation.TenantId, true, cancellationToken);
            if (!WidgetContract.SameTarget(invocation.Target, state))
                throw WidgetEffects.Refusal(WidgetEffects.Stale, "The prepared personal widget revision changed.");
            var preview = check ? CheckPreview(state, value) : WidgetContract.Preview(state, value);
            if (invocation.Preview.TypeId != preview.TypeId || invocation.Preview.SchemaVersion != "1"
                || !JsonElement.DeepEquals(invocation.Preview.Data, preview.Data))
                throw WidgetEffects.Refusal(WidgetEffects.Invalid, "The widget preview does not match this operation.", 400);
            if (faults.Read("execution") is { } failure) return Failure<AgentToolResult>(failure);
            var result = check ? await owner.CheckAsync(invocation, value, cancellationToken) : await owner.ApplyAsync(invocation, value, cancellationToken);
            if (result.Receipt is not null && faults.Read("receipt") is { } fault)
                result = result with { Content = fault.Message, Receipt = result.Receipt with { ModuleCode = fault.Code } };
            return AgentResult<AgentToolResult>.Success(result);
        }
        catch (WidgetRefusal error) { return new(default, error.Error); }
    }

    private static bool Own(AgentResourceTarget target) => target.ModuleId == WidgetContract.Module
        && target.ResourceType == WidgetContract.ResourceType && target.ResourceId == WidgetContract.WidgetId;

    private static bool Boolean(JsonElement value, string member)
    {
        if (value.ValueKind != JsonValueKind.Object || value.EnumerateObject().Count() != 1
            || !value.TryGetProperty(member, out var field) || field.ValueKind is not (JsonValueKind.True or JsonValueKind.False))
            throw WidgetEffects.Refusal(WidgetEffects.Invalid, "One explicit boolean argument is required.", 400);
        return field.GetBoolean();
    }

    private static AgentPayload CheckPreview(WidgetObservation state, bool expectedVisible) => new(WidgetEffects.CheckResult, "1",
        JsonSerializer.SerializeToElement(new { widgetId = WidgetContract.WidgetId, revision = state.Document.Revision,
            hostId = state.Key.StudioHostId, expectedVisible }));
    private static AgentRisk Max(AgentRisk first, AgentRisk second) => (AgentRisk)Math.Max((int)first, (int)second);
    private static AgentResult<T> Failure<T>(WidgetFault fault) => new(default,
        new(fault.Code, fault.Message, fault.OwnerUnavailable ? 503 : 409) { OwnerUnavailable = fault.OwnerUnavailable });
}

internal sealed class WidgetAdminTool(WidgetEffectOwner owner, WidgetFaultControl faults)
    : WidgetEffectsTool(owner, faults, WidgetEffects.Admin, AgentRisk.Admin, AgentRisk.Admin, [AgentPrivilegeClass.Administrative]);
internal sealed class WidgetIrrecoverableTool(WidgetEffectOwner owner, WidgetFaultControl faults)
    : WidgetEffectsTool(owner, faults, WidgetEffects.Irrecoverable, AgentRisk.Admin, AgentRisk.Admin,
        [AgentPrivilegeClass.Administrative, AgentPrivilegeClass.Irrecoverable]);
internal sealed class WidgetOmittedAdminTool(WidgetEffectOwner owner, WidgetFaultControl faults)
    : WidgetEffectsTool(owner, faults, WidgetEffects.OmittedAdmin, AgentRisk.Admin, AgentRisk.Admin, [AgentPrivilegeClass.Irrecoverable]);
internal sealed class WidgetRaisedRiskTool(WidgetEffectOwner owner, WidgetFaultControl faults)
    : WidgetEffectsTool(owner, faults, WidgetEffects.RaisedRisk, AgentRisk.ReviewRequired, AgentRisk.Admin, []);
internal sealed class WidgetActivationTool(WidgetEffectOwner owner, WidgetFaultControl faults)
    : WidgetEffectsTool(owner, faults, WidgetEffects.Activation, AgentRisk.ReviewRequired, AgentRisk.ReviewRequired, [AgentPrivilegeClass.Activation]);
internal sealed class WidgetCheckTool(WidgetEffectOwner owner, WidgetFaultControl faults)
    : WidgetEffectsTool(owner, faults, WidgetEffects.Check, AgentRisk.Admin, AgentRisk.Admin, [AgentPrivilegeClass.Administrative], check: true);
