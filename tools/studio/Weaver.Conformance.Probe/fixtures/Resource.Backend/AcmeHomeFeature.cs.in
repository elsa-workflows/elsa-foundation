using CShells.AspNetCore.Features;
using CShells.Features;
using Elsa.Weaver.Core.Contracts;
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Routing;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.DependencyInjection.Extensions;
using Microsoft.Extensions.Hosting;

namespace Acme.Home.Weaver;

[ShellFeature("AcmeHomeWidget", DisplayName = "Acme status card Weaver contribution",
    DependsOn = new object[] { "WeaverApi", "StudioPreferences" })]
public class AcmeHomeWidgetFeature : IWebShellFeature
{
    // Trusted operator configuration. Neither model arguments nor request headers select this key.
    public string StudioHostId { get; set; } = string.Empty;
    public string WriteRendezvousControlFile { get; set; } = string.Empty;
    public string WriteRendezvousReceiptFile { get; set; } = string.Empty;
    public string CheckObservationFile { get; set; } = string.Empty;
    public string EffectFaultControlFile { get; set; } = string.Empty;
    // Opt-in private observation. Provision WidgetExecutionJournal.Header first; missing files never mean observed zero.
    public string ExecutionObservationFile { get; set; } = string.Empty;

    public virtual void ConfigureServices(IServiceCollection services)
    {
        if (string.IsNullOrWhiteSpace(StudioHostId) || StudioHostId.Length > 128 ||
            StudioHostId.Any(c => !(char.IsAsciiLetterOrDigit(c) || c is '.' or '_' or '-')))
            throw new InvalidOperationException("AcmeHomeWidget requires a valid, fixed StudioHostId.");
        services.AddHttpContextAccessor();
        services.AddSingleton(new WidgetHost(StudioHostId));
        if (CheckObservationFile.Length > 0) WidgetFixtureFiles.Check(CheckObservationFile);
        if (EffectFaultControlFile.Length > 0) WidgetFixtureFiles.Check(EffectFaultControlFile);
        if (ExecutionObservationFile.Length > 0) WidgetFixtureFiles.Check(ExecutionObservationFile);
        var fixtureFiles = new[] { CheckObservationFile, EffectFaultControlFile, ExecutionObservationFile, WriteRendezvousControlFile, WriteRendezvousReceiptFile,
            ExecutionObservationFile.Length == 0 ? "" : ExecutionObservationFile + ".failed",
            WriteRendezvousControlFile.Length == 0 ? "" : WriteRendezvousControlFile + ".claimed" }.Where(path => path.Length > 0).ToArray();
        if (fixtureFiles.Distinct(StringComparer.Ordinal).Count() != fixtureFiles.Length)
            throw new InvalidOperationException("Widget observation and control files must be distinct.");
        services.TryAddSingleton(new WidgetEffectsSettings(CheckObservationFile, EffectFaultControlFile, ExecutionObservationFile));
        services.TryAddSingleton<WidgetRunJournal>();
        services.TryAddSingleton<WidgetExecutionJournal>();
        services.TryAddScoped<WidgetEffectOwner>();
        services.TryAddScoped<WidgetFaultControl>();
        var rendezvous = WidgetWriteRendezvous.Configure(WriteRendezvousControlFile, WriteRendezvousReceiptFile, StudioHostId);
        if (rendezvous is not null) services.TryAddSingleton(rendezvous);
        services.TryAddScoped(provider =>
        {
            var native = provider.GetRequiredService<Elsa.Studio.Preferences.Core.Contracts.IStudioPreferenceService>();
            var gate = provider.GetService<WidgetWriteRendezvous>();
            var http = provider.GetRequiredService<IHttpContextAccessor>();
            return new WidgetResource(http, provider.GetRequiredService<Elsa.Foundation.Identity.Core.Authentication.IAuthSessionService>(),
                provider.GetRequiredService<Elsa.Foundation.Identity.Core.Authorization.IPermissionAuthorizationService>(),
                gate is null ? native : new WidgetRendezvousPreferences(native, gate, http),
                provider.GetRequiredService<WidgetHost>());
        });
        services.TryAddEnumerable(ServiceDescriptor.Scoped<IWeaverContextProvider, WidgetContextSource>());
        services.TryAddEnumerable(ServiceDescriptor.Scoped<IWeaverCapabilityProvider, WidgetCapabilities>());
        services.TryAddEnumerable(ServiceDescriptor.Scoped<IWeaverTool, ReadWidgetTool>());
        services.TryAddEnumerable(ServiceDescriptor.Scoped<IWeaverTool, SetWidgetVisibilityTool>());
        services.TryAddEnumerable(ServiceDescriptor.Scoped<IWeaverTool, SetWidgetSizeTool>());
        services.TryAddEnumerable(ServiceDescriptor.Scoped<IWeaverContextProvider, WidgetEffectsContext>());
        services.TryAddEnumerable(ServiceDescriptor.Scoped<IWeaverCapabilityProvider, WidgetEffectsCapabilities>());
        services.TryAddEnumerable(ServiceDescriptor.Scoped<IWeaverTool, WidgetAdminTool>());
        services.TryAddEnumerable(ServiceDescriptor.Scoped<IWeaverTool, WidgetIrrecoverableTool>());
        services.TryAddEnumerable(ServiceDescriptor.Scoped<IWeaverTool, WidgetOmittedAdminTool>());
        services.TryAddEnumerable(ServiceDescriptor.Scoped<IWeaverTool, WidgetRaisedRiskTool>());
        services.TryAddEnumerable(ServiceDescriptor.Scoped<IWeaverTool, WidgetActivationTool>());
        services.TryAddEnumerable(ServiceDescriptor.Scoped<IWeaverTool, WidgetCheckTool>());
    }

    public virtual void MapEndpoints(IEndpointRouteBuilder endpoints, IHostEnvironment? environment)
    {
        endpoints.MapGet(WidgetEffects.ExecutionsEndpoint, async (HttpContext http, WidgetEffectOwner owner, CancellationToken ct) =>
        {
            try
            {
                var observed = await owner.ExecutionEntriesAsync(ct);
                http.Response.Headers.CacheControl = "no-store";
                return Results.Json(observed);
            }
            catch (WidgetRefusal refusal)
            {
                return Results.Problem(statusCode: refusal.Error.StatusCode, title: refusal.Error.Code, detail: refusal.Error.Message);
            }
            catch (WidgetFixtureException)
            {
                return Results.Problem(statusCode: 503, title: "acme.home.effects.execution_observation_unavailable",
                    detail: "The module execution observations could not be established.");
            }
        }).RequireAuthorization();
        endpoints.MapGet(WidgetEffects.ChecksEndpoint, async (HttpContext http, WidgetEffectOwner owner, CancellationToken ct) =>
        {
            try
            {
                var observed = await owner.ChecksAsync(ct);
                http.Response.Headers.CacheControl = "no-store";
                return Results.Json(observed);
            }
            catch (WidgetRefusal refusal)
            {
                return Results.Problem(statusCode: refusal.Error.StatusCode, title: refusal.Error.Code, detail: refusal.Error.Message);
            }
        }).RequireAuthorization();
        endpoints.MapGet(WidgetContract.Endpoint, async (HttpContext http, WidgetResource resource, CancellationToken ct) =>
        {
            try
            {
                var observed = await resource.ObserveAsync(null, null, false, ct);
                http.Response.Headers.ETag = "\"" + observed.Document.Revision + "\"";
                http.Response.Headers.CacheControl = "no-store";
                return Results.Json(WidgetContract.State(observed));
            }
            catch (WidgetRefusal refusal)
            {
                return Results.Problem(statusCode: refusal.Error.StatusCode, title: refusal.Error.Code, detail: refusal.Error.Message);
            }
        }).RequireAuthorization();
        endpoints.MapGet(WidgetContract.SizeEndpoint, async (HttpContext http, WidgetResource resource, CancellationToken ct) =>
        {
            try
            {
                var observed = await resource.ObserveAsync(null, null, false, ct);
                http.Response.Headers.ETag = "\"" + observed.Document.Revision + "\"";
                http.Response.Headers.CacheControl = "no-store";
                return Results.Json(WidgetContract.SizeState(observed));
            }
            catch (WidgetRefusal refusal)
            {
                return Results.Problem(statusCode: refusal.Error.StatusCode, title: refusal.Error.Code, detail: refusal.Error.Message);
            }
        }).RequireAuthorization();
    }
}

internal sealed record WidgetHost(string Id);
