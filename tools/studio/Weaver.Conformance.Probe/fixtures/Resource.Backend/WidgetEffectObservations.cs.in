using System.Text;
using System.Text.Json;
using Elsa.Weaver.Core.Models;
using Elsa.Studio.Preferences.Core.Models;

namespace Acme.Home.Weaver;

internal sealed record WidgetEffectsSettings(string ObservationFile, string FaultControlFile, string ExecutionObservationFile = "");
internal sealed record WidgetRun(string Actor, string Tenant, string Host, string InvocationId, string ToolCallId,
    string ToolName, string Revision, bool Passed, int CallNumber);

// Module-owned test observations, not the widget resource. Every call is recorded, including duplicate invocation ids.
// The instance holds the in-memory profile across request scopes; a configured private file also survives host restarts.
internal sealed class WidgetRunJournal(WidgetEffectsSettings settings)
{
    private const int MaximumBytes = 2 * 1024 * 1024;
    private readonly object sync = new();
    private readonly List<WidgetRun> memory = [];

    internal WidgetRun Record(StudioPreferenceKey key, WeaverPreparedToolInvocation invocation, string revision, bool passed)
    {
        lock (sync)
        {
            try
            {
                if (settings.ObservationFile.Length == 0)
                {
                    if (memory.Count >= 4096) throw new InvalidDataException("Widget observation limit reached.");
                    var row = Entry(memory, key, invocation, revision, passed);
                    memory.Add(row);
                    return row;
                }
                WidgetFixtureFiles.Check(settings.ObservationFile);
                var options = new FileStreamOptions { Mode = FileMode.OpenOrCreate, Access = FileAccess.ReadWrite, Share = FileShare.Read };
                if (!OperatingSystem.IsWindows()) options.UnixCreateMode = UnixFileMode.UserRead | UnixFileMode.UserWrite;
                using var file = new FileStream(settings.ObservationFile, options);
                var rows = Read(file);
                if (rows.Count >= 4096) throw new InvalidDataException("Widget observation limit reached.");
                var recorded = Entry(rows, key, invocation, revision, passed);
                var bytes = Encoding.UTF8.GetBytes(JsonSerializer.Serialize(recorded) + "\n");
                var needsDelimiter = false;
                if (file.Length > 0)
                {
                    file.Position = file.Length - 1;
                    needsDelimiter = file.ReadByte() is not (10 or 13);
                }
                if (file.Length + bytes.Length + (needsDelimiter ? 1 : 0) > MaximumBytes)
                    throw new InvalidDataException("Widget observation limit reached.");
                file.Position = file.Length;
                if (needsDelimiter) file.WriteByte((byte)'\n');
                file.Write(bytes);
                file.Flush(true);
                return recorded;
            }
            catch (Exception error) when (error is IOException or InvalidDataException or UnauthorizedAccessException or JsonException)
            { throw new WidgetFixtureException("The widget check ran but its observation could not be retained.", error); }
        }
    }

    internal IReadOnlyList<WidgetRun> Read(StudioPreferenceKey key)
    {
        lock (sync)
        {
            try
            {
                if (settings.ObservationFile.Length == 0) return Owned(memory, key);
                WidgetFixtureFiles.Check(settings.ObservationFile);
                if (!File.Exists(settings.ObservationFile)) return [];
                using var file = new FileStream(settings.ObservationFile, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
                return Owned(Read(file), key);
            }
            catch (Exception error) when (error is IOException or InvalidDataException or UnauthorizedAccessException or JsonException)
            { throw new WidgetFixtureException("Widget check observations are unavailable.", error); }
        }
    }

    private static WidgetRun Entry(IReadOnlyCollection<WidgetRun> rows, StudioPreferenceKey key,
        WeaverPreparedToolInvocation invocation, string revision, bool passed) => new(key.SubjectId, key.TenantId, key.StudioHostId,
        invocation.InvocationId, invocation.ToolCallId, invocation.ToolName, revision, passed,
        rows.Count(row => row.Actor == key.SubjectId && row.Tenant == key.TenantId && row.Host == key.StudioHostId) + 1);

    private static WidgetRun[] Owned(IEnumerable<WidgetRun> rows, StudioPreferenceKey key) =>
        rows.Where(row => row.Actor == key.SubjectId && row.Tenant == key.TenantId && row.Host == key.StudioHostId).ToArray();

    private static List<WidgetRun> Read(FileStream file)
    {
        if (file.Length > MaximumBytes) throw new InvalidDataException("Widget observation limit reached.");
        using var reader = new StreamReader(file, Encoding.UTF8, false, 1024, leaveOpen: true);
        var rows = new List<WidgetRun>();
        while (reader.ReadLine() is { } line)
        {
            using var document = JsonDocument.Parse(line);
            var value = document.RootElement;
            if (value.ValueKind != JsonValueKind.Object || value.EnumerateObject().Count() != 9
                || value.EnumerateObject().Select(item => item.Name).Distinct(StringComparer.Ordinal).Count() != 9
                || value.EnumerateObject().Any(item => item.Name is not ("Actor" or "Tenant" or "Host" or "InvocationId"
                    or "ToolCallId" or "ToolName" or "Revision" or "Passed" or "CallNumber"))
                || value.GetProperty("Passed").ValueKind is not (JsonValueKind.True or JsonValueKind.False))
                throw new InvalidDataException("Invalid widget observation.");
            var row = JsonSerializer.Deserialize<WidgetRun>(line) ?? throw new InvalidDataException("Invalid widget observation.");
            if (rows.Count >= 4096 || string.IsNullOrWhiteSpace(row.Actor) || string.IsNullOrWhiteSpace(row.Tenant)
                || string.IsNullOrWhiteSpace(row.Host) || string.IsNullOrWhiteSpace(row.InvocationId)
                || string.IsNullOrWhiteSpace(row.ToolCallId) || string.IsNullOrWhiteSpace(row.Revision)
                || row.ToolName != WidgetEffects.Check || row.CallNumber != rows.Count(item => item.Actor == row.Actor && item.Tenant == row.Tenant && item.Host == row.Host) + 1)
                throw new InvalidDataException("Invalid widget observation.");
            rows.Add(row);
        }
        return rows;
    }
}

internal sealed record WidgetFault(string Channel, string Code, string Message, bool OwnerUnavailable);

// Private operator-selected fault inputs affect only the new declaring sources, never the legacy tools/context.
internal sealed class WidgetFaultControl(WidgetEffectsSettings settings)
{
    internal WidgetFault? Read(string channel)
    {
        if (settings.FaultControlFile.Length == 0) return null;
        try
        {
            WidgetFixtureFiles.Check(settings.FaultControlFile);
            if (!File.Exists(settings.FaultControlFile)) return null;
            if (new FileInfo(settings.FaultControlFile).Length > 4096) throw new InvalidDataException("Invalid widget fault control.");
            using var document = JsonDocument.Parse(File.ReadAllBytes(settings.FaultControlFile));
            var root = document.RootElement;
            if (root.ValueKind != JsonValueKind.Object || root.EnumerateObject().Count() != 4
                || root.EnumerateObject().Any(item => item.Name is not ("channel" or "code" or "message" or "ownerUnavailable"))
                || !root.TryGetProperty("channel", out var kind) || kind.ValueKind != JsonValueKind.String
                || kind.GetString() is not ("authorization" or "preparation" or "execution" or "receipt" or "context")
                || !root.TryGetProperty("code", out var code) || code.ValueKind != JsonValueKind.String || code.GetString()!.Length > 512
                || !root.TryGetProperty("message", out var message) || message.ValueKind != JsonValueKind.String || message.GetString()!.Length > 1024
                || !root.TryGetProperty("ownerUnavailable", out var unavailable) || unavailable.ValueKind is not (JsonValueKind.True or JsonValueKind.False))
                throw new InvalidDataException("Invalid widget fault control.");
            return kind.GetString() == channel ? new(channel, code.GetString()!, message.GetString()!, unavailable.GetBoolean()) : null;
        }
        catch (Exception error) when (error is IOException or InvalidDataException or UnauthorizedAccessException or JsonException)
        { throw new WidgetFixtureException("The widget fault control is unavailable.", error); }
    }
}

internal static class WidgetFixtureFiles
{
    internal static void Check(string path)
    {
        if (!Path.IsPathFullyQualified(path) || Path.GetFullPath(path) != path || Path.GetDirectoryName(path) is not { } parent
            || !Directory.Exists(parent) || new DirectoryInfo(parent).LinkTarget is not null
            || new FileInfo(path).LinkTarget is not null || Directory.Exists(path))
            throw new InvalidDataException("Widget fixture files require an absolute regular path in an existing private directory.");
        if (OperatingSystem.IsWindows()) throw new InvalidDataException("The private widget observation profile requires POSIX file permissions.");
        var other = UnixFileMode.GroupRead | UnixFileMode.GroupWrite | UnixFileMode.GroupExecute
            | UnixFileMode.OtherRead | UnixFileMode.OtherWrite | UnixFileMode.OtherExecute;
        if ((File.GetUnixFileMode(parent) & other) != 0 || File.Exists(path) && (File.GetUnixFileMode(path) & other) != 0)
            throw new InvalidDataException("Widget fixture files require private permissions.");
    }
}
