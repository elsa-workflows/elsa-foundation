<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Acme.Home</AssemblyName>
    <StaticWebAssetBasePath>_content/$(AssemblyName)</StaticWebAssetBasePath>
    <PackageId>Acme.Home.Studio</PackageId>
    <Version>__FIXTURE_VERSION__</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);Client/**</DefaultItemExcludes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Independent personal Home widget Weaver conformance fixture.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="Client/**;NuGet.Config;global.json" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Elsa.Studio.Core" Version="__PRODUCT_VERSION__" />
    <PackageReference Include="CShells.Abstractions" Version="__CSHELLS_VERSION__" />
  </ItemGroup>
</Project>
