<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Acme.Weaver.UpgradeOperator</AssemblyName>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Elsa.Weaver.Persistence.EntityFrameworkCore" Version="[__PRODUCT_VERSION__]" />
    <PackageReference Include="Elsa.Persistence.EntityFramework" Version="[__PRODUCT_VERSION__]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="[__EF_SQLITE_VERSION__]" />
  </ItemGroup>
</Project>
