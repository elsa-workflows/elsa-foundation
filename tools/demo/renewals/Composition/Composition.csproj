<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A portable Nuplane feed needs the package dependency graph even where the SDK
         would prune a package supplied by its shared framework (for example System.Text.Json). -->
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/essentials/Primitives/Hosting/Elsa.Primitives.Hosting.csproj" />
    <!-- OpenIddict's lower dependency bound resolves to 10.0.7 without this demo-feed pin.
         10.0.10 addresses the XML security advisories reported during preparation. -->
    <PackageReference Include="System.Security.Cryptography.Xml" VersionOverride="10.0.10" />
    <PackageReference Include="System.Text.Json" VersionOverride="10.0.10" />
  </ItemGroup>
