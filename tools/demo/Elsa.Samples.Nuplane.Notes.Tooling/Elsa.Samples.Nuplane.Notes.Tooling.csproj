<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Description>
      Design-time startup project for the Notes sample's migrations, in the shape tools/ef/Elsa.EntityFrameworkCore.Tooling
      has for the first-party modules: one design-time factory per provider-derived context, on the shared factory base,
      with the provider engines that project brings. The sample is not added to that shared project, which would put a
      demo module in every "all modules" command and test.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ef\Elsa.EntityFrameworkCore.Tooling\Elsa.EntityFrameworkCore.Tooling.csproj" />
    <ProjectReference Include="..\..\..\samples\Elsa.Samples.Nuplane.Notes\Elsa.Samples.Nuplane.Notes.csproj" />
  </ItemGroup>

</Project>
