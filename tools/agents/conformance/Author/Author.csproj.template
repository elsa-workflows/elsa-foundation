<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Elsa.Agent.Specialists.Design" Version="__VERSION__" />
    <PackageReference Include="Elsa.Agent.Specialists" Version="__VERSION__" />
    <PackageReference Include="Elsa.Activities.Runtime" Version="__VERSION__" />
    <PackageReference Include="Elsa.Serialization.SystemText" Version="__VERSION__" />
    <PackageReference Include="Elsa.Secrets" Version="__VERSION__" />
    <PackageReference Include="Elsa.Workflows.Publishing.Api" Version="__VERSION__" />
    <PackageReference Include="Elsa.Activities.Design.Persistence.EntityFrameworkCore" Version="__VERSION__" />
    <PackageReference Include="Elsa.Workflows.Publishing.Persistence.EntityFrameworkCore" Version="__VERSION__" />
    <PackageReference Include="Elsa.Locking.FileSystem" Version="__VERSION__" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>
</Project>
