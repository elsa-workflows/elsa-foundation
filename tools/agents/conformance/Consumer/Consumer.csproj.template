<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Acme.Specialist.ModelFixture" Version="__VERSION__" />
    <PackageReference Include="Elsa.Agent.Specialists" Version="__VERSION__" />
    <PackageReference Include="Elsa.Activities.Runtime" Version="__VERSION__" />
    <PackageReference Include="Elsa.Serialization.SystemText" Version="__VERSION__" />
    <PackageReference Include="Elsa.Secrets" Version="__VERSION__" />
  </ItemGroup>
</Project>
