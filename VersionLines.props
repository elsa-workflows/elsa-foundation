<Project>

  <!--
    Line A membership, ADR 0067 (amended 2026-09-25).

    Line A is the shared contract baseline every host pins: a package belongs here when its types
    cross the boundary between separately loaded units, for every domain, and the set is closed under
    ProjectReference (a Line B dependency's floor would move with every release and drag the baseline
    with it). Everything not named below is Line B.

    This is the one reviewed list. It is imported once, by Directory.Build.props, which turns
    membership into the per-project $(ElsaVersionLine) property every project sees. The maps generator
    (#2075) will read this same file's XML directly, so there will be exactly one place to change the
    decision.

    A semicolon-delimited property, not an ItemGroup: MSBuild property functions - the
    $(...Contains(...)) below, and the Directory.Build.props comment explains why it has to be a
    function - cannot see item-list (@(...)) expansion, only property ($(...)) expansion, so an
    ItemGroup here could not be turned into a reliable per-project property. The leading and trailing
    ';' make every member match a whole name rather than a substring of a longer one.

    Closure under ProjectReference is enforced by
    tests/essentials/Architecture/LineAClosureGuardTests.cs, not by anything here.
  -->
  <PropertyGroup>
    <ElsaVersionLineAMembers>;Elsa.Primitives;Elsa.Events.Core;Elsa.Tasks.Core;Elsa.Serialization.Core;Elsa.Mediator.Core;Elsa.Attention.Core;Elsa.Expressions.Core;Elsa.Pipelines.Core;Elsa.Locking.Core;Elsa.Caching.Core;</ElsaVersionLineAMembers>
  </PropertyGroup>

</Project>
