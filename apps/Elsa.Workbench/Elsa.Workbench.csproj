<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<!-- Deployable host, not a NuGet library: exclude it from `dotnet pack` over the solution. -->
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- Finite host-recovery fault cuts. Standard builds contain no probe feature or control-file ports. -->
	<ItemGroup Condition="'$(ElsaBpmnRecoveryProbe)' == 'true'">
		<Compile Include="../../e2e-tests/bpmn/RecoveryProbe/BpmnRecoveryProbeFeature.cs" Link="RecoveryProbe/BpmnRecoveryProbeFeature.cs" />
	</ItemGroup>

    <!-- Owned UX qualification only: real native Identity users/grants, no replacement auth/store.
         Standard builds contain neither this bootstrap nor its fixed-profile observation routes. -->
    <PropertyGroup Condition="'$(ElsaDashboardQualification)' == 'true'">
        <DefineConstants>$(DefineConstants);ELSA_DASHBOARD_QUALIFICATION</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="'$(ElsaDashboardQualification)' == 'true'">
        <Compile Include="../../tools/ux-acceptance/DashboardQualificationBootstrap.cs" Link="Qualification/DashboardQualificationBootstrap.cs" />
        <Compile Include="../../tools/ux-acceptance/HistoryQualificationControls.cs" Link="Qualification/HistoryQualificationControls.cs" />
        <Compile Include="../../tools/ux-acceptance/ActivityPlaybackQualificationControls.cs" Link="Qualification/ActivityPlaybackQualificationControls.cs" />
        <Compile Include="../../tools/studio/Weaver.Conformance.Probe/fixtures/BackendConsumer/QualificationPrincipals.cs" Link="Qualification/QualificationPrincipals.cs" />
    </ItemGroup>

