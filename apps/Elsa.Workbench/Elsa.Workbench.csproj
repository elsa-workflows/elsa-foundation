			Elsa:ExtensionBuilder:StoragePath lands under this content root, and the sources it generates there must
			not be compiled into the host.
		-->
		<Compile Remove="extension-builder\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="shells.baseline.json">
