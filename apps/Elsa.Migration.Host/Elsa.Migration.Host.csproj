<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>Temporary Elsa 3 migration host: a local tool that runs the migration CLI's migrated/ folder on Elsa 4. Not a product or deployment host. Removed by the cleanup on #5800.</Description>
    <!-- Run from source only: not packed, not published as an image. -->
    <IsPackable>false</IsPackable>
    <UserSecretsId>ff27eab3-4ac5-4be5-b2b9-ca36791dce84</UserSecretsId>
    <!-- dotnet run uses the project folder as working directory wherever it starts, so the relative sample paths resolve. -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <!--
    Plain CShells hosting (no Nuplane, no admin endpoints) and the host-composed services: the JSON baseline, health,
    the Data Protection key ring, shell startup validation and the OpenIddict token store.
  -->
  <ItemGroup>
    <PackageReference Include="CShells.AspNetCore" />
    <ProjectReference Include="../../essentials/src/Api/AspNetCore/Elsa.Api.AspNetCore.csproj" />
    <ProjectReference Include="../../essentials/src/Cluster/Readability/Elsa.Cluster.Readability.csproj" />
    <ProjectReference Include="../../essentials/src/Foundation/DataProtection/EntityFrameworkCore/Elsa.Foundation.DataProtection.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../essentials/src/Foundation/Hosting/Elsa.Foundation.Hosting.csproj" />
    <ProjectReference Include="../../essentials/src/Foundation/Identity/OpenIddict/EntityFrameworkCore/Elsa.Foundation.Identity.OpenIddict.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../essentials/src/Serialization/Core/Elsa.Serialization.Core.csproj" />
  </ItemGroup>

