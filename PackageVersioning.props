<Project>

  <!--
    Package versions, and what every package carries about where it came from: spec 150 FR-007, FR-008 and FR-018.
    Directory.Build.props imports this after it derives and checks $(ElsaVersionLine), so every project sees it.
    PackageRanges.targets, imported right after this file, holds the dependency-range bounding and the nuspec
    range verification (spec 150 FR-007); this file holds version selection and the checks on it.

    It versions the projects under src/, where every package the pipeline publishes lives (FR-005), and leaves every
    other project - a test fixture pinning its assembly version, a sample package - exactly as its own properties and
    the SDK's defaults have it. A version comes from one of two places.

      - Computed. tools/versioning/Elsa.Versioning.Calculator writes an MSBuild file for one commit, one revision of
        the last-published record and one branch (its pack-properties output; see tools/versioning/README.md), and
        dotnet build and dotnet pack both import it through MSBuild's CustomBeforeDirectoryBuildProps hook:

          -p:CustomBeforeDirectoryBuildProps=<the file's full path>

        It sets ElsaVersionComputationCommit and, for each packable project, ElsaComputedPackageVersion (the final
        version, prerelease label included) and ElsaInputFingerprint. Version and PackageVersion both take the computed
        version, so the assemblies a package carries claim the package's version. packages.yml packs this way, and
        only this way. The file comes in through that hook rather than an Import here because the calculator reads this
        file as a build input of every package and refuses an import whose path it cannot resolve statically.
      - Dev. Without that file PackageVersion is <the project's line's major.minor>.0-dev, from ElsaVersion or
        ElsaContractsVersion in VersionLines.props, which sorts below every version the calculator computes on that
        line. Version is left to the SDK's default, so a dev build's assemblies, and every activity version and
        assembly-qualified name derived from them, stay what they were before package versions were computed.

    Nothing else may set PackageVersion, nor, with computed input, Version, and ElsaVerifyPackageVersion fails the
    build or the pack when something did. One exception stands: without computed input, a Version that arrived from
    outside every build file - a global /p:Version - becomes the package version, so a local pack can still name one.
    packages.yml passes none (spec 150 FR-005), and tests/essentials/Versioning/Publisher/Tests/PackagesWorkflowTests.cs
    holds it to that. Every other pack-time effect this file and PackageRanges.targets add - bounded ranges, the nuspec
    range check, the input fingerprint - is gated on computed input alone (ElsaVersionComputationCommit set), so a pack
    with only a global /p:Version produces the ranges and package contents packing always has.

    The calculator also decides, from this file, which of a project's Markdown files count as package inputs
    (FR-002a): an item whose Include or Update it cannot resolve statically is taken to name every file. So every
    item included below spells a path it can resolve - $(MSBuildProjectDirectory)/ and literals only, no other
    $(...) and no @(...) - and the targets otherwise shape item lists through task outputs and metadata updates.
    tests/essentials/Versioning/Calculator/Tests/RootBuildFileTests.cs holds that line.

    tests/essentials/Architecture/PackageVersionBuildCheckTests.cs proves the version choice and its checks, and
    PackageVersioningPackTests.cs beside it proves the packs: bounded ranges, the fingerprint and the source commit.
  -->
  <PropertyGroup>
    <_ElsaSourceDirectory>$([MSBuild]::EnsureTrailingSlash('$(MSBuildThisFileDirectory)src'))</_ElsaSourceDirectory>
    <_ElsaLineVersion>$(ElsaVersion)</_ElsaLineVersion>
    <_ElsaLineVersion Condition="'$(ElsaVersionLine)' == 'A'">$(ElsaContractsVersion)</_ElsaLineVersion>
  </PropertyGroup>

  <!-- _ElsaPackageVersion is set exactly for the projects this file versions; every target below keys on it. -->
  <PropertyGroup Condition="$(MSBuildProjectFullPath.StartsWith('$(_ElsaSourceDirectory)')) or '$(ElsaComputedPackageVersion)' != ''">
    <_ElsaPackageVersion>$(_ElsaLineVersion).0-dev</_ElsaPackageVersion>
    <_ElsaPackageVersion Condition="'$(Version)' != ''">$(Version)</_ElsaPackageVersion>
    <_ElsaPackageVersion Condition="'$(ElsaComputedPackageVersion)' != ''">$(ElsaComputedPackageVersion)</_ElsaPackageVersion>
    <Version Condition="'$(ElsaComputedPackageVersion)' != ''">$(ElsaComputedPackageVersion)</Version>
    <PackageVersion>$(_ElsaPackageVersion)</PackageVersion>
    <RepositoryCommit Condition="'$(ElsaVersionComputationCommit)' != ''">$(ElsaVersionComputationCommit)</RepositoryCommit>
  </PropertyGroup>

  <!--
    The version checks every build and every pack runs, including the _GetProjectVersion a pack asks of each project
    it references: that answer is where the dependency's range starts.
  -->
  <Target Name="ElsaVerifyPackageVersion" BeforeTargets="BeforeBuild;GenerateNuspec;_GetProjectVersion">

    <Error Code="ELSAPV001"
           Condition="'$(ElsaVersionComputationCommit)' == '' and ('$(ElsaComputedPackageVersion)' != '' or '$(ElsaInputFingerprint)' != '')"
           Text="$(MSBuildProjectName) has a computed version or input fingerprint but no ElsaVersionComputationCommit, so nothing says which commit they were computed for. Import the calculator's pack-properties file whole, through -p:CustomBeforeDirectoryBuildProps, and set none of its properties anywhere else." />

    <Error Code="ELSAPV002"
           Condition="'$(ElsaComputedPackageVersion)' != '' and !$(ElsaComputedPackageVersion.StartsWith('$(_ElsaLineVersion).'))"
           Text="$(MSBuildProjectName) is on line $(ElsaVersionLine), whose major.minor VersionLines.props sets to $(_ElsaLineVersion), but its computed version is $(ElsaComputedPackageVersion). The computation was made for a commit with different version lines; compute again for the commit being built." />

    <Error Code="ELSAPV003"
           Condition="'$(ElsaComputedPackageVersion)' != '' and '$(Version)' != '$(ElsaComputedPackageVersion)'"
           Text="$(MSBuildProjectName) evaluates Version as '$(Version)', but its computed version is '$(ElsaComputedPackageVersion)'. With computed versions, Version comes from PackageVersioning.props alone (spec 150 FR-005): not from this project file, not from a nested Directory.Build.props/.targets, and not from /p:Version." />

    <Error Code="ELSAPV004"
           Condition="'$(_ElsaPackageVersion)' != '' and '$(PackageVersion)' != '$(_ElsaPackageVersion)'"
           Text="$(MSBuildProjectName) evaluates PackageVersion as '$(PackageVersion)', but its package version is '$(_ElsaPackageVersion)'. PackageVersion comes from PackageVersioning.props alone (spec 150 FR-005): not from this project file, not from a nested Directory.Build.props/.targets, and not from /p:PackageVersion." />

  </Target>

  <!--
    With computed versions, every package a pack writes or points a dependency at must have one: a packable project
    the computation leaves out would otherwise fall back to the dev version, and a package referencing it would
    publish a range starting at that dev version.
  -->
  <Target Name="ElsaVerifyComputedPackage" BeforeTargets="GenerateNuspec;_GetProjectVersion"
          Condition="'$(ElsaVersionComputationCommit)' != '' and '$(IsPackable)' == 'true'">

    <Error Code="ELSAPV005"
           Condition="'$(ElsaComputedPackageVersion)' == '' or '$(ElsaInputFingerprint)' == ''"
           Text="$(MSBuildProjectName) is packable, but the computed versions for $(ElsaVersionComputationCommit) give it no version and input fingerprint. The dependency map committed at that commit does not list it as packable under this project name; regenerate the map (dotnet run --project tools/maps/Elsa.Maps.Generator -- all) and compute again." />

  </Target>

  <!--
    FR-018: the source commit is the nuspec's repository commit, set above from the computation. It must be the commit
    this working tree holds, which SourceLink reports as SourceRevisionId; otherwise the versions and fingerprints
    describe a different commit's inputs than the ones being packed. GenerateNuspec initializes SourceRevisionId among
    its dependencies, so this runs after that. A tree with uncommitted changes is not detected here: the calculator
    reads git objects only, and packing is expected to run on a clean checkout.
  -->
  <Target Name="ElsaVerifyRepositoryCommit" BeforeTargets="GenerateNuspec"
          Condition="'$(ElsaVersionComputationCommit)' != '' and '$(IsPackable)' == 'true'">

    <Error Code="ELSAPV006"
           Condition="'$(SourceRevisionId)' != '$(ElsaVersionComputationCommit)'"
           Text="$(MSBuildProjectName): the computed versions are for commit $(ElsaVersionComputationCommit), but this working tree is at '$(SourceRevisionId)'. Compute them for the commit being packed." />

  </Target>

  <!--
    FR-018: the input fingerprint, embedded at the package root as elsa-input-fingerprint.json. NuGet has no custom
    nuspec metadata - pack silently drops an element it does not know - so the fingerprint travels as a file in the
    package. It is written only with computed input: a dev package carries none.
  -->
  <Target Name="ElsaPackInputFingerprint" BeforeTargets="_GetPackageFiles" Condition="'$(ElsaInputFingerprint)' != ''">

    <WriteLinesToFile File="$(MSBuildProjectDirectory)/obj/elsa-input-fingerprint.json"
                      Lines="{&quot;schema_version&quot;:1,&quot;fingerprint&quot;:&quot;$(ElsaInputFingerprint)&quot;}"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <None Include="$(MSBuildProjectDirectory)/obj/elsa-input-fingerprint.json" Pack="true" PackagePath="/" />
    </ItemGroup>

  </Target>

  <!--
    A no-build pack packs what an earlier build produced, and that build already stamped its version into the
    assemblies and into elsa-package.json. So the build records the version it built, and a no-build pack refuses to
    stamp a different one on the package, which would otherwise ship claiming two versions at once.
  -->
  <Target Name="ElsaRecordBuiltPackageVersion" AfterTargets="Build" Condition="'$(_ElsaPackageVersion)' != '' and '$(IsPackable)' == 'true'">

    <WriteLinesToFile File="$(BaseIntermediateOutputPath)$(Configuration)/elsa-built-package-version.txt"
                      Lines="$(PackageVersion)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

  </Target>

  <Target Name="ElsaVerifyBuiltPackageVersion" BeforeTargets="GenerateNuspec"
          Condition="'$(_ElsaPackageVersion)' != '' and '$(IsPackable)' == 'true' and '$(NoBuild)' == 'true'">

    <ReadLinesFromFile File="$(BaseIntermediateOutputPath)$(Configuration)/elsa-built-package-version.txt"
                       Condition="Exists('$(BaseIntermediateOutputPath)$(Configuration)/elsa-built-package-version.txt')">
      <Output TaskParameter="Lines" PropertyName="_ElsaBuiltPackageVersion" />
    </ReadLinesFromFile>

    <Error Code="ELSAPV007"
           Condition="'$(_ElsaBuiltPackageVersion)' != '$(PackageVersion)'"
           Text="$(MSBuildProjectName) is being packed as $(PackageVersion) without building, but its $(Configuration) build was made as '$(_ElsaBuiltPackageVersion)'. Build and pack with the same version input: the same -p:CustomBeforeDirectoryBuildProps file, or none for both." />

  </Target>

</Project>
