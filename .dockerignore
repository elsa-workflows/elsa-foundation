# .dockerignore (repo root) — applies to Docker builds that use the repository
# root as context (e.g. server/apps/Elsa.Workbench.Host/Dockerfile and the Studio app Dockerfiles).
#
# Goal: send only what `dotnet restore`/`publish` needs. Keep repo-root build
# config (*.props, *.targets, NuGet.config, *.slnx) and the product source trees with
# its committed wwwroot assets; drop build output, tests, docs and local dev state.

# --- Build output -----------------------------------------------------------
**/bin/
**/obj/
**/out/
**/publish/

# --- VCS / tooling / IDE ----------------------------------------------------
.git/
.gitignore
.gitattributes
.github/
.vs/
.vscode/
.idea/
**/*.user
**/*.suo
**/*.DotSettings*

# --- Repo areas not needed to build the server host -------------------------
server/essentials/tests/
studio/tests/
**/node_modules/
# Optional-module tests (#1815). extensions/<Name>/src is build input and stays; its sibling
# tests/ is not, and unlike the top-level tests/ tree it is not covered by the rule above.
extensions/*/tests/
docs/
samples/
specs/
tools/
!tools/architecture/check-kernel-model-references.targets
.specify/
.agents/
.agent-prefs/
.claude/

# --- Local dev / runtime state that must never leak into the image ----------
# SQLite fallback stores and Groundwork runtime files
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal
# Nuplane reconciliation state and directory-feed contents
**/.nuplane/
server/apps/Elsa.Workbench.Host/packages/
server/apps/Elsa.Essentials.Host/packages/
# Extension Builder runtime workspace (lowercase; source lives in extensions/ExtensionBuilder/)
server/apps/Elsa.Workbench.Host/extension-builder/
# GitHubCopilotAgent working directory (config.json is regenerated / supplied via mount)
server/apps/Elsa.Workbench.Host/.elsa/
studio/src/apps/Elsa.Studio.Workbench.Host/packages/
studio/src/apps/Elsa.Studio.Essentials.Host/packages/
studio/src/apps/Elsa.Studio.Foundation.Host/packages/
studio/.git/
studio/.github/
studio/.specify/
studio/.claude/
studio/specs/
studio/docs/
studio/artifacts/

# --- Docker / compose assets ------------------------------------------------
docker/
**/Dockerfile
**/.dockerignore
**/docker-compose*.yml

# --- Misc -------------------------------------------------------------------
**/.DS_Store
README.md
LICENSE
