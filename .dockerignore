# .dockerignore (repo root) — applies to Docker builds that use the repository
# root as context (e.g. src/apps/Elsa.Workbench/Dockerfile).
#
# Goal: send only what `dotnet restore`/`publish` needs. Keep repo-root build
# config (Directory.Packages.props, NuGet.config, *.slnx) and the src/ tree with
# its committed wwwroot assets; drop build output, tests, docs and local dev state.

# --- Build output -----------------------------------------------------------
**/bin/
**/obj/
**/out/
**/publish/

# --- VCS / tooling / IDE ----------------------------------------------------
.git/
.gitignore
.gitattributes
.github/
.vs/
.vscode/
.idea/
**/*.user
**/*.suo
**/*.DotSettings*

# --- Repo areas not needed to build the server host -------------------------
tests/
# Optional-module tests (#1815). src/extensions/<Name>/src is build input and stays; its sibling
# tests/ is not, and unlike the top-level tests/ tree it is not covered by the rule above.
src/extensions/*/tests/
docs/
samples/
specs/
tools/
.specify/
.agents/
.agent-prefs/
.claude/

# --- Local dev / runtime state that must never leak into the image ----------
# SQLite fallback stores and Groundwork runtime files
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal
# Nuplane reconciliation state and directory-feed contents
**/.nuplane/
src/apps/Elsa.Workbench/packages/
# GitHubCopilotAgent working directory (config.json is regenerated / supplied via mount)
src/apps/Elsa.Workbench/.elsa/

# --- Docker / compose assets ------------------------------------------------
docker/
**/Dockerfile
**/.dockerignore
**/docker-compose*.yml

# --- Misc -------------------------------------------------------------------
**/.DS_Store
README.md
LICENSE
