<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CShells.Nuplane" Version="$(CShellsNuplanePackageVersion)" />
    <PackageReference Include="Nuplane" Version="$(NuplanePackageVersion)" />
    <PackageReference Include="Nuplane.Loading" Version="$(NuplanePackageVersion)" />
    <PackageReference Include="Nuplane.Sources.Directory" Version="$(NuplanePackageVersion)" />
    <PackageReference Include="CShells" Version="$(CShellsNuplanePackageVersion)" />
    <PackageReference Include="CShells.Abstractions" Version="$(CShellsNuplanePackageVersion)" />
  </ItemGroup>

  <Target Name="RequireStablePackageVersions" BeforeTargets="Restore;CollectPackageReferences">
    <Error Condition="'$(CShellsNuplanePackageVersion)' == ''"
           Text="Pass the exact audited CShells family version with -p:CShellsNuplanePackageVersion=..." />
    <Error Condition="'$(NuplanePackageVersion)' == ''"
           Text="Pass the exact audited Nuplane family version with -p:NuplanePackageVersion=..." />
  </Target>
</Project>
