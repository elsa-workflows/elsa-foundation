# Generated Vite output. Both depths are listed so the pattern keeps matching across the
# src/essentials|apps|extensions/ split (#515) — a module whose wwwroot stops being ignored
# starts committing its build output, silently. scripts/check-module-layout.mjs asserts this.
src/*/wwwroot/
src/*/*/wwwroot/
