{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "CShells.AspNetCore.Middleware.ShellMiddleware": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Studio": {
    "HostId": "studio-foundation",
    "BackendBaseUrl": "https://localhost:7250",
    "Auth": {
      "Enabled": true
    },
    "Hosting": {
      "Nuplane": {
        "EnrollPackageStore": true
      }
    }
  },
  "Themes": {
    "ThemesDirectory": null,
    "ThemesMode": "AddToBuiltIns",
    "DefaultThemeId": null
  }
}
