{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "CShells.AspNetCore.Middleware.ShellMiddleware": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Nuplane": {
    "Setup": {
      "AutomaticReconciliation": true,
      "PollInterval": "01:00:00",
      "Feeds": [
        {
          "Name": "studio-local-packages",
          "DirectoryPath": "packages",
          "IncludePatterns": [
            "*"
          ],
          "Directory": {
            "Watch": true,
            "DebounceWindow": "00:00:05"
          }
        }
      ]
    },
    "Loading": {
      "Enabled": true,
      "SharedAssemblies": [
        {
          "Name": "CShells.Abstractions",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "CShells.AspNetCore.Abstractions",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Studio.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        }
      ]
    }
  },
  "Studio": {
    "HostId": "studio-primary",
    "BackendBaseUrl": "https://localhost:7243",
    "Dashboard": {
      "DefaultRefreshIntervalMinutes": 5,
      "WidgetTimeoutSeconds": 10,
      "PinnedWidgetIds": []
    },
    "Attention": {
      "HostApiEnabled": false
    },
    "Workflows": {
      "AutosaveEnabledByDefault": true
    },
    "ActivityDefinitions": {
      "LocalRecovery": {
        "Enabled": false,
        "TtlMinutes": 1440
      }
    },
    "Auth": {
      "Enabled": true
    }
  },
  "Themes": {
    "ThemesDirectory": null,
    "ThemesMode": "AddToBuiltIns",
    "DefaultThemeId": null
  }
}
