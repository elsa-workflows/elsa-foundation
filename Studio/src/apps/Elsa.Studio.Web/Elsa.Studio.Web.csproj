<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Deployable host, not a NuGet library: exclude it from `dotnet pack` over the solution. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CShells.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Elsa.Studio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="packages" />
    <Folder Include="wwwroot" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hosting owns this generated subtree now, including in existing checkouts. -->
    <Content Remove="wwwroot/studio/**/*" />
    <Content Update="wwwroot/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="RemoveObsoleteStudioBrowserOutput" BeforeTargets="PrepareForBuild">
    <RemoveDir Directories="$(MSBuildProjectDirectory)/wwwroot/studio" />
  </Target>

  <ItemGroup>
    <Content Update="nuplane-management.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="shells.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\essentials\Elsa.Studio.Api\Elsa.Studio.Api.csproj" />
    <ProjectReference Include="../../essentials/Elsa.Studio.Hosting/Elsa.Studio.Hosting.csproj" />
    <ProjectReference Include="../../essentials/Elsa.Studio.Backends/Elsa.Studio.Backends.csproj" />
    <ProjectReference Include="../../essentials/Elsa.Studio.Hosting.Themes/Elsa.Studio.Hosting.Themes.csproj" />
    <ProjectReference Include="../../essentials/Elsa.Studio.Hosting.Nuplane/Elsa.Studio.Hosting.Nuplane.csproj" />
    <ProjectReference Include="..\..\..\..\Extensions\ConsoleStream\studio\Elsa.Studio.ConsoleStream\Elsa.Studio.ConsoleStream.csproj"/>
    <ProjectReference Include="..\..\essentials\Elsa.Studio.Core\Elsa.Studio.Core.csproj" />
    <ProjectReference Include="..\..\..\..\Extensions\Diagnostics.OpenTelemetry\studio\Elsa.Studio.Diagnostics.OpenTelemetry\Elsa.Studio.Diagnostics.OpenTelemetry.csproj"/>
    <ProjectReference Include="..\..\..\..\Extensions\Diagnostics.StructuredLogs\studio\Elsa.Studio.Diagnostics.StructuredLogs\Elsa.Studio.Diagnostics.StructuredLogs.csproj"/>
    <ProjectReference Include="..\..\..\..\Extensions\Attention\studio\Elsa.Studio.Attention\Elsa.Studio.Attention.csproj"/>
    <ProjectReference Include="..\..\..\..\Extensions\ExpressionEditors.JavaScript\studio\Elsa.Studio.ExpressionEditors.JavaScript\Elsa.Studio.ExpressionEditors.JavaScript.csproj"/>
    <ProjectReference Include="..\..\..\..\Extensions\ExpressionEditors.Liquid\studio\Elsa.Studio.ExpressionEditors.Liquid\Elsa.Studio.ExpressionEditors.Liquid.csproj"/>
    <ProjectReference Include="..\..\..\..\Extensions\ExtensionBuilder\studio\Elsa.Studio.ExtensionBuilder\Elsa.Studio.ExtensionBuilder.csproj"/>
    <ProjectReference Include="..\..\..\..\Extensions\FeatureManagement\studio\Elsa.Studio.FeatureManagement\Elsa.Studio.FeatureManagement.csproj"/>
    <ProjectReference Include="..\..\..\..\Extensions\Secrets\studio\Elsa.Studio.Secrets\Elsa.Studio.Secrets.csproj"/>
    <ProjectReference Include="..\..\..\..\Extensions\Connections\studio\Elsa.Studio.Connections\Elsa.Studio.Connections.csproj"/>
    <ProjectReference Include="..\..\..\..\Extensions\Etl\studio\Elsa.Studio.Etl\Elsa.Studio.Etl.csproj"/>
    <ProjectReference Include="..\..\..\..\Extensions\Weaver\studio\Elsa.Studio.Weaver.Core\Elsa.Studio.Weaver.Core.csproj"/>
    <ProjectReference Include="..\..\..\..\Extensions\Weaver\studio\Elsa.Studio.Weaver.Workflows\Elsa.Studio.Weaver.Workflows.csproj"/>
    <ProjectReference Include="..\..\essentials\Elsa.Studio.Dashboard\Elsa.Studio.Dashboard.csproj" />
    <ProjectReference Include="..\..\essentials\Elsa.Studio.Workflows\Elsa.Studio.Workflows.csproj" />
    <ProjectReference Include="..\..\..\..\Extensions\Workflows.Dashboard\studio\Elsa.Studio.Workflows.Dashboard\Elsa.Studio.Workflows.Dashboard.csproj"/>
  </ItemGroup>

</Project>
