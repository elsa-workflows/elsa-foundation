<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ElsaTrackPublicApi>true</ElsaTrackPublicApi>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Studio server startup, module discovery, runtime configuration and application composition.</Description>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Elsa.Studio.Hosting.Nuplane" />
    <None Update="README.md" Pack="true" PackagePath="" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CShells.AspNetCore" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <ProjectReference Include="../Elsa.Studio.Api/Elsa.Studio.Api.csproj" />
    <ProjectReference Include="../Elsa.Studio.Core/Elsa.Studio.Core.csproj" />
  </ItemGroup>
  <Target Name="VerifyStudioBrowserPayload" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <RequiredStudioBrowserAsset Include="wwwroot/studio/index.html;wwwroot/studio/assets/index.js;wwwroot/studio/assets/index.css;wwwroot/studio/sdk/index.js;wwwroot/studio/vendor/react.js;wwwroot/studio/vendor/react-dom.js;wwwroot/studio/vendor/react-dom-client.js;wwwroot/studio/vendor/react-query.js;wwwroot/studio/vendor/lucide-react.js;wwwroot/studio/vendor/studio-ui.js" />
    </ItemGroup>
    <Error Condition="!Exists('%(RequiredStudioBrowserAsset.FullPath)')"
           Text="Missing prebuilt Studio browser asset: %(RequiredStudioBrowserAsset.Identity). Build the Studio frontend before packing Elsa.Studio.Hosting." />
  </Target>
</Project>
