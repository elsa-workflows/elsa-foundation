<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ElsaTrackPublicApi>true</ElsaTrackPublicApi>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Optional Studio theme store, directory sources, material assets and shell features.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Update="README.md" Pack="true" PackagePath="" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <ProjectReference Include="../Elsa.Studio.Hosting/Elsa.Studio.Hosting.csproj" />
    <ProjectReference Include="../Elsa.Studio.Api/Elsa.Studio.Api.csproj" />
    <ProjectReference Include="../Elsa.Studio.Core/Elsa.Studio.Core.csproj" />
  </ItemGroup>
</Project>
