<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ElsaTrackPublicApi>true</ElsaTrackPublicApi>
    <StaticWebAssetBasePath>_content/Elsa.Studio.Backends</StaticWebAssetBasePath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Optional Studio backend profile management, selection and connection UI.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CShells.AspNetCore.Abstractions" />
    <PackageReference Include="Elsa.Specifications.PackageManifest.Generator" PrivateAssets="all" />
    <ProjectReference Include="../Elsa.Studio.Core/Elsa.Studio.Core.csproj" />
    <ProjectReference Include="../Elsa.Studio.Api/Elsa.Studio.Api.csproj" />
    <ProjectReference Include="../../../../Essentials/src/Studio/Preferences/Core/Elsa.Studio.Preferences.Core.csproj" />
    <None Update="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
