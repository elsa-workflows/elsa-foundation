<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Until Elsa 4's first release, RS0016/RS0017 stay warnings and must not fail the build.
         Re-enable them (drop WarningsNotAsErrors) with a fresh PublicAPI.Shipped.txt baseline at that
         release. Studio does not import the root Directory.Build.props, so this is set here too. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);RS0016;RS0017</WarningsNotAsErrors>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Shared NuGet package metadata for the publishable Elsa.Studio.* module libraries.
         No Version here — CI injects /p:Version. -->
    <Authors>Elsa Workflows</Authors>
    <Company>Elsa Workflows</Company>
    <Product>Elsa Studio</Product>
    <Copyright>Copyright © Elsa Workflows</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/elsa-workflows/elsa-foundation</PackageProjectUrl>
    <RepositoryUrl>https://github.com/elsa-workflows/elsa-foundation.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>elsa;studio;workflow;workflows;designer;ui</PackageTags>
    <!-- Client/ and the Hosting SDK/UI facades hold frontend (Vite/pnpm) source. They build
         separately into wwwroot and are never .NET compile/content inputs. Excluding them
         from the default item globs keeps dev-only files (package.json, tsconfig.json,
         etc.) out of publish output, which otherwise collide across projects with
         NETSDK1152 during `dotnet publish`. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Client\**;StudioSdk\**;StudioUi\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
