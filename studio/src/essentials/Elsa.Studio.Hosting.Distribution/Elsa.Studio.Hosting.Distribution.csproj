<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ElsaTrackPublicApi>true</ElsaTrackPublicApi>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>The Studio host composition every shipped Studio app shares: hosting, backend profiles, Nuplane add-ons and the Theme Store.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Update="README.md" Pack="true" PackagePath="" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <ProjectReference Include="../Elsa.Studio.Hosting/Elsa.Studio.Hosting.csproj" />
    <ProjectReference Include="../Elsa.Studio.Hosting.Nuplane/Elsa.Studio.Hosting.Nuplane.csproj" />
    <ProjectReference Include="../Elsa.Studio.Hosting.Themes/Elsa.Studio.Hosting.Themes.csproj" />
    <ProjectReference Include="../Elsa.Studio.Backends/Elsa.Studio.Backends.csproj" />
  </ItemGroup>
</Project>
