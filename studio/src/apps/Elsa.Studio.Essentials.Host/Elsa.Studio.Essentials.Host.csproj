<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Deployable host, not a NuGet library: exclude it from `dotnet pack` over the solution. -->
    <IsPackable>false</IsPackable>
    <!-- The project is named for its folder; the code uses the Elsa.Studio.Essentials namespace. -->
    <RootNamespace>Elsa.Studio.Essentials</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="packages" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="nuplane-management.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="shells.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Studio hosting, backend profiles, Nuplane add-ons and the Theme Store, as every shipped Studio app composes them. -->
    <ProjectReference Include="../../essentials/Elsa.Studio.Hosting.Distribution/Elsa.Studio.Hosting.Distribution.csproj" />
    <!-- The module admin UI that installs add-ons from the feed. -->
    <ProjectReference Include="../../../../extensions/FeatureManagement/studio/Elsa.Studio.FeatureManagement/Elsa.Studio.FeatureManagement.csproj" />
  </ItemGroup>

  <!--
    The Studio side of the Essentials server's curated set: a module joins exactly when server/apps/Elsa.Essentials.Host advertises the
    backend capabilities it requires. StudioEssentialsDriftGuardTests (server/essentials/tests/Architecture/Tests) keeps this list in
    step with the server. Every other Studio module is a Nuplane add-on installed from the feed.
  -->
  <ItemGroup>
    <ProjectReference Include="../../essentials/Elsa.Studio.Workflows/Elsa.Studio.Workflows.csproj" />
    <ProjectReference Include="../../../../extensions/Workflows.Dashboard/studio/Elsa.Studio.Workflows.Dashboard/Elsa.Studio.Workflows.Dashboard.csproj" />
    <ProjectReference Include="../../../../extensions/Attention/studio/Elsa.Studio.Attention/Elsa.Studio.Attention.csproj" />
    <ProjectReference Include="../../../../extensions/UserTasks/studio/Elsa.Studio.UserTasks/Elsa.Studio.UserTasks.csproj" />
    <ProjectReference Include="../../../../extensions/Secrets/studio/Elsa.Studio.Secrets/Elsa.Studio.Secrets.csproj" />
    <ProjectReference Include="../../../../extensions/ExpressionEditors.JavaScript/studio/Elsa.Studio.ExpressionEditors.JavaScript/Elsa.Studio.ExpressionEditors.JavaScript.csproj" />
    <ProjectReference Include="../../../../extensions/ExpressionEditors.Liquid/studio/Elsa.Studio.ExpressionEditors.Liquid/Elsa.Studio.ExpressionEditors.Liquid.csproj" />
  </ItemGroup>

</Project>
