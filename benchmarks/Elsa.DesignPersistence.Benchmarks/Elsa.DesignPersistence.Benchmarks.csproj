<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Temporary same-provider design-persistence performance harness for Spec 093 US4 (T067/T068).
    It is a console executable, NOT a test project: it is discovered by neither the container-free
    (ci.yml) nor the Testcontainers (integration.yml) test filters, both of which glob only
    'tests/**'. It is registered in Elsa.Server.slnx so it stays compiling, mirroring the existing
    runtime benchmarks. It references the temporary EF design oracle projects, which are deleted by
    T071-T076 after the T069 evidence gate; this project is removed in the same lane.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Common design contracts, events, locking, validation, reconciliation. -->
    <ProjectReference Include="../../src/Elsa/Activities/Design/Reconciliation/Elsa.Activities.Design.Reconciliation.csproj" />
    <ProjectReference Include="../../src/Elsa/Events/Elsa.Events.csproj" />
    <ProjectReference Include="../../src/Elsa/Events/Core/Elsa.Events.Core.csproj" />
    <ProjectReference Include="../../src/Elsa/Locking/Core/Elsa.Locking.Core.csproj" />
    <ProjectReference Include="../../src/Elsa/Primitives/Primitives/Elsa.Primitives.csproj" />
    <ProjectReference Include="../../src/Elsa/Primitives/Hosting/Elsa.Primitives.Hosting.csproj" />
    <ProjectReference Include="../../src/Elsa/Serialization/Core/Elsa.Serialization.Core.csproj" />
    <ProjectReference Include="../../src/Elsa/Serialization/SystemText/Elsa.Serialization.SystemText.csproj" />
    <ProjectReference Include="../../src/Elsa/Workflows/Design/Validations/Elsa.Workflows.Design.Validations.csproj" />

    <!-- Temporary EF oracle (SQLite) design persistence. -->
    <ProjectReference Include="../../src/Elsa/Persistence/EFCore/Elsa.Persistence.EFCore.csproj" />
    <ProjectReference Include="../../src/Elsa/Persistence/EFCore/Sqlite/Elsa.Persistence.EFCore.Sqlite.csproj" />
    <ProjectReference Include="../../src/Elsa/Activities/Design/Persistence/EFCore/Elsa.Activities.Design.Persistence.EFCore.csproj" />
    <ProjectReference Include="../../src/Elsa/Activities/Design/Persistence/EFCore/Sqlite/Elsa.Activities.Design.Persistence.EFCore.Sqlite.csproj" />
    <ProjectReference Include="../../src/Elsa/Workflows/Design/Persistence/EFCore/Elsa.Workflows.Design.Persistence.EFCore.csproj" />
    <ProjectReference Include="../../src/Elsa/Workflows/Design/Persistence/EFCore/Sqlite/Elsa.Workflows.Design.Persistence.EFCore.Sqlite.csproj" />

    <!-- Groundwork (SQLite) unified design persistence = the physical-entity production form. -->
    <ProjectReference Include="../../src/Elsa/Activities/Design/Persistence/Groundwork/Elsa.Activities.Design.Persistence.Groundwork.csproj" />
    <ProjectReference Include="../../src/Elsa/Persistence/Groundwork/ReferenceComposition/Elsa.Persistence.Groundwork.ReferenceComposition.csproj" />
    <ProjectReference Include="../../src/Elsa/Persistence/Groundwork/Sqlite/Unified/Elsa.Persistence.Groundwork.Sqlite.Unified.csproj" />
    <ProjectReference Include="../../src/Elsa/Workflows/Design/Persistence/Groundwork/Elsa.Workflows.Design.Persistence.Groundwork.csproj" />
  </ItemGroup>

</Project>
