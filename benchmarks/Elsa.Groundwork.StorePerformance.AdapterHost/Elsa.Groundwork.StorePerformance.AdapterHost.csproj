<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The adapter child host the #646 matrix runner spawns, rebuilt on Groundwork v2 for #1425.

    The harness project deliberately ships no adapter ("a missing adapter is a blocked run, never a
    simulated result"), so `matrix` refuses to start without a child-command. This is that command.

    It lives under benchmarks/ rather than tests/ because it is a measurement instrument, not a test
    project, and because ArchitectureGuardTests.ProjectFiles() enumerates only src/ and tests/.

    The v1 host referenced the v1 provider-driver library under tests/; that driver went with the v1
    substrate in #1420. The v2 replacement is Elsa.Persistence.Groundwork.V2.Providers, which is the
    project that binds the four Groundwork provider packages to the v2 composition — so the benchmark
    runs against the same provider drivers that produce the four-provider conformance evidence.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <AssemblyName>Elsa.Groundwork.StorePerformance.AdapterHost</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Elsa.Groundwork.StorePerformance.Benchmarks/Elsa.Groundwork.StorePerformance.Benchmarks.csproj" />
    <ProjectReference Include="../../src/Elsa/Foundation/Identity/AspNetCoreIdentity/Groundwork/Elsa.Foundation.Identity.AspNetCoreIdentity.Groundwork.csproj" />
    <ProjectReference Include="../../src/Elsa/Persistence/Groundwork/V2/Providers/Elsa.Persistence.Groundwork.V2.Providers.csproj" />
    <ProjectReference Include="../../src/Elsa/Workflows/Runtime/Distributed/Persistence/Groundwork/Elsa.Workflows.Runtime.Distributed.Persistence.Groundwork.csproj" />
  </ItemGroup>
</Project>
