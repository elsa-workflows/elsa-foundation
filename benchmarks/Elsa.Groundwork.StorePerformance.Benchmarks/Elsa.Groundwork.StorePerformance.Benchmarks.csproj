<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Diagnostics CORE only: the durable-history workload drives IStructuredLogStore and
         IOpenTelemetryStore, which are the provider-neutral domain contracts. Referencing an
         implementation project here would bind the frozen workload to one stack and defeat the point of
         the differential; the adapter host owns implementation selection. These two are Groundwork-free
         by construction, so they add no provider dependency to the harness. -->
    <ProjectReference Include="../../src/Elsa/Diagnostics/OpenTelemetry/Core/Elsa.Diagnostics.OpenTelemetry.Core.csproj" />
    <ProjectReference Include="../../src/Elsa/Diagnostics/StructuredLogs/Core/Elsa.Diagnostics.StructuredLogs.Core.csproj" />
    <ProjectReference Include="../../src/Elsa/Foundation/Identity/AspNetCoreIdentity/Elsa.Foundation.Identity.AspNetCoreIdentity.csproj" />
    <ProjectReference Include="../../src/Elsa/Workflows/Runtime/Core/Elsa.Workflows.Runtime.Core.csproj" />
    <ProjectReference Include="../../src/Elsa/Workflows/Runtime/Distributed/Elsa.Workflows.Runtime.Distributed.csproj" />
  </ItemGroup>
</Project>
