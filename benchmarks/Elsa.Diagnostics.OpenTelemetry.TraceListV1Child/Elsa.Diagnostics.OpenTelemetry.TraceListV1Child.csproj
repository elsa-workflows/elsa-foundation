<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Match the frozen v1 adapter's central package graph; this is intentionally not the v2 preview feed. -->
    <PackageReference Include="Groundwork.Sqlite" Version="0.0.1-preview.114" />
  </ItemGroup>

  <!--
    This child is deliberately compiled against a frozen v1 worktree supplied by V1Root. It must never
    be project-referenced by the v2 benchmark: the old and new Groundwork package/assembly identities are
    loaded only in separate processes. The default build fails clearly instead of silently substituting v2.
  -->
  <ItemGroup Condition="'$(V1Root)' != ''">
    <ProjectReference Include="$(V1Root)/src/Elsa/Diagnostics/OpenTelemetry/Elsa.Diagnostics.OpenTelemetry.csproj" />
    <ProjectReference Include="$(V1Root)/src/Elsa/Diagnostics/OpenTelemetry/Core/Elsa.Diagnostics.OpenTelemetry.Core.csproj" />
    <ProjectReference Include="$(V1Root)/src/Elsa/Diagnostics/Persistence/Elsa.Diagnostics.Persistence.csproj" />
    <ProjectReference Include="$(V1Root)/src/Elsa/Diagnostics/OpenTelemetry/Persistence/Groundwork/Elsa.Diagnostics.OpenTelemetry.Persistence.Groundwork.csproj" />
  </ItemGroup>

  <Target Name="RequireV1Root" BeforeTargets="PrepareForBuild" Condition="'$(V1Root)' == ''">
    <Error Text="Set V1Root to a clean frozen v1 Elsa worktree (for example, a detached worktree at e30c2d291)." />
  </Target>
</Project>
