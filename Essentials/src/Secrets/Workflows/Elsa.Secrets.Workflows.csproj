<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      The workflow runtime adapter for the Secrets module: an IRuntimeSecretResolver over ISecretValueResolver, so an
      activity input bound to a Secret reference is resolved each time the activity is activated, for the tenant the
      runtime hands over: the execution partition read at activation, which on the background drain path is the host's
      persistence scope. It is a bridge project rather than a dependency either side takes: it references
      Elsa.Secrets.Core and Elsa.Workflows.Runtime.Core only, and neither of those references the other or this.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="Elsa.Specifications.PackageManifest.Generator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Elsa.Secrets.Core.csproj" />
    <ProjectReference Include="..\..\Workflows\Runtime\Core\Elsa.Workflows.Runtime.Core.csproj" />
  </ItemGroup>

</Project>
