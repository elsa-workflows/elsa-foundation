  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Elsa.Connections.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Elsa.Connections\Elsa.Connections.csproj" />
    <ProjectReference Include="..\Core\Elsa.Connections.Core.csproj" />
    <ProjectReference Include="..\..\Activities\Http\Elsa.Activities.Http.csproj" />
    <ProjectReference Include="..\..\Workflows\Runtime\Core\Elsa.Workflows.Runtime.Core.csproj" />
  </ItemGroup>

</Project>
