<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- CShells itself, so its registry builds, reloads, drains and disposes the shell generations readability tracks. -->
    <PackageReference Include="CShells" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Nuplane's own package load context, so a superseded generation is loaded exactly where Nuplane loads one. -->
    <PackageReference Include="Nuplane.Loading" />
    <!-- Reads emitted declarations as metadata only, which is how spec 180's FR-001 requires them to be readable. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\essentials\Cluster\Readability\Elsa.Cluster.Readability.csproj" />
    <!-- Two real modules, so a host that has loaded them reports exactly their declared families. -->
    <ProjectReference Include="..\..\..\..\..\src\essentials\Workflows\Publishing\Persistence\EntityFrameworkCore\Elsa.Workflows.Publishing.Persistence.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\essentials\Workflows\Runtime\Persistence\EntityFrameworkCore\Elsa.Workflows.Runtime.Persistence.EntityFrameworkCore.csproj" />
    <!-- RecordingLogger, to prove a malformed family's disagreement is logged rather than only isolated. -->
    <ProjectReference Include="..\..\..\Testing\Elsa.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
