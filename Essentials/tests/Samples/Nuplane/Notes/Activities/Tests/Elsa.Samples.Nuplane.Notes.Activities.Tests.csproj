<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both samples are one project each that builds as two releases. This project is compiled against release 1.1.0 of
         both; the Notes reference is explicit, so the one the activity package brings in is not built at its default release.
         Release 1.0.0 of both is built beside it (the target below), for its assemblies only. -->
    <ProjectReference Include="..\..\..\..\..\..\..\samples\Elsa.Samples.Nuplane.Notes.Activities\Elsa.Samples.Nuplane.Notes.Activities.csproj"
                      AdditionalProperties="DemoVersion=2" />
    <ProjectReference Include="..\..\..\..\..\..\..\samples\Elsa.Samples.Nuplane.Notes\Elsa.Samples.Nuplane.Notes.csproj"
                      AdditionalProperties="DemoVersion=2" />
    <!-- The activity contracts, which the activity package keeps private, and the shared dormancy check a host composes. -->
    <ProjectReference Include="..\..\..\..\..\..\..\src\essentials\Activities\Design\Core\Elsa.Activities.Design.Core.csproj" />
    <ProjectReference Include="..\..\..\..\..\..\..\src\essentials\Activities\Runtime\Core\Elsa.Activities.Runtime.Core.csproj" />
    <ProjectReference Include="..\..\..\..\..\..\..\src\essentials\Cluster\InProcess\Elsa.Cluster.InProcess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\..\Persistence\EntityFramework\Tests\TemporarySqliteDatabase.cs" Link="TemporarySqliteDatabase.cs" />
    <Compile Include="..\..\..\..\..\..\Shared\FakeObservedSchemaFinalization.cs" Link="FakeObservedSchemaFinalization.cs" />
  </ItemGroup>

  <!--
    Release 1.0.0 is both samples built as they are by default: their assemblies are built here and copied under release-1/,
    where the tests read them in a load context of their own. The activity package's copy of Notes must be release 1.0.0's,
    which is why both are copied: the release the activity was built against.
  -->
  <Target Name="CopyRelease1" AfterTargets="Build">
    <MSBuild Projects="..\..\..\..\..\..\..\samples\Elsa.Samples.Nuplane.Notes.Activities\Elsa.Samples.Nuplane.Notes.Activities.csproj;..\..\..\..\..\..\..\samples\Elsa.Samples.Nuplane.Notes\Elsa.Samples.Nuplane.Notes.csproj"
             Properties="DemoVersion=1" Targets="Build">
      <Output TaskParameter="TargetOutputs" ItemName="Release1" />
    </MSBuild>
    <Copy SourceFiles="@(Release1)" DestinationFolder="$(OutDir)release-1" />
  </Target>

</Project>
