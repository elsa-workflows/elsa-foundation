{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "ConnectionStrings": {
    "Shared": "COMPOSITION_BRIDGE_CONNECTION_CANARY_NOT_A_SECRET"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://fixture.example.test"
    ]
  },
  "Elsa": {
    "Persistence": {
      "DefaultResource": "primary",
      "Resources": {
        "primary": {
          "Provider": "PostgreSql",
          "ConnectionName": "Shared"
        }
      }
    }
  },
  "CustomAppRoot": {
    "Keep": "unchanged"
  }
}
