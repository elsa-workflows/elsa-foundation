<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Build-order only. The tests start the Workbench's own build output as a child process, exactly as an
      operator runs it, so nothing from the host is loaded into the test process.
    -->
    <ProjectReference Include="..\..\..\apps\Elsa.Workbench\Elsa.Workbench.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Fixtures/BackgroundActivities/BackgroundActivities.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Fixtures/Reservations/Reservations.csproj" ReferenceOutputAssembly="false" />
    <!-- The compensation sample package, which WorkbenchCompensationSampleTests drops into the feed as its README says. -->
  </ItemGroup>

</Project>
