  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Activities\Http\Elsa.Activities.Http.csproj" />
    <!-- Elsa.Workflows.Runtime.Http provides the REAL route resolver, route-table startup task, and publish-time
         index observer that keep the route table in step with the trigger index (exercised end to end here). The
         IRouteTable/IRouteMatcher implementations are internal to Elsa.Http and composed via its HttpFeature's
         reflective service loader, unsuitable for a focused fixture; production-equivalent doubles stand in for
         just those two services (see RouteTableTestDoubles.cs). IRouteTable/IRouteMatcher/HttpRouteData contracts
         come transitively via Elsa.Http.Core. -->
    <ProjectReference Include="..\..\..\..\src\Workflows\Runtime\Http\Elsa.Workflows.Runtime.Http.csproj" />
    <!-- The real HttpRequestBodyParser (spec 089 C, T005) so a JSON body's ParsedContent is exercised end to end. -->
