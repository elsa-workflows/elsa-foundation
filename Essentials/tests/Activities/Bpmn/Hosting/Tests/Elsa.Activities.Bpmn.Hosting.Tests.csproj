          Link="Fixtures/templates-current-writer/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../../../specs/1017-direct-bpmn-hosting/evidence/main-adoption/931123c7e/manifest.json"
          Link="Fixtures/templates-current-writer/manifest.json" CopyToOutputDirectory="PreserveNewest" />
