    <None Include="../../../../../../specs/1017-direct-bpmn-hosting/evidence/reviews/round-6/corrections/inputs/*"
          Link="Fixtures/legacy-timer/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
