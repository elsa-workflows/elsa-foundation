          Link="Fixtures/legacy-fault/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../../../specs/1017-direct-bpmn-hosting/evidence/reviews/round-8/corrections/transport/result.json" Link="Fixtures/legacy-fault/old-parent-cancel-source-deferred.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Bpmn.Model" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <ProjectReference Include="../../../../../src/Activities/Bpmn/Core/Elsa.Activities.Bpmn.Core.csproj" />
    <ProjectReference Include="../../../../../src/Foundation/Identity/Persistence/EntityFrameworkCore/Elsa.Foundation.Identity.Persistence.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../../../../apps/Elsa.Workbench/Elsa.Workbench.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../../../../tools/bpmn/DeliveryRecoveryRead/DeliveryRecoveryRead.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../../../../tools/bpmn/NativeWorkDispatch/NativeWorkDispatch.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../../../../specs/1017-direct-bpmn-hosting/evidence/events/model-broadcast/empty-cohort/late-before-crash.json"
          Link="Fixtures/signal-cancellation-input/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Spec 1184 actual pre-claim writer captures, restored by tools/bpmn/restore_evidence.py and pinned by fixtures.json. -->
    <None Include="../../../../../../specs/1184-direct-bpmn-studio/evidence/fixtures.json"
          Link="Fixtures/pre-claim/fixtures.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../../../specs/1184-direct-bpmn-studio/evidence/fixtures/preclaim/*"
          Link="Fixtures/pre-claim/preclaim/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../../../specs/1184-direct-bpmn-studio/evidence/fixtures/human/*"
          Link="Fixtures/pre-claim/human/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/manifest.json"
          Link="Fixtures/legacy-baseline-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/native-parent-pending/*-api.json;../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/native-parent-pending/*-marker.json;../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/native-parent-pending/*.sqlite.gz"
          Link="Fixtures/native-parent-pending/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/called-ack/*-held-api.json;../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/called-ack/*-marker.json;../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/called-ack/*-held.sqlite.gz"
          Link="Fixtures/called-ack/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/broadcast/*.sqlite.gz"
          Link="Fixtures/broadcast/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/legacy-controls/*.sqlite.gz;../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/legacy-controls/called-control-prepare.json;../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/legacy-controls/concurrent-prepare.json;../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/legacy-controls/compensation-handler-b.json;../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/legacy-controls/*-checked.json"
          Link="Fixtures/legacy-controls/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/multi-instance-and-studio/*.sqlite.gz;../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/multi-instance-and-studio/api.json;../../../../../../specs/1017-direct-bpmn-hosting/evidence/baseline/multi-instance-and-studio/physical-checked.json"
