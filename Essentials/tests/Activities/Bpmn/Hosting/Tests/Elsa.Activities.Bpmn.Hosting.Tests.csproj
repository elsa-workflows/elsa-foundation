  <ItemGroup>
    <None Include="../../../../../../specs/1017-direct-bpmn-hosting/evidence/reviews/round-7/pre-correction/natural-order/after-cancel-*.sqlite.gz;../../../../../../specs/1017-direct-bpmn-hosting/evidence/reviews/round-7/pre-correction/natural-order/after-cancel-*-physical.json;../../../../../../specs/1017-direct-bpmn-hosting/evidence/reviews/round-7/pre-correction/natural-order/process.json;../../../../../../specs/1017-direct-bpmn-hosting/evidence/reviews/round-7/pre-correction/natural-order/cancel-response.json"
