<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Deployable host, not a NuGet library. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The whole point of this host: it compiles in no Elsa feature implementation. It is pure plumbing —
    Nuplane (the package feed + runtime assembly loader) and CShells (shell activation, routing,
    per-shell middleware). Every actual feature — activities, HTTP, persistence, and the Tasks
    feature that runs startup/background/recurring tasks — arrives as a package through the Nuplane
    feed and is discovered by CShells through CShells.Nuplane. Versions are centrally managed
    in the repository-root Directory.Packages.props. The shared Elsa.Api.AspNetCore reference below only
    publishes the typed host endpoint metadata contract; it does not bring an Elsa feature into this host.
  -->
  <ItemGroup>
    <!-- Shared typed endpoint ownership/security metadata; this host still compiles no Elsa feature implementation. -->
    <ProjectReference Include="..\..\essentials\Api\AspNetCore\Elsa.Api.AspNetCore.csproj" />

    <!-- CShells: AddCShellsAspNetCore, MapShells, per-shell IMiddlewareShellFeature (auto re-composed per
         generation on reload — hot, no restart). Brings CShells.Abstractions + CShells.AspNetCore.Abstractions
         transitively; those are the interfaces feed features implement against this host's CShells runtime. -->
    <PackageReference Include="CShells.AspNetCore" />
    <PackageReference Include="CShells.Nuplane" />

    <!-- CShells.FastEndpoints: the FastEndpoints runtime seam for CShells. Carries the built-in
         "FastEndpoints" [ShellFeature] that scans a shell's feature assemblies for FastEndpoints
         endpoints and maps them (with per-shell EndpointRoutePrefix). Feed features that expose HTTP
         via FastEndpoints implement IFastEndpointsShellFeature (from CShells.FastEndpoints.Abstractions,
         pulled transitively and shared via Nuplane:Loading:SharedAssemblies) and DependsOn "FastEndpoints".
         Brings FastEndpoints 7.2.0 and depends on CShells.AspNetCore (already referenced above). -->
    <PackageReference Include="CShells.FastEndpoints" />

    <!-- Nuplane: package feed + runtime assembly loading. CShells.Nuplane bridges the loaded package catalog to feature discovery. -->
    <PackageReference Include="Nuplane" />
    <PackageReference Include="Nuplane.Loading" />
    <PackageReference Include="Nuplane.Sources.Directory" />

    <!-- Optional extra #1 only: backs the module-management reconcile endpoint (INuplaneAdminOperations).
         Compiled in, but the endpoints are mapped only when Elsa:ModuleManagement:Enabled is true at
         startup (restart required to toggle). -->
    <PackageReference Include="Nuplane.Admin" />
  </ItemGroup>

  <!--
    Line A, the host baseline every host shares with every feature (ADR 0067, #2126): the ten cross-cutting
    contract packages, closed under their own dependencies, so referencing exactly these ten keeps the closure
    SharedAssemblyClosureGuardTests holds every shared assembly to. None of these is a feature implementation —
    they are the contract surface the comment above already carves out an exception for — so referencing them
    does not compile a feature into this host; every actual feature still arrives only through the Nuplane feed.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\essentials\Attention\Core\Elsa.Attention.Core.csproj" />
    <ProjectReference Include="..\..\essentials\Caching\Core\Elsa.Caching.Core.csproj" />
    <ProjectReference Include="..\..\essentials\Events\Core\Elsa.Events.Core.csproj" />
    <ProjectReference Include="..\..\essentials\Expressions\Core\Elsa.Expressions.Core.csproj" />
    <ProjectReference Include="..\..\essentials\Locking\Core\Elsa.Locking.Core.csproj" />
    <ProjectReference Include="..\..\essentials\Mediator\Core\Elsa.Mediator.Core.csproj" />
    <ProjectReference Include="..\..\essentials\Pipelines\Core\Elsa.Pipelines.Core.csproj" />
    <ProjectReference Include="..\..\essentials\Primitives\Primitives\Elsa.Primitives.csproj" />
    <ProjectReference Include="..\..\essentials\Serialization\Core\Elsa.Serialization.Core.csproj" />
    <ProjectReference Include="..\..\essentials\Tasks\Core\Elsa.Tasks.Core.csproj" />
  </ItemGroup>

  <!--
    Cluster membership, composed once on this host's container (spec 183, FR-017; ADR 0078, amended 2026-09-27), as
    Elsa.Workbench composes it (#2143). Membership is per host, never per shell, so its provider lives in the host's own
    closure rather than arriving through a shell's feature list.

    Elsa.Cluster.Core and Elsa.Persistence.Schema are the host-composed shares every host shares with every package it
    loads (ADR 0067, amended 2026-09-29): the membership contract and dormancy check, and the EF-free half of the
    schema-family surface - the finalization gate's view of the fleet, what the host observed, and the registry the
    dormancy check reads the gates through.

    Elsa.Cluster.Readability composes them (AddEfSchemaReadability): the readability report, the in-process membership
    default (Elsa.Cluster.InProcess) and the dormancy check's source. None of them is a shell feature.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\essentials\Cluster\Core\Elsa.Cluster.Core.csproj" />
    <ProjectReference Include="..\..\essentials\Cluster\Readability\Elsa.Cluster.Readability.csproj" />
    <ProjectReference Include="..\..\essentials\Persistence\Schema\Elsa.Persistence.Schema.csproj" />
  </ItemGroup>

  <!--
    The durable EF membership provider, so two or more of these hosts sharing one database form a cluster (#2151; ADR
    0076, amended 2026-09-29; spec 183, FR-024). AddConfiguredClusterMembership composes it only when
    Elsa:Cluster:Membership:EntityFrameworkCore:Enabled is true, with an explicit Elsa:Cluster:Membership:HostId; with
    nothing configured this host stays a cluster of one on the in-process default. This and the Data Protection key store
    below are the only reasons this host carries EF Core: no feature is compiled in, and every feature's EF module still
    arrives from a feed.

    It brings Elsa.Persistence.EntityFramework, EF Core and Relational. The four provider engines are referenced here
    because the membership table lives in whichever database the operator selects, and the host binds the engine before
    it loads any package; EfCoreDependencyGuardTests holds this host to exactly this EF closure. A feed-loaded EF module
    binds the same copies: Nuplane:Loading:SharedAssemblies shares them and Nuplane:HostProvidedPackages declares them,
    so Nuplane never acquires a second EF Core into the process (appsettings.json says how, and what a source build
    leaves undeclared).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\essentials\Cluster\EntityFrameworkCore\Elsa.Cluster.EntityFrameworkCore.csproj" />
    <!--
      The host's Data Protection composition and its opt-in EF key store (#2191; ADR 0076, amended 2026-10-01): the key ring
      is the host's, as its membership is, so it is composed on this container and never arrives through a shell's feature
      list. It carries the same EF closure as the membership provider, and nothing more.
    -->
    <ProjectReference Include="..\..\essentials\Foundation\DataProtection\EntityFrameworkCore\Elsa.Foundation.DataProtection.EntityFrameworkCore.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Nuplane directory feed drop-folder. -->
    <Folder Include="packages\" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="shells.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The computed-vs-source-build production configuration swap this host shares with Elsa.Workbench (#2084, #2126). -->
  <Import Project="$(MSBuildThisFileDirectory)../ComputedProductionSettings.targets" />

</Project>
