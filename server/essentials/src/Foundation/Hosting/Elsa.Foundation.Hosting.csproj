<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Opt-in Elsa Foundation shell startup and Nuplane discovery for ASP.NET Core hosts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CShells.AspNetCore" />
    <PackageReference Include="CShells.Nuplane" />
    <PackageReference Include="Nuplane" />
    <PackageReference Include="Nuplane.Admin" />
    <PackageReference Include="Nuplane.Loading" />
    <PackageReference Include="Nuplane.Sources.Directory" />
    <!-- Typed endpoint ownership/security metadata for the opt-in health and module-management endpoints. -->
    <ProjectReference Include="../../Api/AspNetCore/Elsa.Api.AspNetCore.csproj" />
    <!-- The contract the opt-in shell-activation Attention contributor implements. -->
    <ProjectReference Include="../../Attention/Core/Elsa.Attention.Core.csproj" />
    <ProjectReference Include="../../Persistence/Schema/Elsa.Persistence.Schema.csproj" />
    <InternalsVisibleTo Include="Elsa.Foundation.Hosting.Tests" />
  </ItemGroup>

</Project>