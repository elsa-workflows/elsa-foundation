    <!-- Tasks -->
    <ProjectReference Include="../../essentials/src/Tasks/Elsa.Tasks/Elsa.Tasks.csproj" />
    <!-- Workflows -->
    <ProjectReference Include="../../essentials/src/Workflows/Dashboard/Elsa.Workflows.Dashboard/Elsa.Workflows.Dashboard.csproj" />
    <ProjectReference Include="../../essentials/src/Workflows/Dashboard/Persistence/EntityFrameworkCore/Elsa.Workflows.Dashboard.Persistence.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../essentials/src/Workflows/Design/Api/Elsa.Workflows.Design.Api.csproj" />
    <ProjectReference Include="../../essentials/src/Workflows/Design/JavaScript/Elsa.Workflows.Design.JavaScript.csproj" />
    <ProjectReference Include="../../essentials/src/Workflows/Design/Persistence/EntityFrameworkCore/Elsa.Workflows.Design.Persistence.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../essentials/src/Workflows/Design/Validations/Elsa.Workflows.Design.Validations/Elsa.Workflows.Design.Validations.csproj" />
    <ProjectReference Include="../../essentials/src/Workflows/Publishing/Api/Elsa.Workflows.Publishing.Api.csproj" />
    <ProjectReference Include="../../essentials/src/Workflows/Publishing/Elsa.Workflows.Publishing/Elsa.Workflows.Publishing.csproj" />
    <ProjectReference Include="../../essentials/src/Workflows/Publishing/Persistence/EntityFrameworkCore/Elsa.Workflows.Publishing.Persistence.EntityFrameworkCore.csproj" />
