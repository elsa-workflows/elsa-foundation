<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Deployable host, not a NuGet library. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The workflow-essentials host: the Foundation host's shape (Nuplane + CShells, the same host baseline and host-composed
    shares) with a curated set of workflow features compiled in, so it starts without reaching a feed. The curated set is
    owned by the maintainers: a feature joins by a ProjectReference below and an entry in shells.json, and leaves the same
    way. Anything outside the set arrives as an add-on package through the Nuplane feed, exactly as on Elsa.Foundation.Host.
    Elsa.Workbench stays the development and QA host that compiles in everything under development.
  -->
  <ItemGroup>
    <ProjectReference Include="../../essentials/src/Api/AspNetCore/Elsa.Api.AspNetCore.csproj" />
    <ProjectReference Include="../../essentials/src/Foundation/Hosting/Elsa.Foundation.Hosting.csproj" />
    <ProjectReference Include="../../essentials/src/Modularity/EntityFramework/Elsa.Modularity.EntityFramework.csproj" />
    <PackageReference Include="CShells.AspNetCore" />
    <PackageReference Include="CShells.FastEndpoints" />
    <PackageReference Include="Nuplane.Admin" />
  </ItemGroup>

  <!-- Line A, the host baseline every host shares with every feature (ADR 0067, #2126), as Elsa.Foundation.Host carries it. -->
  <ItemGroup>
    <ProjectReference Include="../../essentials/src/Attention/Core/Elsa.Attention.Core.csproj" />
    <ProjectReference Include="../../essentials/src/Caching/Core/Elsa.Caching.Core.csproj" />
    <ProjectReference Include="../../essentials/src/Events/Core/Elsa.Events.Core.csproj" />
    <ProjectReference Include="../../essentials/src/Expressions/Core/Elsa.Expressions.Core.csproj" />
    <ProjectReference Include="../../essentials/src/Locking/Core/Elsa.Locking.Core.csproj" />
    <ProjectReference Include="../../essentials/src/Mediator/Core/Elsa.Mediator.Core.csproj" />
    <ProjectReference Include="../../essentials/src/Pipelines/Core/Elsa.Pipelines.Core.csproj" />
    <ProjectReference Include="../../essentials/src/Primitives/Primitives/Elsa.Primitives.csproj" />
    <ProjectReference Include="../../essentials/src/Serialization/Core/Elsa.Serialization.Core.csproj" />
    <ProjectReference Include="../../essentials/src/Tasks/Core/Elsa.Tasks.Core.csproj" />
  </ItemGroup>

  <!--
    Host-composed, never per shell: cluster membership and its readability report (spec 183, #2143, #2151), the Data
    Protection key ring (#2191) and the OpenIddict token store every shell issues and validates tokens against. The four
    engines are the ones those tables, and the curated EF modules, can live in.
  -->
  <ItemGroup>
    <ProjectReference Include="../../essentials/src/Cluster/Core/Elsa.Cluster.Core.csproj" />
    <ProjectReference Include="../../essentials/src/Cluster/Readability/Elsa.Cluster.Readability.csproj" />
    <ProjectReference Include="../../essentials/src/Cluster/EntityFrameworkCore/Elsa.Cluster.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../essentials/src/Persistence/Schema/Elsa.Persistence.Schema.csproj" />
    <ProjectReference Include="../../essentials/src/Foundation/DataProtection/EntityFrameworkCore/Elsa.Foundation.DataProtection.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../essentials/src/Foundation/Identity/OpenIddict/EntityFrameworkCore/Elsa.Foundation.Identity.OpenIddict.EntityFrameworkCore.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <!-- The curated workflow essentials, one project per feature assembly that shells.json enables. -->
  <ItemGroup>
    <!-- Activities -->
    <ProjectReference Include="../../essentials/src/Activities/ControlFlow/Elsa.Activities.ControlFlow.csproj" />
