  </ItemGroup>

  <ItemGroup>
    <!-- The Nuplane directory feed drop-folder for add-on packages. -->
    <Folder Include="packages" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="shells.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="shells.Production.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The computed-vs-source-build production configuration swap every host under apps/ shares (#2084, #2126). -->
  <Import Project="$(MSBuildThisFileDirectory)../ComputedProductionSettings.targets" />

</Project>
