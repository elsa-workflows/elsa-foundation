            {
                "script": {
                    "typeName": "String",
                    "expression": {
                        "type": "Literal",
                        "value": "// S-15 addition: how a Run JavaScript change to a variable it read behaves.\r\nconst mode = getHttpRequestBody().mode;\r\nif (mode === 'copy') {\r\n    // Work on a copy: the variables must not change.\r\n    const arrayCopy = JSON.parse(JSON.stringify(getArrayVariable()));\r\n    arrayCopy.push('added');\r\n    const objectCopy = JSON.parse(JSON.stringify(getObjectVariable()));\r\n    objectCopy.added = 'yes';\r\n} else {\r\n    // Change each variable through an alias of the value read.\r\n    const array = getArrayVariable();\r\n    const arrayAlias = array;\r\n    arrayAlias.push('added');\r\n    const obj = getObjectVariable();\r\n    const objectAlias = obj;\r\n    objectAlias.added = 'yes';\r\n    if (mode === 'assign') {\r\n        // An intended change: assign the variables.\r\n        setArrayVariable(arrayAlias);\r\n        setObjectVariable(objectAlias);\r\n    }\r\n}"
                    }
                },
                "possibleOutcomes": null,
                "result": null,
                "id": "9b3e5d7f1a2c4e05",
                "nodeId": "Workflow1:7ac1d0e5b2f43a10:9b3e5d7f1a2c4e05",
