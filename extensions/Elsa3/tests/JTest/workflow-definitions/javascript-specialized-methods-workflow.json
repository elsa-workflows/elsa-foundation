            {
                "script": {
                    "typeName": "String",
                    "expression": {
                        "type": "Literal",
                        "value": "const promisesAllSettled = getHttpRequestBody().promisesAllSettled;\r\n\r\n(async () =\u003E {\r\n    const promises = [\r\n        Promise.resolve(promisesAllSettled.fulfilledValue),\r\n        Promise.reject(promisesAllSettled.errorReason)\r\n    ];\r\n    const results = await Promise.allSettled(promises);\r\n    return results; \r\n})();\r\n"
                    }
                },
                "possibleOutcomes": null,
