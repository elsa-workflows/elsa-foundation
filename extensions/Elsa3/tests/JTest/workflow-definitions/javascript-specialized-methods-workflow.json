            {
                "script": {
                    "typeName": "String",
                    "expression": {
                        "type": "Literal",
                        "value": "const obj = getHttpRequestBody().nullCoalescing;\r\n\r\nreturn {\r\n    numericValue: obj.numericValue ?? obj.defaultValueWhenNull,\r\n    nullValue: obj.nullValue ?? obj.defaultValueWhenNull,\r\n    stringValue: obj.stringValue ?? obj.defaultValueWhenNull\r\n}\r\n"
