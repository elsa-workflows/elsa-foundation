                        "type": "Literal",
                        "value": "const replaceAllOccurrences = getHttpRequestBody().replaceAllOccurrences;\r\nconst value = replaceAllOccurrences.value;\r\nconst valueToReplace = replaceAllOccurrences.valueToReplace;\r\nconst replaceValueWith = replaceAllOccurrences.replaceValueWith;\r\n\r\nconst result = value.replaceAll(valueToReplace, replaceValueWith);\r\nreturn result;\r\n"
