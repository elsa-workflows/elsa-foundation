            {
                "script": {
                    "typeName": "String",
                    "expression": {
                        "type": "Literal",
                        "value": "const millisecondsToWait = getHttpRequestBody().topLevelAwait.waitTimeMilliseconds;\r\nconst delay = ms =\u003E new Promise(resolve =\u003E {\r\n    for (let start = Date.now(); Date.now() - start \u003C ms;);\r\n    resolve();\r\n});\r\n(async () =\u003E {\r\n    await delay(millisecondsToWait);\r\n    const result = \u0060waited ${millisecondsToWait} milliseconds!\u0060;\r\n    return result;\r\n})();\r\n"
                    }
                },
                "possibleOutcomes": null,
