            {
                "script": {
                    "typeName": "String",
                    "expression": {
                        "type": "Literal",
                        "value": "const logicalAssignmentOperators = getHttpRequestBody().logicalAssignmentOperators\r\nconst onlyWhenTrue = logicalAssignmentOperators[\u0022\u0026\u0026=\u0022].valueAssignedWhenTrue\r\nconst onlyWhenFalse = logicalAssignmentOperators[\u0022||=\u0022].valueAssignedWhenFalse\r\nconst onlyWhenNull = logicalAssignmentOperators[\u0022??=\u0022].valueAssignedWhenNull\r\n\r\nlet onlyWhenTrue_True = true;\r\nlet onlyWhenTrue_False = false;\r\nlet onlyWhenFalse_True = true;\r\nlet onlyWhenFalse_False = false;\r\nlet onlyWhenNull_Null = null;\r\nlet onlyWhenNull_Undefined = undefined;\r\nlet onlyWhenNull_Numeric = 0;\r\nlet onlyWhenNull_String = \u0022\u0022;\r\n\r\nonlyWhenTrue_True \u0026\u0026= onlyWhenTrue;\r\nonlyWhenTrue_False \u0026\u0026= onlyWhenTrue;\r\n\r\nonlyWhenFalse_True ||= onlyWhenFalse;\r\nonlyWhenFalse_False ||= onlyWhenFalse;\r\n\r\nonlyWhenNull_Null ??= onlyWhenNull;\r\nonlyWhenNull_Undefined ??= onlyWhenNull;\r\nonlyWhenNull_Numeric ??= onlyWhenNull;\r\nonlyWhenNull_String ??= onlyWhenNull;\r\n\r\nreturn {\r\n    \u0027\u0026\u0026=\u0027:{\r\n        \u0022true\u0022: onlyWhenTrue_True,\r\n        \u0022false\u0022: onlyWhenTrue_False\r\n    },\r\n    \u0027||=\u0027:{\r\n        \u0022true\u0022: onlyWhenFalse_True,\r\n        \u0022false\u0022: onlyWhenFalse_False\r\n    },\r\n    \u0027??=\u0027:{\r\n        \u0022numericValue\u0022: onlyWhenNull_Numeric,\r\n        \u0022stringValue\u0022: onlyWhenNull_String,\r\n        \u0022nullValue\u0022: onlyWhenNull_Null,\r\n        \u0022undefinedValue\u0022: onlyWhenNull_Undefined\r\n    }\r\n}"
                    }
                },
