{
    "version": "1.0",
    "info": {
        "name": "Testing the array methods in javascript",
        "description": "We additionally assert that none of the array methods change the array Elsa variable"
    },
    "globals": {
        "endpoint": "qa/javascript/array-methods",
        "array": [
            "test1",
            "test2",
            "test3"
        ]
    },
    "tests": [
        {
            "name": "Execute test case for array method 'unshift'",
            "description": "Assertion proves original variable is not changed",
            "steps": [
                {
                    "type": "http",
                    "url": "{{ $.env['elsaExecutorApi:baseUrl'] }}/{{ $.globals.endpoint }}",
                    "method": "POST",
                    "body": {
                        "method": "unshift",
                        "array": "{{ $.globals.array }}",
                        "unshift": {
                            "itemToAdd": "added item1"
                        }
                    },
                    "assert": [
                        {
                            "op": "length",
                            "actualValue": "{{$.this.body.unshiftedArray}}",
                            "expectedValue": 4
                        },
                        {
                            "op": "equals",
                            "actualValue": "{{$.this.body.unshiftedArray[0]}}",
                            "expectedValue": "added item1"
                        },
                        {
                            "op": "equals",
                            "actualValue": "{{$.this.body.unshiftedArray[3]}}",
                            "expectedValue": "test3"
                        },
                        {
                            "op": "length",
                            "actualValue": "{{ $.this.body.arrayVariable }}",
                            "expectedValue": 3
                        },
                        {
                            "op": "equals",
                            "actualValue": "{{$.this.body.arrayVariable[0]}}",
                            "expectedValue": "test1"
                        }
                    ]
                }
            ]
        },
