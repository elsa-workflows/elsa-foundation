    "tests": [
        {
            "name": "Authenticate with Elsa API",
            "steps": [
                {
                    "type": "use",
                    "template": "elsa-authenticate",
                    "with": {
                        "username": "{{ $.env['elsaApi:username'] }}",
                        "password": "{{ $.env['elsaApi:password'] }}",
                        "baseUrl": "{{ $.env['elsaApi:baseUrl'] }}"
                    },
                    "save": {
                        "$.globals.authHeader": "{{ $.this.authHeader }}"
                    }
                }
            ]
        },
        {
            "name": "Act: Execute workflow definition",
            "description": "",
            "steps": [
                {
                    "type": "http",
                    "name": "Execute workflow",
                    "url": "{{ $.env['elsaExecutorApi:baseUrl'] }}/{{ $.globals.workflowDefinitionEndpoint }}",
                    "method": "POST",
                    "body": "{{ $.globals.workflowExecutionRequestBody }}",
                    "assert": [
                        {
                            "op": "equals",
                            "actualValue": "{{ $.this.status }}",
                            "expectedValue": 202
                        }
                    ]
                },
                {
                    "type": "use",
                    "name": "Wait until instance data available",
                    "template": "elsa-wait-for-persistence",
                    "with": {
                        "ms": 1000
                    }
                }
            ]
        },
        {
