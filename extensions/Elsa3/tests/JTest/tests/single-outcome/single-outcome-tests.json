                        },
                        {
                            "op": "equals",
                            "actualValue": "{{ $.this.instances[0].definitionVersionId }}",
                            "expectedValue": "{{ $.globals.workflowDefinitionVersionId }}"
                        },
                        {
                            "op": "equals",
                            "actualValue": "{{ $.this.instances[0].version }}",
                            "expectedValue": "{{ $.globals.workflowDefinitionVersion }}"
