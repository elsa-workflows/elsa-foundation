                        "workflowDefinitionVersion": "{{ $.globals.workflowDefinitionVersion }}",
                        "correlationId": "{{ $.globals.workflowExecutionRequestBody.correlate.id }}"
                    },
                    "assert": [
                        {
                            "op": "exists",
                            "actualValue": "{{ $.this.instances }}"
                        },
                        {
                            "op": "equals",
                            "actualValue": "{{ $.this.instances[0].status }}",
                            "expectedValue": "Finished"
                        },
                        {
                            "op": "equals",
                            "actualValue": "{{ $.this.instances[0].name }}",
                            "expectedValue": "{{ $.globals.workflowExecutionRequestBody.setName.value }}"
                        },
                        {
                            "op": "equals",
                            "actualValue": "{{ $.this.instances[0].definitionId }}",
