            },
            {
                "statusCode": {
                    "typeName": "System.Net.HttpStatusCode, System.Net.Primitives",
                    "expression": {
                        "type": "Literal",
                        "value": "Accepted"
                    }
                },
                "content": {
                    "typeName": "Object",
                    "expression": {
                        "type": "JavaScript",
                        "value": "const text = getHttpRequestBody().text;\r\n// Text to UTF-8 bytes and back with language syntax only: Elsa 4 expressions have no byte helpers.\r\nconst bytes = [];\r\nfor (const ch of text) {\r\n    const cp = ch.codePointAt(0);\r\n    if (cp < 0x80) bytes.push(cp);\r\n    else if (cp < 0x800) bytes.push(0xC0 | (cp >> 6), 0x80 | (cp & 0x3F));\r\n    else if (cp < 0x10000) bytes.push(0xE0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F));\r\n    else bytes.push(0xF0 | (cp >> 18), 0x80 | ((cp >> 12) & 0x3F), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F));\r\n}\r\nlet result = '';\r\nfor (let i = 0; i < bytes.length;) {\r\n    const b = bytes[i];\r\n    const n = b < 0x80 ? 1 : b < 0xE0 ? 2 : b < 0xF0 ? 3 : 4;\r\n    let cp = n === 1 ? b : b & (0xFF >> (n + 1));\r\n    for (let k = 1; k < n; k++) cp = (cp << 6) | (bytes[i + k] & 0x3F);\r\n    result += String.fromCodePoint(cp);\r\n    i += n;\r\n}\r\nreturn{\r\n    result: result, correlationId: getCorrelationId()\r\n}"
                    }
                },
                "contentType": {
                    "typeName": "String",
                    "expression": {
                        "type": "Literal",
                        "value": "application/json"
                    }
                },
                "responseHeaders": {
                    "typeName": "HttpHeaders",
                    "expression": {
                        "type": "Literal",
                        "value": "{}"
                    }
                },
