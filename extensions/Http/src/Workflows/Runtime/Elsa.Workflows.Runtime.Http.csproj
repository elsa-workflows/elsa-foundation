<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Authentication, authorization and HttpContext come from the shared framework, matching
         Elsa.Http.Core, which this project exchanges those types with. A standalone Microsoft.AspNetCore.*
         package here would declare the same type names as the framework's and break that exchange at load
         time. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
	  <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="Elsa.Specifications.PackageManifest.Generator" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Elsa.Http.Core.csproj" />
    <ProjectReference Include="..\..\..\..\..\essentials\src\Primitives\Primitives\Elsa.Primitives.csproj" />
    <ProjectReference Include="..\..\..\..\..\essentials\src\Tasks\Core\Elsa.Tasks.Core.csproj" />
    <ProjectReference Include="..\..\..\..\..\essentials\src\Tasks\Schedules\Elsa.Tasks.Schedules.csproj" />
    <ProjectReference Include="..\..\..\..\..\essentials\src\Workflows\Runtime\Core\Elsa.Workflows.Runtime.Core.csproj" />
  </ItemGroup>

</Project>
