  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Elsa3.Activities.Design.Import\Elsa3.Activities.Design.Import.csproj" />
    <!-- The feature depends on Elsa3ImportActivitiesPublishing; its package comes with this one. -->
