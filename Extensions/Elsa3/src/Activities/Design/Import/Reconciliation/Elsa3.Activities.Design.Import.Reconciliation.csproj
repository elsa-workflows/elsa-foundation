  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Elsa3.Activities.Design.Import.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CShells.Abstractions" />
