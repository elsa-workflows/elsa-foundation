<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ElsaTrackPublicApi>true</ElsaTrackPublicApi>
    <StaticWebAssetBasePath>_content/Elsa.Studio.Jobs</StaticWebAssetBasePath>
    <DefaultItemExcludes>$(DefaultItemExcludes);Client/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Elsa.Specifications.PackageManifest.Generator" PrivateAssets="all" />
    <ProjectReference Include="../../../../Studio/src/essentials/Elsa.Studio.Core/Elsa.Studio.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
