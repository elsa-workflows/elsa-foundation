<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <!-- Reads the Workbench's Rules SQLite file directly: Rules has no runtime inspection REST surface. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared child-process harness; its own build-order reference builds the production Workbench these tests kill. -->
    <ProjectReference Include="../../../../../Essentials/tests/Workbench/Tests/Elsa.Workbench.Tests.csproj" />
    <ProjectReference Include="../../../../../Essentials/apps/Elsa.Workbench/Elsa.Workbench.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
