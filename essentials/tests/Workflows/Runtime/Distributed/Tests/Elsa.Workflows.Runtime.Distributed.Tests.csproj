<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- A real CShells host, to prove a shell reload keeps the leases a host stop hands off (spec 184, FR-021, FR-022). -->
    <PackageReference Include="CShells" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The membership reference provider and its fixture have no dependency on the workflow runner. -->
    <Compile Include="..\..\..\..\Cluster\Tests\Reference\SharedMembershipStore.cs"
             Link="ReferenceMembership\SharedMembershipStore.cs" />
    <Compile Include="..\..\..\..\Cluster\Tests\Reference\SharedStoreClusterMembership.cs"
             Link="ReferenceMembership\SharedStoreClusterMembership.cs" />
    <Compile Include="..\..\..\..\Cluster\Tests\Reference\SharedStoreConformanceFixture.cs"
             Link="ReferenceMembership\SharedStoreConformanceFixture.cs" />
    <!-- Committed golden fixtures: the frozen v1 wire shape of the cross-node command transport item. -->
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\Activities\DispatchWorkflow\Runtime\Elsa.Activities.DispatchWorkflow.Runtime.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\Workflows\Runtime\Api\Elsa.Workflows.Runtime.Api.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\Workflows\Runtime\Distributed\Elsa.Workflows.Runtime.Distributed\Elsa.Workflows.Runtime.Distributed.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\Workflows\Runtime\Core\Elsa.Workflows.Runtime.Core.csproj" />
    <ProjectReference Include="..\..\..\..\..\..\extensions\Tasks\src\Elsa.Tasks\Elsa.Tasks.csproj" />
    <!-- Spec 183's legacy runner invariants reuse the independent membership reference provider. -->
    <ProjectReference Include="..\..\..\..\Cluster\Testing\Elsa.Cluster.Testing.csproj" />
    <!-- AddShellStartupValidation, which both shipped hosts compose: a shell runs its ValidateOnStart checks as it activates (#2331). -->
    <ProjectReference Include="..\..\..\..\..\src\Cluster\Readability\Elsa.Cluster.Readability.csproj" />
    <ProjectReference Include="..\..\..\..\Serialization\Testing\Elsa.Serialization.Testing.csproj" />
    <!-- A real workflow runtime behind one node, to prove a cross-node Cancel stops a progressing drain (#2831). -->
    <ProjectReference Include="..\..\..\..\Activities\Testing\Elsa.Activities.Testing.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\Activities\ControlFlow\Elsa.Activities.ControlFlow.csproj" />
  </ItemGroup>

</Project>
