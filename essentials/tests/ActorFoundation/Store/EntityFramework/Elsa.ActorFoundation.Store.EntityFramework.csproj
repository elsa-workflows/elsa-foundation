<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Kernel.Ef.Conformance</RootNamespace>
    <AssemblyName>Kernel.Ef.Conformance</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Keep the prototype provider's dependency versions until the provider moves to the shared package policy. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <NoWarn>$(NoWarn);EF1002</NoWarn>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- ENGINES.md E2: Microsoft.Data.SqlClient refuses to open a connection in invariant-globalization mode. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../../prototypes/kernel-model/models/Native.Run/PostgresFixtureDatabase.cs" Link="PostgresFixtureDatabase.cs" />
    <ProjectReference Include="../../../../../prototypes/kernel-model/ef/Kernel.EntityFramework/Kernel.EntityFramework.csproj" />
    <ProjectReference Include="../Conformance/Elsa.ActorFoundation.Store.Conformance.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Kernel.Runtime" />
    <Using Include="Kernel.Durable" />
    <Using Include="Kernel.Workflows" />
  </ItemGroup>
</Project>
