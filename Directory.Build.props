<Project>

  <!--
    Shared build settings for every project in the repository.

    Properties set here are imported before each project's own body, so any
    project can still override them locally, with two exceptions: ElsaVersionLine,
    ElsaVersionLineAMembers, ElsaVersion and ElsaContractsVersion come from
    VersionLines.props, not meant to be set anywhere else, and the
    ElsaVerifyVersionLine target below enforces that; and a src/ project's
    package version comes from PackageVersioning.props, which enforces that itself.
    Two projects deliberately keep their own copies rather than inheriting:

      - src/essentials/Workflows/Design/CodeGeneration targets netstandard2.0 as a
        Roslyn source generator and pins its own TargetFramework/ImplicitUsings.

      - The former src/essentials/Foundation/Identity/AspNetCoreIdentity/EntityFrameworkCore
        tree was retired with issue #1482 together with its frozen oracle and ratchet.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Version line, ADR 0067. VersionLines.props holds the one reviewed Line A list; this turns it into
    a per-project signal every project can read from its own $(ElsaVersionLine), without repeating the
    list or re-parsing it per project. #2078 reads it below to enable PublicApiAnalyzers on Line A;
    PackageVersioning.props reads it to choose between ElsaVersion and ElsaContractsVersion.

    The membership check is a property function ($(...Contains(...))), not an item-list Condition,
    because outside a Target MSBuild rejects an item-list reference in a PropertyGroup Condition
    (MSB4099) and a property function cannot see item-list (@(...)) expansion regardless of where it
    runs - only the plain $(...) substitution pass expands items. VersionLines.props keeps the list as
    a delimited property for exactly this reason.
  -->
  <Import Project="$(MSBuildThisFileDirectory)VersionLines.props" />

  <PropertyGroup>
    <ElsaVersionLine>B</ElsaVersionLine>
    <ElsaVersionLine Condition="$(ElsaVersionLineAMembers.Contains(';$(MSBuildProjectName);'))">A</ElsaVersionLine>
  </PropertyGroup>

  <!--
    ADR 0067 build-time check. VersionLineOwnershipGuardTests (tests/essentials/Architecture/Tests) is a static
    scan proving no file under src/ or tests/ sets ElsaVersionLine or ElsaVersionLineAMembers, and
    NoLiteralProjectVersionGuardTests proves no project under src/ sets ElsaVersion or ElsaContractsVersion,
    but a static scan has two blind spots: a global property passed on the command line
    (/p:ElsaVersionLine=..., /p:ElsaVersion=... and the like), which wins over any props-file assignment and
    never appears in a file at all, and any setter that only takes effect at evaluation time from a build
    file the scan doesn't cover - it catches such a setter wherever the file lives, whether inside src/tests
    or outside them; a setter inside a target that runs after this check, or a CreateProperty task, is
    outside both this check and the static scans. This target closes the two gaps it does cover by
    re-reading VersionLines.props directly with XmlPeek - independently of the Import above - and comparing
    the peeked values against what this project actually evaluated ElsaVersionLineAMembers, ElsaVersionLine,
    ElsaVersion and ElsaContractsVersion to.

    It runs on BeforeBuild, GenerateNuspec and _GetProjectVersion, on every project, so a mismatch fails the
    build - or the pack - instead of silently acting on the wrong line until someone happens to inspect the
    property. GenerateNuspec is there because packages.yml packs with dotnet pack's no-build flag, in a
    separate invocation after building, which never runs BeforeBuild, and PackageVersioning.props reads
    these properties at pack time, so a pack-only /p: override must be caught too. _GetProjectVersion is
    how a pack asks each project it references for the version its dependency range starts at, which a
    referenced project answers without building or packing itself. Within one invocation MSBuild runs the
    target once per project instance, and a build followed by a separate no-build pack simply checks twice.
    It lives here, in this .props file, rather than in a Directory.Build.targets, because a target can be
    defined in a .props file - keeping the check beside the computation it verifies is the point - and
    because a Directory.Build.targets would be skipped by any nested Directory.Build.targets that forgets to
    import it, whereas every project already imports this file.
    tests/essentials/Architecture/Tests/VersionLineBuildCheckTests.cs proves it, including the /p: cases the
    static scans cannot see.
  -->
  <Target Name="ElsaVerifyVersionLine" BeforeTargets="BeforeBuild;GenerateNuspec;_GetProjectVersion">

    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)VersionLines.props"
             Query="/Project/PropertyGroup/ElsaVersionLineAMembers/text()">
      <Output TaskParameter="Result" PropertyName="_ElsaReviewedLineAMembers" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)VersionLines.props"
             Query="/Project/PropertyGroup/ElsaVersion/text()">
      <Output TaskParameter="Result" PropertyName="_ElsaReviewedVersion" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)VersionLines.props"
             Query="/Project/PropertyGroup/ElsaContractsVersion/text()">
      <Output TaskParameter="Result" PropertyName="_ElsaReviewedContractsVersion" />
    </XmlPeek>

    <Error Code="ELSAVL003"
           Condition="'$(_ElsaReviewedLineAMembers)' == '' or '$(_ElsaReviewedVersion)' == '' or '$(_ElsaReviewedContractsVersion)' == ''"
           Text="Could not read ElsaVersionLineAMembers, ElsaVersion and ElsaContractsVersion from $(MSBuildThisFileDirectory)VersionLines.props via XmlPeek. The file may have moved or its shape changed; update the XmlPeek queries in the ElsaVerifyVersionLine target (Directory.Build.props) to match." />

    <Error Code="ELSAVL004"
           Condition="'$(ElsaVersion)' != '$(_ElsaReviewedVersion.Trim())' or '$(ElsaContractsVersion)' != '$(_ElsaReviewedContractsVersion.Trim())'"
           Text="$(MSBuildProjectName) evaluates ElsaVersion as '$(ElsaVersion)' and ElsaContractsVersion as '$(ElsaContractsVersion)', but VersionLines.props defines '$(_ElsaReviewedVersion.Trim())' and '$(_ElsaReviewedContractsVersion.Trim())'. Each line's major.minor is set in VersionLines.props alone (spec 150 FR-010) - not in this project file, not in a nested Directory.Build.props/.targets, and not via /p:ElsaVersion or /p:ElsaContractsVersion - because the version calculator reads it from that file, and a build that saw another value would disagree with the version it computed." />

    <PropertyGroup>
      <_ElsaReviewedVersionLine>B</_ElsaReviewedVersionLine>
      <_ElsaReviewedVersionLine Condition="$(_ElsaReviewedLineAMembers.Contains(';$(MSBuildProjectName);'))">A</_ElsaReviewedVersionLine>
    </PropertyGroup>

    <Error Code="ELSAVL002"
           Condition="'$(_ElsaReviewedLineAMembers)' != '' and '$(ElsaVersionLineAMembers.Trim())' != '$(_ElsaReviewedLineAMembers.Trim())'"
           Text="$(MSBuildProjectName) sees ElsaVersionLineAMembers as '$(ElsaVersionLineAMembers)', but VersionLines.props itself defines '$(_ElsaReviewedLineAMembers)'. Something - this project file, a nested Directory.Build.props/.targets, or an /p:ElsaVersionLineAMembers override - replaced the reviewed list. VersionLines.props is the only place to change Line A membership." />

    <Error Code="ELSAVL001"
           Condition="'$(_ElsaReviewedLineAMembers)' != '' and '$(ElsaVersionLine)' != '$(_ElsaReviewedVersionLine)'"
           Text="$(MSBuildProjectName) evaluates ElsaVersionLine as '$(ElsaVersionLine)', but VersionLines.props puts it on line '$(_ElsaReviewedVersionLine)'. ElsaVersionLine is derived from VersionLines.props and must not be set anywhere else - not in this project file, not in a nested Directory.Build.props/.targets, and not via /p:ElsaVersionLine." />

  </Target>

  <!--
    Package versions (spec 150): after the version line, which it reads, and after the check above, so a wrong line
    is reported before any version derived from it. PackageRanges.targets, imported right after, bounds dependency
    ranges from the version PackageVersioning.props selects.
  -->
  <Import Project="$(MSBuildThisFileDirectory)PackageVersioning.props" />
  <Import Project="$(MSBuildThisFileDirectory)PackageRanges.targets" />

  <!--
    #2078: Line A's version is meant to move only when its contract changes, and PublicApiAnalyzers is
    what makes such a change visible - it fails the build when a public member is added or removed
    without a matching PublicAPI.Shipped.txt/PublicAPI.Unshipped.txt entry. Scoped to
    $(ElsaVersionLine) == 'A' so the other ~120 packages are untouched; they wait for the 4.0 cut and
    ApiCompat (a separate issue). PrivateAssets="all" keeps the analyzer a build-time-only reference:
    it must not appear as a dependency of the packed Line A nupkg.

    RS0016 (public API not declared) and RS0017 (declared API removed) are promoted to errors for Line
    A only, via WarningsAsErrors rather than the repo-wide TreatWarningsAsErrors, so this stays additive
    to the warnings-only analysis policy above. Every other PublicApiAnalyzers rule stays a warning.
  -->
  <ItemGroup Condition="'$(ElsaVersionLine)' == 'A'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <PropertyGroup Condition="'$(ElsaVersionLine)' == 'A'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <!--
    Static analysis. The repository had no .editorconfig and no analyzer settings
    at all, so its (genuinely good) style consistency was held up by code review
    alone. The root .editorconfig codifies conventions the code already follows.

    Everything is warnings-only on purpose: no TreatWarningsAsErrors here, so
    turning analysis on cannot wedge the build. Promoting rules to errors is a
    deliberate follow-up once the tree is clean under them.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Shared NuGet package metadata for the publishable Elsa.* libraries. -->
  <PropertyGroup>
    <Authors>Elsa Workflows</Authors>
    <Company>Elsa Workflows</Company>
    <Product>Elsa</Product>
    <Copyright>Copyright © Elsa Workflows</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/elsa-workflows/elsa-foundation</PackageProjectUrl>
    <RepositoryUrl>https://github.com/elsa-workflows/elsa-foundation.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>elsa;workflow;workflows;orchestration;automation</PackageTags>
  </PropertyGroup>

</Project>
