<Project>

  <!--
    Shared build settings for every project in the repository.

    Properties set here are imported before each project's own body, so any
    project can still override them locally, with one exception: ElsaVersionLine
    and ElsaVersionLineAMembers are derived from VersionLines.props, not meant to
    be set anywhere else, and the ElsaVerifyVersionLine target below enforces that.
    Two projects deliberately keep their own copies rather than inheriting:

      - src/essentials/Workflows/Design/CodeGeneration targets netstandard2.0 as a
        Roslyn source generator and pins its own TargetFramework/ImplicitUsings.

      - The former src/essentials/Foundation/Identity/AspNetCoreIdentity/EntityFrameworkCore
        tree was retired with issue #1482 together with its frozen oracle and ratchet.

    Still deliberately absent: Version. CI injects /p:Version.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Version line, ADR 0067. VersionLines.props holds the one reviewed Line A list; this turns it into
    a per-project signal every project can read from its own $(ElsaVersionLine), without repeating the
    list or re-parsing it per project. #2078 reads it below to enable PublicApiAnalyzers on Line A;
    #2080 will read it to choose the version property.

    The membership check is a property function ($(...Contains(...))), not an item-list Condition,
    because outside a Target MSBuild rejects an item-list reference in a PropertyGroup Condition
    (MSB4099) and a property function cannot see item-list (@(...)) expansion regardless of where it
    runs - only the plain $(...) substitution pass expands items. VersionLines.props keeps the list as
    a delimited property for exactly this reason.
  -->
  <Import Project="$(MSBuildThisFileDirectory)VersionLines.props" />

  <PropertyGroup>
    <ElsaVersionLine>B</ElsaVersionLine>
    <ElsaVersionLine Condition="$(ElsaVersionLineAMembers.Contains(';$(MSBuildProjectName);'))">A</ElsaVersionLine>
  </PropertyGroup>

  <!--
    ADR 0067 build-time check. VersionLineOwnershipGuardTests (tests/essentials/Architecture) is a static
    scan proving no file under src/ or tests/ sets ElsaVersionLine or ElsaVersionLineAMembers, but a static
    scan has two blind spots: a global property passed on the command line (/p:ElsaVersionLine=... or
    /p:ElsaVersionLineAMembers=...), which wins over any props-file assignment and never appears in a file
    at all, and any setter that only takes effect at evaluation time from a build file the scan doesn't
    cover - it catches such a setter wherever the file lives, whether inside src/tests or outside them; a
    setter inside a target that runs after this check, or a CreateProperty task, is outside both this
    check and the static scan. This target closes the two gaps it does cover by re-reading
    VersionLines.props directly with XmlPeek - independently of the Import above - and comparing that
    peeked value against what this project actually evaluated ElsaVersionLineAMembers and ElsaVersionLine
    to.

    It runs on BeforeBuild and GenerateNuspec, on every project, so a mismatch fails the build - or the
    pack - instead of silently acting on the wrong line until someone happens to inspect the property.
    GenerateNuspec is there because packages.yml packs with dotnet pack's no-build flag, in a separate
    invocation after building, which never runs BeforeBuild, and #2080 will read $(ElsaVersionLine) at
    pack time, so a pack-only /p: override must be caught too; within one invocation MSBuild runs it once,
    and a build followed by a separate no-build pack simply checks twice. It lives here, in this .props
    file, rather than in a Directory.Build.targets, because a target can be defined in a .props file -
    keeping the check beside the computation it verifies is the point - and because a Directory.Build.targets
    would be skipped by any nested Directory.Build.targets that forgets to import it, whereas every project
    already imports this file.
    tests/essentials/Architecture/VersionLineBuildCheckTests.cs proves it, including the /p: cases the
    static scan cannot see.
  -->
  <Target Name="ElsaVerifyVersionLine" BeforeTargets="BeforeBuild;GenerateNuspec">

    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)VersionLines.props"
             Query="/Project/PropertyGroup/ElsaVersionLineAMembers/text()">
      <Output TaskParameter="Result" PropertyName="_ElsaReviewedLineAMembers" />
    </XmlPeek>

    <Error Code="ELSAVL003"
           Condition="'$(_ElsaReviewedLineAMembers)' == ''"
           Text="Could not read ElsaVersionLineAMembers from $(MSBuildThisFileDirectory)VersionLines.props via XmlPeek. The file may have moved or its shape changed; update the XmlPeek query in the ElsaVerifyVersionLine target (Directory.Build.props) to match." />

    <PropertyGroup>
      <_ElsaReviewedVersionLine>B</_ElsaReviewedVersionLine>
      <_ElsaReviewedVersionLine Condition="$(_ElsaReviewedLineAMembers.Contains(';$(MSBuildProjectName);'))">A</_ElsaReviewedVersionLine>
    </PropertyGroup>

    <Error Code="ELSAVL002"
           Condition="'$(_ElsaReviewedLineAMembers)' != '' and '$(ElsaVersionLineAMembers.Trim())' != '$(_ElsaReviewedLineAMembers.Trim())'"
           Text="$(MSBuildProjectName) sees ElsaVersionLineAMembers as '$(ElsaVersionLineAMembers)', but VersionLines.props itself defines '$(_ElsaReviewedLineAMembers)'. Something - this project file, a nested Directory.Build.props/.targets, or an /p:ElsaVersionLineAMembers override - replaced the reviewed list. VersionLines.props is the only place to change Line A membership." />

    <Error Code="ELSAVL001"
           Condition="'$(_ElsaReviewedLineAMembers)' != '' and '$(ElsaVersionLine)' != '$(_ElsaReviewedVersionLine)'"
           Text="$(MSBuildProjectName) evaluates ElsaVersionLine as '$(ElsaVersionLine)', but VersionLines.props puts it on line '$(_ElsaReviewedVersionLine)'. ElsaVersionLine is derived from VersionLines.props and must not be set anywhere else - not in this project file, not in a nested Directory.Build.props/.targets, and not via /p:ElsaVersionLine." />

  </Target>

  <!--
    #2078: Line A's version is meant to move only when its contract changes, and PublicApiAnalyzers is
    what makes such a change visible - it fails the build when a public member is added or removed
    without a matching PublicAPI.Shipped.txt/PublicAPI.Unshipped.txt entry. Scoped to
    $(ElsaVersionLine) == 'A' so the other ~120 packages are untouched; they wait for the 4.0 cut and
    ApiCompat (a separate issue). PrivateAssets="all" keeps the analyzer a build-time-only reference:
    it must not appear as a dependency of the packed Line A nupkg.

    RS0016 (public API not declared) and RS0017 (declared API removed) are promoted to errors for Line
    A only, via WarningsAsErrors rather than the repo-wide TreatWarningsAsErrors, so this stays additive
    to the warnings-only analysis policy above. Every other PublicApiAnalyzers rule stays a warning.
  -->
  <ItemGroup Condition="'$(ElsaVersionLine)' == 'A'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <PropertyGroup Condition="'$(ElsaVersionLine)' == 'A'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <!--
    Static analysis. The repository had no .editorconfig and no analyzer settings
    at all, so its (genuinely good) style consistency was held up by code review
    alone. The root .editorconfig codifies conventions the code already follows.

    Everything is warnings-only on purpose: no TreatWarningsAsErrors here, so
    turning analysis on cannot wedge the build. Promoting rules to errors is a
    deliberate follow-up once the tree is clean under them.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Shared NuGet package metadata for the publishable Elsa.* libraries. -->
  <PropertyGroup>
    <Authors>Elsa Workflows</Authors>
    <Company>Elsa Workflows</Company>
    <Product>Elsa</Product>
    <Copyright>Copyright © Elsa Workflows</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/elsa-workflows/elsa-foundation</PackageProjectUrl>
    <RepositoryUrl>https://github.com/elsa-workflows/elsa-foundation.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>elsa;workflow;workflows;orchestration;automation</PackageTags>
  </PropertyGroup>

</Project>
