<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="CShells Preview" value="https://f.feedz.io/valence-works/cshells/nuget/index.json" />
    <add key="Nuplane Preview" value="https://f.feedz.io/valence-works/nuplane/nuget/index.json" />
    <add key="Elsa 3 Preview" value="https://f.feedz.io/elsa-workflows/elsa-3/nuget/index.json" />
    <add key="Groundwork Preview" value="https://f.feedz.io/valence-works/groundwork/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Acornima" />
      <package pattern="Anthropic" />
      <package pattern="BouncyCastle.*" />
      <package pattern="ConsoleLogStreaming.*" />
      <package pattern="coverlet.*" />
      <package pattern="Cronos" />
      <package pattern="DistributedLock.*" />
      <package pattern="Docker.DotNet.*" />
      <package pattern="FastEndpoints" />
      <package pattern="FastEndpoints.*" />
      <package pattern="Fluid.*" />
      <package pattern="FluentValidation" />
      <package pattern="GitHub.Copilot.SDK" />
      <package pattern="Humanizer.*" />
      <package pattern="JetBrains.Annotations" />
      <package pattern="Jint" />
      <package pattern="Json.More.*" />
      <package pattern="JsonPointer.*" />
      <package pattern="JsonSchema.*" />
      <package pattern="Microsoft.*" />
      <package pattern="MongoDB.*" />
      <package pattern="Mono.TextTemplating" />
      <package pattern="Newtonsoft.*" />
      <package pattern="Npgsql" />
      <package pattern="Npgsql.*" />
      <package pattern="NuGet.*" />
      <package pattern="Nuplane" />
      <package pattern="Nuplane.*" />
      <package pattern="Open.Linq.AsyncExtensions" />
      <package pattern="OpenIddict" />
      <package pattern="OpenIddict.*" />
      <package pattern="Parlot" />
      <package pattern="Polly" />
      <package pattern="Polly.*" />
      <package pattern="SharpZipLib" />
      <package pattern="SourceGear.*" />
      <package pattern="SQLitePCLRaw.*" />
      <package pattern="SSH.NET" />
      <package pattern="System.*" />
      <package pattern="Testcontainers" />
      <package pattern="Testcontainers.*" />
      <package pattern="TimeZoneConverter" />
      <package pattern="Ulid" />
      <package pattern="Validation" />
      <package pattern="xunit" />
      <package pattern="xunit.*" />
      <package pattern="Xunit.*" />
    </packageSource>
    <packageSource key="CShells Preview">
      <package pattern="CShells" />
      <package pattern="CShells.*" />
    </packageSource>
    <packageSource key="Nuplane Preview">
      <package pattern="Nuplane" />
      <package pattern="Nuplane.*" />
    </packageSource>
    <packageSource key="Elsa 3 Preview">
      <package pattern="Elsa.Platform.*" />
    </packageSource>
    <packageSource key="Groundwork Preview">
      <package pattern="Groundwork.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
