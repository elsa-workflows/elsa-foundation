            "format": "date-time"
          }
        }
      },
      "AuthenticationChallengeMetadata": {
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "default": "GET"
          },
          "scheme": {
            "type": [
              "null",
              "string"
            ]
          },
          "parameters": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "AuthSession": {
        "required": [
          "status",
          "subject",
          "displayName",
          "tenantId",
          "roles",
          "permissions",
          "tokenFreshness",
          "provider"
