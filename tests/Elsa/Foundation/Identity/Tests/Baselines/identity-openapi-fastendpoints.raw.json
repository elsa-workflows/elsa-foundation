              "type": "string"
            }
          },
          "tokenFreshness": {
            "type": "string"
          },
          "provider": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EffectiveProviderCapabilities": {
        "required": [
          "canManageUsers",
          "canManageRoles",
          "canManageApplications",
          "canMapGroups",
          "canIssueTokens",
          "canRefreshTokens",
          "canRevokeTokens",
          "permissionPropagation"
        ],
        "type": "object",
        "properties": {
          "canManageUsers": {
            "type": "boolean"
          },
          "canManageRoles": {
            "type": "boolean"
          },
          "canManageApplications": {
            "type": "boolean"
          },
          "canMapGroups": {
            "type": "boolean"
          },
          "canIssueTokens": {
            "type": "boolean"
          },
          "canRefreshTokens": {
            "type": "boolean"
          },
          "canRevokeTokens": {
            "type": "boolean"
          },
