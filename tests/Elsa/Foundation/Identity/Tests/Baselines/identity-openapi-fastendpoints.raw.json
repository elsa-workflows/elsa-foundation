        }
      },
      "IdentityProviderResponse": {
        "required": [
          "id",
          "kind",
          "displayName",
          "isDefault",
          "enabled",
          "challenge"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "isDefault": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "challenge": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AuthenticationChallengeMetadata"
              }
            ]
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "tenantId": {
            "type": [
              "null",
              "string"
            ]
          },
          "returnUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "OwnershipMode": {
        "type": "integer"
      },
      "PermissionPropagationMode": {
        "type": "integer"
      },
      "ProviderRouteRequest": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          }
        }
      },
      "RefreshTokenRequest": {
