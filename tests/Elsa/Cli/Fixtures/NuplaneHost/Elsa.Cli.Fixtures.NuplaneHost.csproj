<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Description>
      A host shaped like a packaged one: it carries Nuplane, the persistence policy assembly and a provider
      engine, and no module of its own. Its modules arrive from a package root, which is the only way to
      exercise the loader path a Nuplane host actually resolves through.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Nuplane" />
    <PackageReference Include="Nuplane.Loading" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\Elsa\Persistence\EntityFramework\Elsa.Persistence.EntityFramework.csproj" />
  </ItemGroup>

</Project>
