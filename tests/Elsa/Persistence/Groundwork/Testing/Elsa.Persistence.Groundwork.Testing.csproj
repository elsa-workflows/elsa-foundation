<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test-support library (not a test project): the shared in-memory Groundwork IDocumentStore
       test double consumed by the Groundwork-backed store test suites across several domains. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Groundwork.Core" />
    <PackageReference Include="Groundwork.Documents" />
  </ItemGroup>

</Project>
