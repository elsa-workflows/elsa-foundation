<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared design-conformance contracts that legitimately reference Groundwork.

    The neutral contract project next door (Elsa.Persistence.Groundwork.DesignConformance.Tests) is
    guarded Groundwork-free: its suites describe design persistence in terms every provider shares, and
    DesignContractSuiteShapeTests fails if a Groundwork assembly, package or project reaches it. The
    target-declaration contract cannot be written that way, because it asserts the semantics of the
    Groundwork target registry itself, so it lives here rather than being allowlisted into that project.

    Referencing Groundwork is the point of this project, so the neutral project's envelope does not apply.
    What must still hold is the property that makes a contract shared at all: it names no concrete
    provider. TargetContractSuiteShapeTests guards that. A suite here may know the target registry, but
    never SQLite, SQL Server, PostgreSQL or MongoDB, which is what the per-provider projects supply.
  -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../../../../src/Elsa/Persistence/Groundwork/Elsa.Persistence.Groundwork.csproj" />
    <ProjectReference Include="../../../../../../../src/Elsa/Persistence/Groundwork/V2/Elsa.Persistence.Groundwork.V2.csproj" />
  </ItemGroup>

</Project>
