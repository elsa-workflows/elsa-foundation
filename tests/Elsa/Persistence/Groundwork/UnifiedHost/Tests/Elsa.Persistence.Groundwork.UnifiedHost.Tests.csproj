  <Target Name="CopyGroundworkProcessProbeArtifacts" AfterTargets="Build">
    <RemoveDir Directories="$(TargetDir)GroundworkProcessProbe" />
    <ItemGroup>
      <_GroundworkProcessProbeArtifact Include="$(MSBuildProjectDirectory)/../../ProcessProbe/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_GroundworkProcessProbeArtifact)"
          DestinationFiles="@(_GroundworkProcessProbeArtifact->'$(TargetDir)GroundworkProcessProbe/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

