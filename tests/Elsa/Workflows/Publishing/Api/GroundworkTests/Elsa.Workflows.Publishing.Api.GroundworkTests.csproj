<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The publishing API suites that exercise Groundwork persistence. Split from the sibling Api tests
    because these open a real provider through the public v2 catalog, and that pulls the provider
    driver packages into the reference set. The sibling project is an API-surface project and has no
    business carrying a database driver, so the split is the lane boundary rather than an accident.
  -->

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The draft-test-run suites self-host the Minimal API surface for routing and dispatch tests. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Linked rather than copied: the endpoint-routing assertions here and in the sibling Api tests must
      resolve endpoints the same way, and two divergent copies of that helper is how they stop doing so.
    -->
    <Compile Include="..\Tests\Support\PublishingMinimalApiTestSurface.cs"
             Link="Support\PublishingMinimalApiTestSurface.cs" />
    <Compile Include="..\Tests\Fakes.cs" Link="Fakes.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Groundwork.Kernel" />
    <PackageReference Include="Groundwork.Query.Model" />
    <PackageReference Include="Groundwork.Store" />
    <PackageReference Include="Groundwork.Sqlite" VersionOverride="0.2.0-preview.1" />
    <PackageReference Include="Groundwork.Testing" VersionOverride="0.2.0-preview.1" />
  </ItemGroup>

