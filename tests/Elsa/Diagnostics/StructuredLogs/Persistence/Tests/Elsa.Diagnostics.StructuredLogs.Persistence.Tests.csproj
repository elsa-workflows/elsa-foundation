<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CShells.AspNetCore.Abstractions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Groundwork comparand for the #646 EF differential. SQLite only, and deliberately not the shared
         Groundwork provider-driver test library: that library carries container-based provider packages,
         and ci.yml selects the fast PR gate by grepping csproj text, so referencing it here (or even
         naming the package family in this file) would route this project into nightly-only CI. -->
    <!-- The nested package props pins this differential comparand to the public v2 provider while
         the rest of the legacy diagnostics graph remains on its v1 provider package. -->
    <PackageReference Include="Groundwork.Sqlite" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\..\src\Elsa\Api\FastEndpoints\Elsa.Api.FastEndpoints.csproj" />
