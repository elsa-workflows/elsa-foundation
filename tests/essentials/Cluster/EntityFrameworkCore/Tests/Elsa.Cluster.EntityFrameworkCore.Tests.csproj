<Project Sdk="Microsoft.NET.Sdk">

  <!-- The EF membership provider on SQLite: the conformance kit, the user story 2 and 4 scenarios and the provider's own
       tests, in the container-free fast gate. The container legs run the same suites in ProviderTests. -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Testing\Elsa.Cluster.EntityFrameworkCore.Testing.csproj" />
  </ItemGroup>

  <!--
    The feed-module fixture is built but never referenced (#2143): its assembly is copied under feed-module/ and loaded
    only into a load context of the kind Nuplane gives a package, never into this process's own, so what the tests see
    is exactly what a host sees of a package that carries its own copy of Elsa.Persistence.EntityFramework.
  -->
  <ItemGroup>
    <!-- What both hosts carry and share with the packages they load, which the fixture's web feature binds to. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CShells.AspNetCore.Abstractions" />
    <ProjectReference Include="..\..\Fixtures\FeedModule\Elsa.Cluster.Fixtures.FeedModule.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="FeedModuleFixture" />
  </ItemGroup>

  <!--
    Which of the fixture's references are the host's is decided by Nuplane's own binding, validation and matcher over the
    host's appsettings.json (#2150), not by name, so a share that would not match on the real host does not match here.
  -->
  <ItemGroup>
    <PackageReference Include="Nuplane.Loading" />
    <Compile Include="../../../../Shared/NuplaneSharedAssemblyPolicy.cs" Link="NuplaneSharedAssemblyPolicy.cs" />
  </ItemGroup>

  <!--
    Build-order only, and the fixture's packing beside it (#2143): FoundationHostBootTests start the host's own build
    output as a child process, over a directory feed holding the fixture and the EF persistence package it carries a
    private copy of, exactly as an operator runs it. Nothing from the host is loaded into this process.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\apps\Elsa.Foundation.Host\Elsa.Foundation.Host.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyFeedModuleFixture" AfterTargets="Build">
    <Copy SourceFiles="@(FeedModuleFixture)" DestinationFolder="$(OutDir)feed-module" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
