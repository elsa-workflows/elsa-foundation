<Project Sdk="Microsoft.NET.Sdk">

  <!-- The EF membership provider on SQL Server, PostgreSQL and MySQL (spec 183, FR-033): the conformance kit and the
       user story 2 and 4 scenarios, each on a Testcontainers database of its own, and on PostgreSQL the two-host boot. Set
       ELSA_CLUSTER_MEMBERSHIP_EF_REQUIRE_NATIVE_PROVIDERS to make a missing container fail instead of skip. -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Testing\Elsa.Cluster.EntityFrameworkCore.Testing.csproj" />
  </ItemGroup>

  <!--
    The two-host boot scenario of the Tests project on PostgreSQL (#2151): its harness is linked, not copied. The built
    Elsa.Foundation.Host and the two release fixtures it packs are build-order references only, exactly as in the Tests
    project; nothing of them is loaded into this process.
  -->
  <ItemGroup>
    <Compile Include="..\Tests\FoundationHostFeed.cs;..\Tests\FoundationHostProcess.cs;..\Tests\FoundationHostComposition.cs;..\Tests\FoundationHostClusterScenario.cs;..\Tests\FeedModuleDatabase.cs;..\Tests\CapturedOutput.cs;..\Tests\Polling.cs;..\Tests\ChildProcess.cs" LinkBase="FoundationHost" />
    <ProjectReference Include="..\..\..\..\..\src\apps\Elsa.Foundation.Host\Elsa.Foundation.Host.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Fixtures\FeedModule\Elsa.Cluster.Fixtures.FeedModule.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Fixtures\FeedModuleV1\Elsa.Cluster.Fixtures.FeedModuleV1.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
