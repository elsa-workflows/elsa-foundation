<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      An EF module and a feature that needs its newest schema version, shaped the way a Nuplane package arrives on a host
      (#2143): it is never loaded into the test process's own load context, only into one of the kind Nuplane gives a
      package, which carries its own copy of Elsa.Persistence.EntityFramework and of every other Elsa assembly the host
      does not share. Its family is at version 2 with an upcaster from 1, so a database whose record is at 1 shows whether
      the module's finalization gate reached the host's fleet, and its feature asks the shared dormancy check before it
      serves, so it shows whether the host's check sees the module's gate.
    </Description>
  </PropertyGroup>

  <!--
    Two other releases of the same package, for an in-place upgrade (spec 183, FR-021, amended 2026-09-29), which
    FoundationHostFeed builds and packs with -p:FeedModuleRelease=previous or =next. Each builds into outputs of its own,
    so it never overwrites the build every other test loads, and neither is ever this project's default.
    - previous: a lower package version whose family is at version 1 with no upcaster, so it reads version 1 alone.
    - next: a higher package version that is this release plus one migration, so a host that validates its migrations
      has one pending when it reloads onto it.
  -->
  <PropertyGroup Condition="'$(FeedModuleRelease)' != ''">
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)release-$(FeedModuleRelease)/$(Configuration)/</IntermediateOutputPath>
    <!-- BaseOutputPath is not set yet here, so the default bin/ is spelled out. -->
    <OutputPath>bin/release-$(FeedModuleRelease)/$(Configuration)/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FeedModuleRelease)' == 'previous'">
    <DefineConstants>$(DefineConstants);FEED_MODULE_PREVIOUS_RELEASE</DefineConstants>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FeedModuleRelease)' == 'next'">
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="FeedModuleOneToTwo.cs" Condition="'$(FeedModuleRelease)' == 'previous'" />
    <Compile Remove="FeedModuleAddTags.cs" Condition="'$(FeedModuleRelease)' != 'next'" />
  </ItemGroup>

  <ItemGroup>
    <!-- The feature maps one endpoint, so a real Elsa.Foundation.Host that loads this fixture from a feed shows its
         dormancy over HTTP. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CShells.AspNetCore.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packed at the package root, as every EF module package's is, when the fixture is packed for a feed. -->
    <None Update="nuplane.json" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\essentials\Persistence\EntityFramework\Elsa.Persistence.EntityFramework.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\essentials\Cluster\Core\Elsa.Cluster.Core.csproj" />
  </ItemGroup>

</Project>
