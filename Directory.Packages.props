<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Acornima" Version="1.6.1" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="ConsoleLogStreaming.AspNetCore" Version="1.0.0-preview.13" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="CShells" Version="0.0.29-preview.147" />
    <PackageVersion Include="CShells.Abstractions" Version="0.0.29-preview.147" />
    <PackageVersion Include="CShells.AspNetCore" Version="0.0.29-preview.147" />
    <PackageVersion Include="CShells.AspNetCore.Abstractions" Version="0.0.29-preview.147" />
    <PackageVersion Include="CShells.FastEndpoints" Version="0.0.29-preview.147" />
    <PackageVersion Include="CShells.FastEndpoints.Abstractions" Version="0.0.29-preview.147" />
    <PackageVersion Include="CShells.Management.Api" Version="0.0.29-preview.147" />
    <PackageVersion Include="DistributedLock.FileSystem" Version="1.0.3" />
    <PackageVersion Include="Elsa.Platform.PackageManifest.Generator" Version="0.0.1-preview.79" />
    <PackageVersion Include="Elsa.Platform.PackageManifests" Version="0.0.1-preview.58" />
    <PackageVersion Include="Fluid.Core" Version="2.31.0" />
    <PackageVersion Include="Groundwork.Core" Version="0.0.1-preview.103" />
    <PackageVersion Include="Groundwork.DiagnosticRecords" Version="0.0.1-preview.103" />
    <PackageVersion Include="Groundwork.Documents" Version="0.0.1-preview.103" />
    <PackageVersion Include="Groundwork.MongoDb" Version="0.0.1-preview.103" />
    <PackageVersion Include="Groundwork.PostgreSql" Version="0.0.1-preview.103" />
    <PackageVersion Include="Groundwork.Sqlite" Version="0.0.1-preview.103" />
    <PackageVersion Include="Groundwork.SqlServer" Version="0.0.1-preview.103" />
    <PackageVersion Include="GitHub.Copilot.SDK" Version="1.0.4" />
    <PackageVersion Include="Anthropic" Version="12.32.0" />
    <PackageVersion Include="JsonSchema.Net" Version="9.2.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.5.1" />
    <PackageVersion Include="Jint" Version="4.9.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Abstractions" Version="2.3.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authorization.Policy" Version="2.3.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Http" Version="2.3.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.10" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Routing" Version="2.3.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Routing.Abstractions" Version="2.3.10" />
    <PackageVersion Include="Microsoft.AspNetCore.StaticFiles" Version="2.3.10" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.10" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Primitives" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <!--
      Transitive pin: no project references Microsoft.OpenApi directly. Because
      CentralPackageTransitivePinningEnabled is true (above), a PackageVersion with no matching
      PackageReference is how this repo pins a transitive dependency's version — here the one
      Microsoft.AspNetCore.OpenApi pulls in. Deleting it silently changes what restores: without it
      the graph resolves 2.0.0, which carries a high-severity advisory (GHSA-v5pm-xwqc-g5wc).
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
    <PackageVersion Include="MongoDB.Driver" Version="3.9.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageVersion Include="Nuplane" Version="0.0.9-preview.61" />
    <PackageVersion Include="Nuplane.Admin" Version="0.0.9-preview.61" />
    <PackageVersion Include="Nuplane.Loading" Version="0.0.9-preview.61" />
    <PackageVersion Include="Nuplane.Sources.Directory" Version="0.0.9-preview.61" />
    <PackageVersion Include="Open.Linq.AsyncExtensions" Version="1.2.0" />
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.5.0" />
    <PackageVersion Include="OpenIddict.Abstractions" Version="7.5.0" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.5.0" />
    <!--
      Transitive pin: no project references SQLitePCLRaw.bundle_e_sqlite3 directly. It is the native
      SQLite bundle that Microsoft.Data.Sqlite pulls in; pinned here so the native provider version
      is deliberate rather than whatever the graph resolves. Without it the graph resolves 2.1.11,
      whose SQLitePCLRaw.lib.e_sqlite3 carries a high-severity advisory (GHSA-2m69-gcr7-jv3q).
      See the Microsoft.OpenApi note above.
    -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageVersion Include="System.CommandLine" Version="2.0.8" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.8" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <PackageVersion Include="Ulid" Version="1.4.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>
</Project>
