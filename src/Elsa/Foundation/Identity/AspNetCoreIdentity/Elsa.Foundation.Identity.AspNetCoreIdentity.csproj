<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<PackageReference Include="CShells.Abstractions" />
		<PackageReference Include="CShells.AspNetCore.Abstractions" />
		<PackageReference Include="Elsa.Platform.PackageManifest.Generator" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\Api\AspNetCore\Elsa.Api.AspNetCore.csproj" />
		<ProjectReference Include="..\..\..\Persistence\Core\Elsa.Persistence.Core.csproj" />
		<ProjectReference Include="..\Abstractions\Elsa.Foundation.Identity.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Provider implementations live in their own nested projects under this domain root; keep the
		     base SDK globs from swallowing them. -->
		<Compile Remove="EntityFrameworkCore/**/*" />
		<EmbeddedResource Remove="EntityFrameworkCore/**/*" />
		<None Remove="EntityFrameworkCore/**/*" />
		<Compile Remove="Groundwork/**/*" />
		<EmbeddedResource Remove="Groundwork/**/*" />
		<None Remove="Groundwork/**/*" />
	</ItemGroup>

</Project>
