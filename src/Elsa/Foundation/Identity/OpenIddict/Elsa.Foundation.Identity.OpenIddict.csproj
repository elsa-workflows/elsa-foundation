<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CShells.Abstractions" />
		<PackageReference Include="Elsa.Platform.PackageManifest.Generator" PrivateAssets="all" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
		<PackageReference Include="OpenIddict.EntityFrameworkCore" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="Behavior\Elsa.Foundation.Identity.OpenIddict.Behavior.csproj" />
		<ProjectReference Include="..\Abstractions\Elsa.Foundation.Identity.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Nested provider-neutral behavior and provider implementation projects own their sources. -->
		<Compile Remove="Behavior/**/*.cs" />
		<Compile Remove="Groundwork/**/*.cs" />
		<EmbeddedResource Remove="Behavior/**/*.resx;Groundwork/**/*.resx" />
		<None Remove="Behavior/**/bin/**;Behavior/**/obj/**;Groundwork/**/bin/**;Groundwork/**/obj/**" />
	</ItemGroup>

</Project>
