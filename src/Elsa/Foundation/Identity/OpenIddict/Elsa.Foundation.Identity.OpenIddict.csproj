<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<PackageReference Include="CShells.Abstractions" />
		<PackageReference Include="Elsa.Platform.PackageManifest.Generator" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="Behavior\Elsa.Foundation.Identity.OpenIddict.Behavior.csproj" />
		<ProjectReference Include="..\Abstractions\Elsa.Foundation.Identity.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Nested behavior and Groundwork projects own their sources; this package owns provider-neutral composition only. -->
		<Compile Remove="Behavior/**/*.cs" />
		<Compile Remove="Groundwork/**/*.cs" />
		<EmbeddedResource Remove="Behavior/**/*.resx;Groundwork/**/*.resx" />
		<None Remove="Behavior/**/bin/**;Behavior/**/obj/**;Groundwork/**/bin/**;Groundwork/**/obj/**" />
	</ItemGroup>

</Project>
