<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.0.1-local</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="CShells.AspNetCore.Abstractions" />
    <PackageReference Include="Elsa.Platform.PackageManifest.Generator" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\Elsa.Diagnostics.StructuredLogs.Core.csproj" />
    <ProjectReference Include="..\..\Api\AspNetCore\Elsa.Api.AspNetCore.csproj" />
    <ProjectReference Include="..\..\Api\Endpoints\Elsa.Api.Endpoints.csproj" />
    <ProjectReference Include="..\..\Foundation\Identity\Abstractions\Elsa.Foundation.Identity.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nested Core project lives under the same domain root; keep SDK globs scoped to this project. -->
    <Compile Remove="Core/**/*" />
    <EmbeddedResource Remove="Core/**/*" />
    <None Remove="Core/**/*" />
    <!-- Nested Persistence projects (EFCore + Sqlite) also live under this domain root. -->
    <Compile Remove="Persistence/**/*" />
    <EmbeddedResource Remove="Persistence/**/*" />
    <None Remove="Persistence/**/*" />
  </ItemGroup>

</Project>
