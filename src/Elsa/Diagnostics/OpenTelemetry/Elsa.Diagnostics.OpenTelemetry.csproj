<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.1-local</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="CShells.FastEndpoints.Abstractions" />
    <PackageReference Include="Elsa.Platform.PackageManifest.Generator" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\Elsa.Diagnostics.OpenTelemetry.Core.csproj" />
    <ProjectReference Include="..\Persistence\Elsa.Diagnostics.Persistence.csproj" />
    <ProjectReference Include="..\..\Api\FastEndpoints\Elsa.Api.FastEndpoints.csproj" />
    <ProjectReference Include="..\..\Primitives\Primitives\Elsa.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nested Core project lives under the same domain root; keep SDK globs scoped to this project. -->
    <Compile Remove="Core/**/*" />
    <Compile Remove="Persistence/**/*" />
    <EmbeddedResource Remove="Core/**/*" />
    <EmbeddedResource Remove="Persistence/**/*" />
    <None Remove="Core/**/*" />
    <None Remove="Persistence/**/*" />
  </ItemGroup>

</Project>
