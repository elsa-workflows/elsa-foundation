<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.1-local</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTelemetry\Core\Elsa.Diagnostics.OpenTelemetry.Core.csproj" />
    <ProjectReference Include="..\StructuredLogs\Core\Elsa.Diagnostics.StructuredLogs.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Groundwork deployment leaf is a separate project beneath this shared, provider-neutral root. -->
    <Compile Remove="Groundwork/**/*" />
    <EmbeddedResource Remove="Groundwork/**/*" />
    <None Remove="Groundwork/**/*" />
  </ItemGroup>

</Project>
