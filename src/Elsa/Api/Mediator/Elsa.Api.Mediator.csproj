    framework without Elsa's mediator pays for neither its contracts nor its pipeline dependency.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspNetCore\Elsa.Api.AspNetCore.csproj" />
    <ProjectReference Include="..\Endpoints\Elsa.Api.Endpoints.csproj" />
    <ProjectReference Include="..\..\Mediator\Core\Elsa.Mediator.Core.csproj" />
  </ItemGroup>

</Project>
