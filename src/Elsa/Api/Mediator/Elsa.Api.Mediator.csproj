<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The mediator half of the shared endpoint layer, kept out of Elsa.Api.AspNetCore so that project
    keeps its zero-reference footprint: a consumer that maps endpoints without Elsa's mediator does
    not pay for Elsa.Mediator.Core and its pipeline dependency.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspNetCore\Elsa.Api.AspNetCore.csproj" />
    <ProjectReference Include="..\..\Mediator\Core\Elsa.Mediator.Core.csproj" />
  </ItemGroup>

</Project>
