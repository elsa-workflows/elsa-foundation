<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.0.1-local</Version>
    <Description>Provider-neutral Elsa composition services for the public Groundwork v2 storage runtime.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Elsa.Persistence.Core.csproj" />
    <ProjectReference Include="..\..\..\Workflows\Runtime\Core\Elsa.Workflows.Runtime.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="Groundwork.Kernel" />
    <PackageReference Include="Groundwork.Query.Model" />
    <PackageReference Include="Groundwork.Store" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provider-specific composition lives in its own dependency-closed project. -->
    <Compile Remove="Providers/**/*" />
    <EmbeddedResource Remove="Providers/**/*" />
    <None Remove="Providers/**/*" />
  </ItemGroup>

</Project>
