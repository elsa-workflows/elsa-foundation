<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Groundwork.MongoDb" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Elsa.Platform.PackageManifest.Generator" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Elsa.Persistence.Groundwork.csproj" />
    <ProjectReference Include="..\Unified\Elsa.Persistence.Groundwork.Unified.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Unified provider project lives under this domain root; keep SDK globs scoped to this project. -->
    <Compile Remove="Unified/**/*" />
    <EmbeddedResource Remove="Unified/**/*" />
    <None Remove="Unified/**/*" />
  </ItemGroup>

</Project>
