<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Shared EF Core persistence policy for first-party Elsa modules under accepted ADR 0073:
      per-module history table naming, provider guard, and migrate vs validate apply modes.
      This package references EF Core + Relational only — never a database provider engine.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

</Project>
