<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose the internal RouteTable to its unit tests so the atomic-swap semantics can be asserted directly. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Authorization.Policy" />
    <PackageReference Include="Microsoft.AspNetCore.Http" />
    <PackageReference Include="Microsoft.AspNetCore.Routing" />
    <PackageReference Include="Microsoft.AspNetCore.StaticFiles" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
	  <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="Elsa.Platform.PackageManifest.Generator" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\Elsa.Http.Core.csproj" />
    <ProjectReference Include="..\Caching\Core\Elsa.Caching.Core.csproj" />
    <ProjectReference Include="..\Primitives\Primitives\Elsa.Primitives.csproj" />
    <ProjectReference Include="..\Serialization\Core\Elsa.Serialization.Core.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- Nested project folders live under the same domain root; keep SDK globs scoped to this project. -->
    <Compile Remove="Core/**/*;JavaScript/**/*" />
    <EmbeddedResource Remove="Core/**/*;JavaScript/**/*" />
    <None Remove="Core/**/*;JavaScript/**/*" />
  </ItemGroup>

</Project>
