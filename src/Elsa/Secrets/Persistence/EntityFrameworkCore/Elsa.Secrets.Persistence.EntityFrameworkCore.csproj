<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Additive EF Core persistence for Secrets (ADR 0072 pilot). Provider-neutral module:
      EF Core + Relational only. Hosts bring exactly one provider package. Groundwork remains
      the default Secrets store; this package is opt-in and does not replace Workbench defaults.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="Elsa.Platform.PackageManifest.Generator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Elsa.Secrets.Core.csproj" />
    <ProjectReference Include="..\..\..\Persistence\EntityFramework\Elsa.Persistence.EntityFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tooling/**" />
    <Compile Remove="Elsa/**" />
    <EmbeddedResource Remove="Tooling/**" />
    <None Remove="Tooling/**" />
  </ItemGroup>

</Project>
