<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CShells.Abstractions" Version="0.0.24" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\Elsa.Events.Core.csproj" />
    <ProjectReference Include="Strategies\Elsa.Events.Strategies.csproj" />
    <ProjectReference Include="..\Pipelines\Core\Elsa.Pipelines.Core.csproj" />
    <ProjectReference Include="..\Primitives\Elsa.Primitives.csproj" />
    <ProjectReference Include="..\Tasks\Core\Elsa.Tasks.Core.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- Nested project folders live under the same domain root; keep SDK globs scoped to this project. -->
    <Compile Remove="Core/**/*;Strategies/**/*" />
    <EmbeddedResource Remove="Core/**/*;Strategies/**/*" />
    <None Remove="Core/**/*;Strategies/**/*" />
  </ItemGroup>

</Project>
