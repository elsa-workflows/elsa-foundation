<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Opt-in EF Core persistence for the Publishing ledger (P01-P06) and the ordered reusable-activity publication commands. Groundwork remains the default.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="Elsa.Platform.PackageManifest.Generator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Elsa.Workflows.Publishing.Core.csproj" />
    <ProjectReference Include="..\..\..\Runtime\Core\Elsa.Workflows.Runtime.Core.csproj" />
    <ProjectReference Include="..\..\..\..\Persistence\EntityFramework\Elsa.Persistence.EntityFramework.csproj" />
    <!-- The reusable-activity publication commands commit their Runtime and Activities Design phases through
         those modules' own EF staging seams, each in its own context (ADR 0066). -->
    <ProjectReference Include="..\..\..\..\Activities\Design\Persistence\Core\Elsa.Activities.Design.Persistence.Core.csproj" />
    <ProjectReference Include="..\..\..\..\Activities\Design\Persistence\EntityFrameworkCore\Elsa.Activities.Design.Persistence.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\..\Runtime\Persistence\EntityFrameworkCore\Elsa.Workflows.Runtime.Persistence.EntityFrameworkCore.csproj" />
    <!-- Applying an activity upgrade commits Activities Design and Workflows Design rows together, so the
         A12/A13 bridge reaches the workflow-design EF lane's own context and stores. -->
    <ProjectReference Include="..\..\..\Design\Persistence\EntityFrameworkCore\Elsa.Workflows.Design.Persistence.EntityFrameworkCore.csproj" />
  </ItemGroup>
</Project>
