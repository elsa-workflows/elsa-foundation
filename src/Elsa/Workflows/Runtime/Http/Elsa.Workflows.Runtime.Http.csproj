<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Authentication, authorization and HttpContext come from the shared framework, matching
         Elsa.Http.Core, which this project exchanges those types with. A standalone Microsoft.AspNetCore.*
         package here would declare the same type names as the framework's and break that exchange at load
         time. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
	  <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="Elsa.Platform.PackageManifest.Generator" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Http\Core\Elsa.Http.Core.csproj" />
    <ProjectReference Include="..\..\..\Primitives\Primitives\Elsa.Primitives.csproj" />
    <ProjectReference Include="..\..\..\Tasks\Core\Elsa.Tasks.Core.csproj" />
    <ProjectReference Include="..\Core\Elsa.Workflows.Runtime.Core.csproj" />
  </ItemGroup>

</Project>
