  <PropertyGroup>
    <AssemblyName>Elsa.Workflows.Runtime.Api.Core</AssemblyName>
    <RootNamespace>Elsa.Workflows.Runtime.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Models\**\*.cs"
             Exclude="..\Models\ActivityExecutionProblemDetails.cs"
             Link="Models\%(RecursiveDir)%(Filename)%(Extension)" />
