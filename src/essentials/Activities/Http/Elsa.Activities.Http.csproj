<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- HttpContext and friends come from the shared framework, matching Elsa.Http.Core, which this project
         exchanges those types with. A standalone Microsoft.AspNetCore.* package here would declare the same
         type names as the framework's and break that exchange at load time. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="CShells.AspNetCore.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Elsa.Specifications.PackageManifest.Generator" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Runtime\Core\Elsa.Activities.Runtime.Core.csproj" />
    <ProjectReference Include="..\..\Http\Core\Elsa.Http.Core.csproj" />
    <ProjectReference Include="..\..\Primitives\Primitives\Elsa.Primitives.csproj" />
    <ProjectReference Include="..\..\Serialization\Core\Elsa.Serialization.Core.csproj" />
    <ProjectReference Include="..\..\Workflows\Runtime\Core\Elsa.Workflows.Runtime.Core.csproj" />
  </ItemGroup>

</Project>
