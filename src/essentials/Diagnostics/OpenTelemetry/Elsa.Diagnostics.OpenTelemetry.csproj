<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="CShells.AspNetCore" />
    <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="Elsa.Specifications.PackageManifest.Generator" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\Elsa.Diagnostics.OpenTelemetry.Core.csproj" />
    <ProjectReference Include="..\..\Api\AspNetCore\Elsa.Api.AspNetCore.csproj" />
    <ProjectReference Include="..\..\Foundation\Identity\Core\Elsa.Foundation.Identity.Core.csproj" />
    <ProjectReference Include="..\..\Foundation\Identity\Elsa.Foundation.Identity.csproj" />
    <ProjectReference Include="..\..\Primitives\Primitives\Elsa.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nested Core project lives under the same domain root; keep SDK globs scoped to this project. -->
    <Compile Remove="Core/**/*" />
    <Compile Remove="Persistence/**/*" />
    <EmbeddedResource Remove="Core/**/*" />
    <EmbeddedResource Remove="Persistence/**/*" />
    <None Remove="Core/**/*" />
    <None Remove="Persistence/**/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NativeEndpoints" />
  </ItemGroup>

</Project>
