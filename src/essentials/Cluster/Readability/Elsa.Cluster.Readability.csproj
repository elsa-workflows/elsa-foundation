<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The readability report source (spec 183, FR-019 to FR-022; B3, #2099). It bridges persistence and cluster
    membership so that neither depends on the other: it reads spec 180's schema-family declarations through
    Elsa.Persistence.Schema, and reports them through the Elsa.Cluster.Core contract, whose closure
    ArchitectureGuardTests.ClusterMembership keeps free of EF. A host composes it once, on its host container, with
    AddEfSchemaReadability, which also brings the in-process membership default.

    It takes no EF Core (#2143): Elsa.Persistence.Schema is the EF-free half of the schema-family surface, and every host
    shares it with the packages it loads, together with Elsa.Cluster.Core. So a host can compose this without carrying EF
    (ADR 0076), although Elsa.Foundation.Host now always carries the EF closure for its durable provider (#2151), and a module Nuplane loads
    with a private copy of Elsa.Persistence.EntityFramework still reaches the host's membership through the types both see.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Elsa.Cluster.Core.csproj" />
    <ProjectReference Include="..\InProcess\Elsa.Cluster.InProcess.csproj" />
    <ProjectReference Include="..\..\Persistence\Schema\Elsa.Persistence.Schema.csproj" />
  </ItemGroup>

</Project>
