<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      The Nuplane adapter for the Secrets module: an ISecretReferenceProvider claiming the 'elsa' provider
      segment, so a private package feed can declare Credentials: secrets://elsa/&lt;name&gt; and have the value
      read out of the Secrets module at reconcile time. Like the Modularity EF adapter it mirrors, it is a
      bridge project rather than a dependency either side takes: it references Elsa.Secrets.Core and the
      Nuplane package, and neither Elsa.Modularity.Nuplane nor Elsa.Secrets.Core references the other or
      this. It references no EF Core assembly of any kind.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="Elsa.Specifications.PackageManifest.Generator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Nuplane" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Elsa.Secrets.Core.csproj" />
  </ItemGroup>

</Project>
