<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="Elsa.Specifications.PackageManifest.Generator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Attention\Core\Elsa.Attention.Core.csproj" />
    <ProjectReference Include="Core\Elsa.Secrets.Core.csproj" />
    <ProjectReference Include="..\Expressions\Core\Elsa.Expressions.Core.csproj" />
    <ProjectReference Include="..\Serialization\Core\Elsa.Serialization.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every sibling project rooted under this one. Elsa.Secrets.csproj sits at the module root, so its
         default globs would otherwise compile each sibling's sources into this assembly as well, and the
         type would exist twice under two assembly identities. -->
    <Compile Remove="Api/**/*;Core/**/*;Nuplane/**/*;Persistence/**/*" />
    <EmbeddedResource Remove="Api/**/*;Core/**/*;Nuplane/**/*;Persistence/**/*" />
    <None Remove="Api/**/*;Core/**/*;Nuplane/**/*;Persistence/**/*" />
  </ItemGroup>

</Project>
