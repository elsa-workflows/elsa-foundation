{
  "//_migrate": "appsettings.Production.json sets Elsa:Persistence:EntityFramework:Migrate:Policy to Validate, so a deployment applies migrations before the host runs. Secrets carries its own MigratePolicy instead of reading that key, so it is named below; without it that one lane auto-migrates in process while every other lane validates.",
  "CShells": {
    "Shells": {
      "default": {
        "Features": {
          "SecretsEntityFrameworkCore": {
            "MigratePolicy": "Validate"
          },
          "IdentityIamEntityFrameworkCore": {},
          "IdentityProviderConfigurationEntityFrameworkCore": {},
          "FoundationIdentityAspNetCoreIdentityEntityFrameworkCore": {
            "IsDevelopmentOrDemo": false,
            "SeedAdminUserName": "admin",
            "SeedAdminPassword": "",
            "SeedAdminEmail": "admin@elsa.local",
            "SeedAdminRoleName": "administrator"
          },
          "FoundationIdentityOpenIddict": {
            "IsDevelopmentOrDemo": false,
            "Issuer": "https://localhost:7243/",
            "ConnectionString": "Data Source=elsa-identity.db"
          },
          "WorkflowsRuntimeApi": {
            "WorkflowAlterationPayloadProtectionActiveKeyId": "configure-via-environment",
            "WorkflowAlterationPayloadProtectionKeys": {
              "development-demo-only": ""
            }
          },
          "WorkflowsRuntimeEntityFrameworkCore": {
            "RecoveryContinuationSigningKey": "",
            "HierarchyCursorSigningKey": ""
          }
        }
      }
    }
  }
}
