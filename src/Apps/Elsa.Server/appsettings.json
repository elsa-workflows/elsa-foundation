{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "CShells.AspNetCore.Middleware.ShellMiddleware": "Warning",
      "CShells.AspNetCore.Resolution.WebRoutingShellResolver": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Polly": "Warning",
      "Nuplane": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7030",
      "https://localhost:7031",
      "http://localhost:5089",
      "http://localhost:5092",
      "http://localhost:5207"
    ]
  },
  "Nuplane": {
    "Setup": {
      "AutomaticReconciliation": true,
      "PollInterval": "00:01:00",
      "Feeds": [
        {
          "Name": "local-packages",
          "DirectoryPath": "packages",
          "IncludePatterns": [
            "*"
          ],
          "Directory": {
            "Watch": true,
            "DebounceWindow": "00:00:01"
          }
        }
      ]
    },
    "Loading": {
      "Enabled": true,
      "SharedAssemblies": [
        {
          "Name": "CShells.Abstractions",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "CShells.AspNetCore.Abstractions",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "CShells.FastEndpoints.Abstractions",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Activities.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Activities.Design.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Activities.Runtime.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Caching.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Expressions.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Expressions.JavaScript.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Http.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Locking.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Mediator.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Persistence.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Primitives",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Serialization.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Tasks.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Tasks.Schedules",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Workflows.Design.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Workflows.Design.Persistence.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Workflows.Runtime.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        }
      ]
    }
  },
  "AllowedHosts": "*",
  "Elsa": {
    "ModuleManagement": {
      "ApiKey": "local-dev-module-management-key"
    },
    "ExtensionBuilder": {
      "Enabled": true
    },
    "Diagnostics": {
      "ConsoleLogStreaming": {
        "// Enabled": "Off by default: these root-mapped endpoints stream captured console output. Turned on for local dev in appsettings.Development.json; enable per-environment deliberately.",
        "Enabled": false
      }
    },
    "Workflows": {
      "Runtime": {
        "FaultCapture": {
          "// CaptureStackTrace": "Captures workflow-fault stack traces in incident/fault records. On by default for this server; disable per-environment if stack traces would leak internals.",
          "CaptureStackTrace": true
        }
      }
    }
  }
}
