### Elsa Server workflow REST loop
###
### Run the server first:
###   dotnet run --project src/Apps/Elsa.Server/Elsa.Server.csproj
###
### The default CShell is mounted under /default.

@host = https://localhost:7243/default

### 01. Find the WriteLine activity definition.
# @name searchWriteLineActivityDefinitions
GET {{host}}/design/activities/definitions?searchTerm=WriteLine
Accept: application/json

> {%
    client.global.set("writeLineActivityDefinitionId", response.body[0].id);
%}

### 02. Find the WriteLine activity version used by the workflow root activity.
# @name listWriteLineActivityVersions
GET {{host}}/design/activities/definitions/{{writeLineActivityDefinitionId}}/versions
Accept: application/json

> {%
    client.global.set("writeLineActivityVersionId", response.body[0].id);
%}

### 03. Submit a workflow definition whose root activity writes "Hello World".
# @name submitHelloWorldWorkflow
POST {{host}}/design/workflows/definitions/submit
Content-Type: application/json
Accept: application/json

{
  "name": "Hello World",
  "description": "Writes Hello World through the WriteLine activity.",
  "state": {
    "variables": [],
    "rootActivity": {
      "nodeId": "write-hello-world",
      "activityVersionId": "{{writeLineActivityVersionId}}",
      "inputs": [
        {
          "referenceKey": "Text",
          "value": {
            "value": "Hello World",
            "expressionType": "Literal"
          },
          "autoEvaluate": null,
          "evaluatorType": null,
          "storageDriverType": null,
          "isSensitive": null
        }
      ],
      "outputs": [],
      "childSlots": null
    },
    "inputs": [],
    "outputs": [],
    "workflowActivityOptions": null,
    "strategyOptions": null
  }
}

> {%
    client.global.set("workflowDefinitionId", response.body.definition.id);
    client.global.set("workflowVersionId", response.body.version.id);
%}

### 04. Publish/compile the submitted workflow definition version into a WorkflowExecutable.
# @name publishHelloWorldWorkflow
POST {{host}}/publishing/workflows/{{workflowVersionId}}/publish
Content-Type: application/json
Accept: application/json

{}

> {%
    client.global.set("workflowExecutableArtifactId", response.body.artifactId);
%}

### 05. Execute the published WorkflowExecutable artifact.
### The server console should print:
###   Hello World
# @name executeHelloWorldWorkflow
POST {{host}}/runtime/workflows/{{workflowExecutableArtifactId}}/execute
Content-Type: application/json
Accept: application/json

{}

> {%
    client.global.set("workflowExecutionId", response.body.workflowExecutionId);
%}

### 06. Optional: execute the same published artifact again.
# @name executeHelloWorldWorkflowAgain
POST {{host}}/runtime/workflows/{{workflowExecutableArtifactId}}/execute
Content-Type: application/json
Accept: application/json

{}

### 07. Find the Sequence activity definition.
# @name searchSequenceActivityDefinitions
GET {{host}}/design/activities/definitions?searchTerm=Sequence
Accept: application/json

> {%
    client.global.set("sequenceActivityDefinitionId", response.body[0].id);
%}

### 08. Find the Sequence activity version used by the workflow root activity.
# @name listSequenceActivityVersions
GET {{host}}/design/activities/definitions/{{sequenceActivityDefinitionId}}/versions
Accept: application/json

> {%
    client.global.set("sequenceActivityVersionId", response.body[0].id);
%}

### 09. Submit a workflow definition whose root Sequence writes two lines.
### Run steps 01, 02, 07, and 08 first so the WriteLine and Sequence version IDs are available.
# @name submitSequenceWriteLinesWorkflow
POST {{host}}/design/workflows/definitions/submit
Content-Type: application/json
Accept: application/json

{
  "name": "Sequence Write Lines",
  "description": "Runs two WriteLine activities inside a Sequence root activity.",
  "state": {
    "variables": [],
    "rootActivity": {
      "nodeId": "sequence-root",
      "activityVersionId": "{{sequenceActivityVersionId}}",
      "inputs": [],
      "outputs": [],
      "childSlots": [
        {
          "name": "Sequence.Activities",
          "activities": [
            {
              "nodeId": "write-sequence-line-one",
              "activityVersionId": "{{writeLineActivityVersionId}}",
              "inputs": [
                {
                  "referenceKey": "Text",
                  "value": {
                    "value": "Sequence line 1",
                    "expressionType": "Literal"
                  },
                  "autoEvaluate": null,
                  "evaluatorType": null,
                  "storageDriverType": null,
                  "isSensitive": null
                }
              ],
              "outputs": [],
              "childSlots": null
            },
            {
              "nodeId": "write-sequence-line-two",
              "activityVersionId": "{{writeLineActivityVersionId}}",
              "inputs": [
                {
                  "referenceKey": "Text",
                  "value": {
                    "value": "Sequence line 2",
                    "expressionType": "Literal"
                  },
                  "autoEvaluate": null,
                  "evaluatorType": null,
                  "storageDriverType": null,
                  "isSensitive": null
                }
              ],
              "outputs": [],
              "childSlots": null
            }
          ],
          "metadata": null
        }
      ]
    },
    "inputs": [],
    "outputs": [],
    "workflowActivityOptions": null,
    "strategyOptions": null
  }
}

> {%
    client.global.set("sequenceWorkflowVersionId", response.body.version.id);
%}

### 10. Publish/compile the "Sequence Write Lines" workflow definition version into a WorkflowExecutable.
# @name publishSequenceWriteLinesWorkflow
POST {{host}}/publishing/workflows/{{sequenceWorkflowVersionId}}/publish
Content-Type: application/json
Accept: application/json

{}

> {%
    client.global.set("sequenceWorkflowExecutableArtifactId", response.body.artifactId);
%}

### 11. Execute the published WorkflowExecutable artifact for "Sequence Write Lines".
### The server console should print:
###   Sequence line 1
###   Sequence line 2
# @name executeSequenceWriteLinesWorkflow
POST {{host}}/runtime/workflows/{{sequenceWorkflowExecutableArtifactId}}/execute
Content-Type: application/json
Accept: application/json

{}

