{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "CShells.AspNetCore.Middleware.ShellMiddleware": "Warning",
      "CShells.AspNetCore.Resolution.WebRoutingShellResolver": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Polly": "Warning",
      "Nuplane": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Elsa": "Data Source=elsa.db"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7030",
      "https://localhost:7031",
      "http://localhost:5089",
      "http://localhost:5092",
      "http://localhost:5207"
    ]
  },
  "Nuplane": {
    "Setup": {
      "AutomaticReconciliation": true,
      "PollInterval": "00:01:00",
      "Feeds": [
        {
          "Name": "local-packages",
          "DirectoryPath": "packages",
          "IncludePatterns": [
            "*"
          ],
          "Directory": {
            "Watch": true,
            "DebounceWindow": "00:00:01"
          }
        }
      ]
    },
    "// HostProvidedPackages": "The packages of the assemblies Loading:SharedAssemblies shares, so Nuplane refuses a feed package that needs a newer host copy (host-version-unsatisfied) instead of binding it to the older one. Binding replaces Nuplane's defaults, so its two contract ids are restated. The Elsa shared assemblies are absent here on purpose: a source build records its Elsa packages at their line's dev version (x.y.0-dev), which every Elsa feed package's range excludes, so declaring them would refuse every Elsa feed package. A build with computed package versions, the CI image among them, records them at the versions the feed carries and declares them: it ships ComputedVersions/appsettings.Production.json as its appsettings.Production.json (ADR 0067, #2084). HostProvidedPackagesGuardTests names the source-build exemption, and fails on anything a source build shares that is neither declared nor exempted, and on anything a computed build shares without declaring.",
    "HostProvidedPackages": [
      "Nuplane.Abstractions",
      "Nuplane.Loading.Abstractions",
      "CShells.Abstractions",
      "CShells.AspNetCore.Abstractions"
    ],
    "Loading": {
      "Enabled": true,
      "SharedAssemblies": [
        {
          "Name": "CShells.Abstractions",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "CShells.AspNetCore.Abstractions",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Activities.Design.Core",
          "PublicKeyToken": null,
          "MajorVersion": 4
        },
        {
          "Name": "Elsa.Activities.Runtime.Core",
          "PublicKeyToken": null,
          "MajorVersion": 4
        },
        {
          "Name": "Elsa.Attention.Core",
          "PublicKeyToken": null,
          "MajorVersion": 4
        },
        {
          "Name": "Elsa.Caching.Core",
          "PublicKeyToken": null,
          "MajorVersion": 4
        },
        {
          "Name": "Elsa.Cluster.Core",
          "PublicKeyToken": null,
          "MajorVersion": 4
        },
        {
          "Name": "Elsa.Events.Core",
          "PublicKeyToken": null,
          "MajorVersion": 4
        },
        {
          "Name": "Elsa.Expressions.Core",
