        },
        {
          "Name": "Elsa.Workflows.Runtime.Core",
          "PublicKeyToken": null,
          "MajorVersion": 4
        }
      ]
    }
  },
  "AllowedHosts": "*",
  "Elsa": {
    "Persistence": {
      "// Resources": "Define named Provider and ConnectionName pairs here. They remain inert until Elsa:Persistence:DefaultResource or a shell binding selects one.",
      "Resources": {}
    },
    "Readiness": {
      "// WarmDefaultShell": "Prepare only the configured default shell after the process starts listening. Disable to retain lazy activation; readiness remains observational.",
      "WarmDefaultShell": true,
      "// DefaultShellName": "Shell observed by /health/ready and optionally prepared in the background.",
      "DefaultShellName": "default"
    },
    "ModuleManagement": {
      "ApiKey": "local-dev-module-management-key"
    },
    "Diagnostics": {
      "ConsoleLogStreaming": {
        "// Enabled": "Off by default: these root-mapped endpoints stream captured console output. Turned on for local dev in appsettings.Development.json; enable per-environment deliberately.",
        "Enabled": false
      }
    },
    "Workflows": {
      "Runtime": {
        "FaultCapture": {
          "// CaptureStackTrace": "Captures workflow-fault stack traces in incident/fault records. On by default for this server; disable per-environment if stack traces would leak internals.",
          "CaptureStackTrace": true
        }
      }
    }
  }
}
