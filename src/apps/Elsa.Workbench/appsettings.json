{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "CShells.AspNetCore.Middleware.ShellMiddleware": "Warning",
      "CShells.AspNetCore.Resolution.WebRoutingShellResolver": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Polly": "Warning",
      "Nuplane": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Elsa": "Data Source=elsa.db"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7030",
      "https://localhost:7031",
      "http://localhost:5089",
      "http://localhost:5092",
      "http://localhost:5207"
    ]
  },
  "Nuplane": {
    "Setup": {
      "AutomaticReconciliation": true,
      "PollInterval": "00:01:00",
      "Feeds": [
        {
          "Name": "local-packages",
          "DirectoryPath": "packages",
          "IncludePatterns": [
            "*"
          ],
          "Directory": {
            "Watch": true,
            "DebounceWindow": "00:00:01"
          }
        }
      ]
    },
    "// HostProvidedPackages": "The packages of the assemblies Loading:SharedAssemblies shares, so Nuplane refuses a feed package that needs a newer host copy (host-version-unsatisfied) instead of binding it to the older one. Binding replaces Nuplane's defaults, so its two contract ids are restated. The Elsa shared assemblies are deliberately absent: a source-built Workbench records its Elsa packages as 1.0.0 while feed packages require >= 4.0.0-preview.N, so declaring them would refuse every Elsa feed package. The exemption lifts once source builds carry real versions (ADR 0067, #1144); HostProvidedPackagesGuardTests names it and fails on anything shared that is neither declared nor exempted.",
    "HostProvidedPackages": [
      "Nuplane.Abstractions",
      "Nuplane.Loading.Abstractions",
      "CShells.Abstractions",
      "CShells.AspNetCore.Abstractions"
    ],
    "Loading": {
      "Enabled": true,
      "SharedAssemblies": [
        {
          "Name": "CShells.Abstractions",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "CShells.AspNetCore.Abstractions",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Activities.Design.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Activities.Runtime.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Caching.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Expressions.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Expressions.JavaScript.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Http.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Locking.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Mediator.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Primitives",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Serialization.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Tasks.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Tasks.Schedules",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Workflows.Design.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Workflows.Design.Persistence.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        },
        {
          "Name": "Elsa.Workflows.Runtime.Core",
          "PublicKeyToken": null,
          "MajorVersion": 0
        }
      ]
    }
  },
  "AllowedHosts": "*",
  "Elsa": {
    "Readiness": {
      "// WarmDefaultShell": "Prepare only the configured default shell after the process starts listening. Disable to retain lazy activation; readiness remains observational.",
      "WarmDefaultShell": true,
      "// DefaultShellName": "Shell observed by /health/ready and optionally prepared in the background.",
      "DefaultShellName": "default"
    },
    "ModuleManagement": {
      "ApiKey": "local-dev-module-management-key"
    },
    "Diagnostics": {
      "ConsoleLogStreaming": {
        "// Enabled": "Off by default: these root-mapped endpoints stream captured console output. Turned on for local dev in appsettings.Development.json; enable per-environment deliberately.",
        "Enabled": false
      }
    },
    "Workflows": {
      "Runtime": {
        "FaultCapture": {
          "// CaptureStackTrace": "Captures workflow-fault stack traces in incident/fault records. On by default for this server; disable per-environment if stack traces would leak internals.",
          "CaptureStackTrace": true
        }
      }
    }
  }
}
