{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Nuplane": {
    "Setup": {
      "AutomaticReconciliation": true,
      "PollInterval": "00:00:10",
      "Feeds": [
        {
          "Name": "local-packages",
          "DirectoryPath": "packages",
          "IncludePatterns": [
            "Elsa.Features.*"
          ],
          "Directory": {
            "Watch": true,
            "DebounceWindow": "00:00:01"
          }
        }
      ]
    },
    "Loading": {
      "Enabled": true,
      "SharedAssemblies": [
        {
          "Name": "CShells.Abstractions"
        },
        {
          "Name": "CShells.AspNetCore.Abstractions"
        }
      ]
    }
  },
  "CShells": {
    "Shells": [
      {
        "Name": "Default",
        "Features": {
          "WorkflowDefinitionsPersistenceEFCoreSqlite": {
            "ConnectionString": "Data Source=app.db",
            "RunMigrations": true,
            "Commands": {
              "Entities": [
                {
                  "EntityType": "WorkflowDefinition",
                  "SupportedCommands": [
                    "Save"
                  ]
                }
              ]
            }
          },
          //"Notifications": {
          //  "DefaultPublishingStrategy": "Background"
          //},
          "FileSystemDistributedLocking": {
            "LockAcquisitionTimeoutMinutes": 3
          },
          //"Expressions": {
          //  "EvaluatorOptions": {
          //    "Arguments": {
          //      "key1":  "value1"
          //    }
          //  }
          //},
          //"MemoryCache": {},
          "Serialization": {},
          "Tasks": {}          
        },
        "Configuration": {
          "WebRouting": {
            "Path": ""
          }
        }
      }
    ]
  },
  "AllowedHosts": "*"
}