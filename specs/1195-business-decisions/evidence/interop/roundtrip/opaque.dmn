<?xml version="1.0" encoding="UTF-8"?><definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="external_defs" name="External approval" namespace="urn:elsa:interop"><!--covered opaque comment--><description>Preserve documentation</description><extensionElements><opaque:meta xmlns:opaque="urn:elsa:interop:opaque" key="keep">payload</opaque:meta></extensionElements><decision id="external_approval" name="External approval"><decisionTable id="external_table" hitPolicy="UNIQUE"><input id="external_amount"><inputExpression id="external_expression" typeRef="number"><text>amount</text></inputExpression></input><output id="external_output" name="result" typeRef="string"/><rule id="external_low"><inputEntry id="external_low_in"><text>&lt;= 1000</text></inputEntry><outputEntry id="external_low_out"><text>"Automatic"</text></outputEntry></rule><rule id="external_high"><inputEntry id="external_high_in"><text>&gt; 1000</text></inputEntry><outputEntry id="external_high_out"><text>"Manager"</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="external_diagram"><dmndi:DMNShape id="external_shape" dmnElementRef="external_approval"><dc:Bounds x="160" y="100" width="180" height="80"/></dmndi:DMNShape></dmndi:DMNDiagram></dmndi:DMNDI></definitions>