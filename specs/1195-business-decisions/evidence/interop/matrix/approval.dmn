<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="defs" name="approval" namespace="urn:elsa:interop:matrix"><inputData id="data" name="value"><variable id="data_var" name="value" typeRef="number" /></inputData><decision id="decision" name="Decision"><informationRequirement id="requirement"><requiredInput href="#data" /></informationRequirement><decisionTable id="table" hitPolicy="UNIQUE"><input id="input" label="value"><inputExpression id="expression" typeRef="number"><text>value</text></inputExpression></input><output id="output0" name="result" typeRef="string" /><rule id="rule0"><inputEntry id="in0"><text>&lt;= 1000</text></inputEntry><outputEntry id="out0_0"><text>"Automatic"</text></outputEntry></rule><rule id="rule1"><inputEntry id="in1"><text>]1000..10000]</text></inputEntry><outputEntry id="out1_0"><text>"Manager"</text></outputEntry></rule><rule id="rule2"><inputEntry id="in2"><text>&gt; 10000</text></inputEntry><outputEntry id="out2_0"><text>"Director"</text></outputEntry></rule></decisionTable></decision></definitions>