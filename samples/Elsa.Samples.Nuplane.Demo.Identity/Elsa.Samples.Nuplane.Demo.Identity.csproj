<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Elsa.Samples.Nuplane.Demo.Identity</PackageId>
    <Version>0.1.0</Version>
    <Authors>Elsa Workflows</Authors>
    <Description>Portable feed-loaded Foundation Identity composition for a Foundation Host Studio demo.</Description>
    <PackageTags>elsa;cshells;nuplane;sample;identity;studio</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5104;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CShells.AspNetCore.Abstractions" />
    <PackageReference Include="Elsa.Specifications.PackageManifest.Generator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\essentials\Foundation\Identity\Api\Elsa.Foundation.Identity.Api.csproj" />
    <ProjectReference Include="..\..\src\essentials\Foundation\Identity\AspNetCoreIdentity\EntityFrameworkCore\Elsa.Foundation.Identity.AspNetCoreIdentity.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\essentials\Foundation\Identity\OpenIddict\Elsa.Foundation.Identity.OpenIddict.csproj" />
    <ProjectReference Include="..\..\src\essentials\Foundation\Identity\Persistence\EntityFrameworkCore\Elsa.Foundation.Identity.Persistence.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\essentials\Persistence\EntityFramework\Elsa.Persistence.EntityFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Update="nuplane.json" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
