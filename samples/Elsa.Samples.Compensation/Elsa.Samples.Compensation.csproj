<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A Nuplane package for Elsa.Workbench: a small reservation participant that follows the compensation participant
    contract, and three workflows that use it (see README.md). Essentials/tests/Workbench/Tests/WorkbenchCompensationSampleTests.cs
    loads it into a real Workbench and runs the three workflows on every pull request, so it cannot drift from what
    compensation does.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Elsa.Samples.Compensation</PackageId>
    <Version>1.0.0</Version>
    <Authors>Elsa Workflows</Authors>
    <Description>Sample Nuplane-loaded Elsa shell feature: a file-backed reservation participant that compensation scopes can undo safely.</Description>
    <PackageTags>elsa;cshells;nuplane;sample;activities;compensation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CShells.Abstractions" GeneratePathProperty="true" />
    <PackageReference Include="Elsa.Specifications.PackageManifest.Generator" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="AddCShellsAbstractionsToPackageManifestReferences" BeforeTargets="GenerateElsaPackageManifest">
    <ItemGroup>
      <ReferencePath Include="$(TargetDir)*.dll" Condition="'$(TargetDir)' != '' and Exists('$(TargetDir)')" />
      <ReferencePath Include="$(PkgCShells_Abstractions)/lib/$(TargetFramework)/CShells.Abstractions.dll" Condition="'$(PkgCShells_Abstractions)' != '' and Exists('$(PkgCShells_Abstractions)/lib/$(TargetFramework)/CShells.Abstractions.dll')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\..\Essentials\src\Activities\Design\Core\Elsa.Activities.Design.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\Essentials\src\Activities\Runtime\Core\Elsa.Activities.Runtime.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\Essentials\src\Primitives\Primitives\Elsa.Primitives.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
