          "FoundationAgentAbstractions": {},
          "FoundationAgentApi": {},
          "FoundationIdentityAbstractions": {},
          "FoundationIdentityOidc": {},
          "FoundationWorkflowsAgent": {},
          "GitHubCopilotAgent": {
            "Enabled": true,
            "GitHubTokenEnvironmentVariable": "COPILOT_GITHUB_TOKEN",
            "Model": "auto",
            "BaseDirectory": ".elsa/copilot"
          },
          "GroundworkProviderPostgreSql": {
            "ConnectionString": "Host=postgres;Port=5432;Database=elsa;Username=elsa;Password=elsa"
          },
          "GroundworkWorkflowRuntime": {
