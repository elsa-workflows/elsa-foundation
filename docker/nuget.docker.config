<?xml version="1.0" encoding="utf-8"?>
<!--
  Docker-build NuGet configuration for the Elsa.Server image.

  Why this exists (and why it is separate from the repo-root NuGet.config):
  The repo-root NuGet.config uses packageSourceMapping and only maps a curated
  set of package patterns to nuget.org. On a developer machine a user-level
  ~/.nuget/NuGet/NuGet.Config supplies a catch-all pattern mapping to nuget.org,
  so unmapped third-party packages (FastEndpoints, JetBrains.Annotations,
  Polly, NuGet.*, Open.Linq.AsyncExtensions, and so on) resolve there. A clean
  build container has no user-level config, so a restore against the repo
  NuGet.config alone fails with NU1100.

  This file is passed to "dotnet restore" via the configfile option for the
  image build only. It reproduces the developer's effective merged
  configuration: the same five sources plus a catch-all on nuget.org. The more
  specific feed mappings (CShells, Nuplane, Groundwork, Elsa.Platform) still win
  via NuGet's longest-prefix rule, so preview packages come from their intended
  feeds.

  All feeds are public (no auth). The repo-root NuGet.config is intentionally
  left unchanged.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="CShells Preview" value="https://f.feedz.io/valence-works/cshells/nuget/index.json" />
    <add key="Nuplane Preview" value="https://f.feedz.io/valence-works/nuplane/nuget/index.json" />
    <add key="Elsa 3 Preview" value="https://f.feedz.io/elsa-workflows/elsa-3/nuget/index.json" />
    <add key="Groundwork Preview" value="https://f.feedz.io/valence-works/groundwork/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="CShells Preview">
      <package pattern="CShells" />
      <package pattern="CShells.*" />
    </packageSource>
    <packageSource key="Nuplane Preview">
      <package pattern="Nuplane" />
      <package pattern="Nuplane.*" />
    </packageSource>
    <packageSource key="Elsa 3 Preview">
      <package pattern="Elsa.Platform.*" />
    </packageSource>
    <packageSource key="Groundwork Preview">
      <package pattern="Groundwork.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
