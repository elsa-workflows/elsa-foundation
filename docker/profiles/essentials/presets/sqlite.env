# Mount a writable volume at /app/data. This is also the image default.
Nuplane__Capabilities__ef-provider=Sqlite
ConnectionStrings__Elsa=Data Source=/app/data/elsa.db
CShells__Shells__default__Features__WorkflowsRuntimeKernelOptionalHttpHosting__Provider=SQLite
CShells__Shells__default__Features__WorkflowsRuntimeKernelOptionalHttpHosting__SqlitePath=/app/data/elsa-kernel.db
