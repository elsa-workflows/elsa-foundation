{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "CShells.AspNetCore.Middleware.ShellMiddleware": "Warning",
      "CShells.AspNetCore.Resolution.WebRoutingShellResolver": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Nuplane": "Warning"
    }
  },
  "ConnectionStrings": {
    "Elsa": "Data Source=elsa-essentials.db"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7030",
      "http://localhost:5089",
      "https://localhost:7028",
      "http://localhost:5087"
    ]
  },
  "Elsa": {
    "Authentication": {
      "Enabled": true
    },
    "Cluster": {
      "RunnabilityReport": {
        "Enabled": true
      }
    },
    "Identity": {
      "OpenIddict": {
        "EntityFrameworkCore": {
          "Enabled": true
        }
      }
    },
    "ModuleManagement": {
      "PackageApiEnabled": true
    },
    "Persistence": {
      "EntityFramework": {
        "Migrate": {
          "GuardFeatureActivation": true
        }
      }
    }
  },
  "Nuplane": {
    "Capabilities": {
      "ef-provider": "Sqlite,SqlServer,PostgreSql,MySql"
    }
  }
}
