+    private static string FormatCommands(IReadOnlyList<CommandObservation> commands) =>
+        string.Join(" ", commands.Select(command => command.Failed ? $"{command.Verb}[failed]" : command.Verb));
+
+    private sealed class CommandCaptureInterceptor : DbCommandInterceptor
+    {
+        private readonly object gate = new();
+        private readonly List<CommandObservation> commands = [];
+        private bool capturing;
+
+        public void BeginCapture()
+        {
+            lock (gate)
+            {
+                if (capturing)
+                    throw new InvalidOperationException("A command capture is already active.");
+                commands.Clear();
+                capturing = true;
+            }
+        }
+
+        public IReadOnlyList<CommandObservation> EndCapture()
+        {
+            lock (gate)
+            {
+                capturing = false;
+                return commands.ToArray();
+            }
+        }
+
+        public override ValueTask<InterceptionResult<DbDataReader>> ReaderExecutingAsync(
+            DbCommand command,
+            CommandEventData eventData,
+            InterceptionResult<DbDataReader> result,
+            CancellationToken cancellationToken = default)
+        {
+            Record(command, eventData);
+            return ValueTask.FromResult(result);
+        }
+
+        public override ValueTask<InterceptionResult<int>> NonQueryExecutingAsync(
+            DbCommand command,
+            CommandEventData eventData,
+            InterceptionResult<int> result,
+            CancellationToken cancellationToken = default)
+        {
+            Record(command, eventData);
+            return ValueTask.FromResult(result);
+        }
+
+        public override Task CommandFailedAsync(
+            DbCommand command,
+            CommandErrorEventData eventData,
+            CancellationToken cancellationToken = default)
+        {
+            lock (gate)
+            {
+                if (!capturing)
+                    return Task.CompletedTask;
+                var index = commands.FindLastIndex(item => item.CommandId == eventData.CommandId);
+                if (index >= 0)
+                    commands[index] = commands[index] with { Failed = true };
+            }
+
+            return Task.CompletedTask;
+        }
+
+        private void Record(DbCommand command, CommandEventData eventData)
+        {
+            lock (gate)
+            {
+                if (capturing)
+                    commands.Add(new CommandObservation(eventData.CommandId, Category(command.CommandText), Failed: false));
+            }
+        }
+
+        private static string Category(string commandText)
+        {
+            var text = commandText.AsSpan().TrimStart();
+            var length = 0;
+            while (length < text.Length && !char.IsWhiteSpace(text[length]))
+                length++;
+            var verb = text[..length].ToString().ToUpperInvariant();
+            return verb is "SELECT" or "INSERT" or "UPDATE" or "DELETE" ? verb : "OTHER";
+        }
+    }
+
+    private sealed record CommandObservation(Guid CommandId, string Verb, bool Failed);
+
