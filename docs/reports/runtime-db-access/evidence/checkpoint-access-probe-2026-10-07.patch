+    private void WriteCommandProbe(string phase, IReadOnlyCollection<string> commands)
+    {
+        _output.WriteLine($"CHECKPOINT_COMMAND_PROBE phase={phase} count={commands.Count} ordered={string.Join(" > ", commands)}");
+        foreach (var group in commands.GroupBy(command => command).OrderBy(group => group.Key, StringComparer.Ordinal))
+            _output.WriteLine($"CHECKPOINT_COMMAND_PROBE_COUNT phase={phase} category={group.Key} count={group.Count()}");
+    }
+
+    private static string DescribeCapturedCommand(string command)
+    {
+        var firstWord = new string(command.TrimStart().TakeWhile(character => !char.IsWhiteSpace(character)).ToArray()).ToUpperInvariant();
+        var verb = firstWord is "SELECT" or "INSERT" or "UPDATE" or "DELETE" ? firstWord : "OTHER";
+        (string Fragment, string Category)[] tableCategories =
+        [
+            ("checkpoint_commit", "marker"),
+            ("activity_execution", "activity_execution"),
+            ("bookmark", "bookmark"),
+            ("workflow_execution", "workflow_execution"),
+            ("scheduler_state", "scheduler"),
+            ("durable_value", "durable_value"),
+            ("inspection", "inspection"),
+            ("incident", "incident"),
+            ("liveness", "execution_fence")
+        ];
+        var categories = tableCategories
+            .Where(candidate => command.Contains(candidate.Fragment, StringComparison.OrdinalIgnoreCase))
+            .Select(candidate => candidate.Category)
+            .Distinct(StringComparer.Ordinal)
+            .OrderBy(category => category, StringComparer.Ordinal)
+            .ToArray();
+        return $"{verb}/{(categories.Length == 0 ? "other" : string.Join("+", categories))}";
+    }
