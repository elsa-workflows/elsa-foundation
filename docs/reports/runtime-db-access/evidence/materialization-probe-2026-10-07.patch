+    private sealed class MaterializationProbe
+    {
+        private readonly object _sync = new();
+        private readonly Dictionary<RuntimeCoalescingSession, int> _sessionIds = new(ReferenceEqualityComparer.Instance);
+        private readonly List<PageRead> _pageReads = [];
+        private readonly List<MaterializationObservation> _materializations = [];
+        private int _nextSessionId;
+        private int _lastPageReadCount;
+        private int _lastDirectDurableWriteCount;
+        private int _lastLogicalDurableChangeItemCount;
+
+        public int InnerPageReadCount { get { lock (_sync) return _pageReads.Count; } }
+        public IReadOnlyList<string> InnerPageReadCallerChains
+        {
+            get { lock (_sync) return _pageReads.Select(read => read.Callers).Distinct().ToArray(); }
+        }
+        public int DirectDurableWriteCount { get; private set; }
+        public int LogicalDurableChangeItemCount { get; private set; }
+        public IReadOnlyList<MaterializationObservation> Materializations
+        {
+            get { lock (_sync) return _materializations.ToArray(); }
+        }
+
+        public void RecordInnerPageRead(RuntimeCoalescingSession? session, string callers)
+        {
+            lock (_sync)
+                _pageReads.Add(new PageRead(GetSessionId(session), callers));
+        }
+
+        public void RecordDirectDurableWrite()
+        {
+            lock (_sync)
+                DirectDurableWriteCount++;
+        }
+
+        public void RecordLogicalCommit(int durableChangeCount, RuntimeCoalescingSession? session)
+        {
+            if (durableChangeCount == 0)
+                return;
+            lock (_sync)
+                LogicalDurableChangeItemCount += durableChangeCount;
+        }
+
+        public void RecordMaterialization(string invocationId, RuntimeCoalescingSession? session, int innerCommitCount)
+        {
+            lock (_sync)
+            {
+                var pageWindow = _pageReads.Skip(_lastPageReadCount).ToArray();
+                var sessionId = GetSessionId(session);
+                _materializations.Add(new MaterializationObservation(
+                    invocationId,
+                    sessionId,
+                    SessionActive: session?.IsActive == true,
+                    HopCount: session?.HopCount ?? -1,
+                    InnerCommitCount: innerCommitCount,
+                    StagedDurableUpserts: session?.GetDurableValueUpserts().Count ?? 0,
+                    StagedDurableDeletes: session?.GetDurableValueTombstones().Count ?? 0,
+                    PageReadsSincePriorMaterialization: pageWindow.Length,
+                    PageReadSessionIds: pageWindow.Select(read => read.SessionId).ToArray(),
+                    LogicalDurableChangesSincePriorMaterialization: LogicalDurableChangeItemCount - _lastLogicalDurableChangeItemCount,
+                    DirectDurableWritesSincePriorMaterialization: DirectDurableWriteCount - _lastDirectDurableWriteCount));
+                _lastPageReadCount = _pageReads.Count;
+                _lastLogicalDurableChangeItemCount = LogicalDurableChangeItemCount;
+                _lastDirectDurableWriteCount = DirectDurableWriteCount;
+            }
+        }
+
+        private int? GetSessionId(RuntimeCoalescingSession? session)
+        {
+            if (session is null)
+                return null;
+            if (_sessionIds.TryGetValue(session, out var id))
+                return id;
+            id = ++_nextSessionId;
+            _sessionIds.Add(session, id);
+            return id;
+        }
+
+        private sealed record PageRead(int? SessionId, string Callers);
+    }
+
+    private sealed record MaterializationObservation(
+        string InvocationId,
+        int? SessionId,
+        bool SessionActive,
+        int HopCount,
+        int InnerCommitCount,
+        int StagedDurableUpserts,
+        int StagedDurableDeletes,
+        int PageReadsSincePriorMaterialization,
+        IReadOnlyList<int?> PageReadSessionIds,
+        int LogicalDurableChangesSincePriorMaterialization,
+        int DirectDurableWritesSincePriorMaterialization);
+
