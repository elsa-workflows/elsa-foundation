+        }
+
+        public ValueTask<DurableValueState?> FindAsync(string workflowExecutionId, string durableValueId, CancellationToken cancellationToken = default) =>
+            inner.FindAsync(workflowExecutionId, durableValueId, cancellationToken);
+
+        public ValueTask<RuntimeStorePage<DurableValueState>> ListPageAsync(
+            DurableValueStatePageQuery query,
+            CancellationToken cancellationToken = default)
+        {
+            var callers = string.Join(" <- ", new System.Diagnostics.StackTrace(1, false)
+                .GetFrames()?
+                .Select(frame => frame.GetMethod() is { } method
+                    ? $"{method.DeclaringType?.Name}.{method.Name}"
+                    : "<unknown>")
+                .Take(20) ?? []);
+            probe.RecordInnerPageRead(sessionAccessor.Current, callers);
+            return inner.ListPageAsync(query, cancellationToken);
+        }
+    }
