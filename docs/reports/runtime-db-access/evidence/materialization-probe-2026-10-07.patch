+    private static void DecorateService<TService>(
+        IServiceCollection services,
+        Func<IServiceProvider, TService, TService> decorate)
+        where TService : class
+    {
+        var descriptor = services.Last(item => item.ServiceType == typeof(TService));
+        services.Remove(descriptor);
+        services.Add(ServiceDescriptor.Describe(
+            typeof(TService),
+            provider => decorate(provider, (TService)CreateDescriptorInstance(descriptor, provider)),
+            descriptor.Lifetime));
+    }
+
+    private static object CreateDescriptorInstance(ServiceDescriptor descriptor, IServiceProvider provider)
+    {
+        if (descriptor.ImplementationInstance is { } instance)
+            return instance;
+        if (descriptor.ImplementationFactory is { } factory)
+            return factory(provider);
+        return ActivatorUtilities.CreateInstance(provider, descriptor.ImplementationType!);
+    }
