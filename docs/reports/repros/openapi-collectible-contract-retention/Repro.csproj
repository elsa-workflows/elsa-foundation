<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" VersionOverride="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" VersionOverride="2.7.5" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Contract/**/*" />
    <EmbeddedResource Remove="Contract/**/*" />
    <None Remove="Contract/**/*" />
  </ItemGroup>
</Project>
