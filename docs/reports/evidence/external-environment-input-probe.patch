+    private sealed class SpikeOwnedEnvironment : IDisposable
+    {
+        private readonly Dictionary<string, string?> original = new(StringComparer.Ordinal);
+        public string Prefix { get; } = $"ELSA_SPIKE_2184_{Guid.NewGuid():N}__";
+
+        public void Set(string key, string? value)
+        {
+            var name = Prefix + key;
+            original.TryAdd(name, System.Environment.GetEnvironmentVariable(name));
+            System.Environment.SetEnvironmentVariable(name, value);
+        }
+
+        public ConfigurationRoot Capture(IReadOnlyDictionary<string, byte[]> files)
+        {
+            using var fileOnly = ReadConfiguration(files);
+            using var composed = (ConfigurationRoot)new ConfigurationBuilder()
+                .AddConfiguration(fileOnly).AddEnvironmentVariables(Prefix).Build();
+            // Only a detached in-memory root crosses this test-only boundary; Reload cannot reread ambient input.
+            return (ConfigurationRoot)new ConfigurationBuilder().AddInMemoryCollection(composed.AsEnumerable()).Build();
+        }
+
+        public void Dispose()
+        {
+            foreach (var row in original)
+                System.Environment.SetEnvironmentVariable(row.Key, row.Value);
+        }
+    }
