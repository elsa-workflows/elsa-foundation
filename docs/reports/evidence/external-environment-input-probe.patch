+    private static async Task<EfPersistencePreparationResult> SpikePrepareAsync(IConfigurationRoot frozen)
+    {
+        var context = EfConfigurationProbeTests.ComposeRuntimeContext(frozen, Shell);
+        var patch = await new EfPersistenceShellSettingsPreparer(frozen).PrepareAsync(context, CancellationToken.None);
+        var prepared = EfPersistencePreparation.Prepare(context, frozen,
+            EfConfigurationProbeTests.HostAssemblies, verifyConnectionValues: true);
+        Assert.Empty(prepared.RefusalCodes);
+        Assert.Equal(prepared.Patch.ConfigurationData.OrderBy(row => row.Key, StringComparer.Ordinal),
+            patch.ConfigurationData.OrderBy(row => row.Key, StringComparer.Ordinal));
+        return prepared;
+    }
