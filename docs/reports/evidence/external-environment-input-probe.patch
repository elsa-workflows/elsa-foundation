+        Assert.Equal(EfToolingExitCode.Refusal, exit);
+        Assert.Equal(0, discoveries);
+        using var document = JsonDocument.Parse(response.ToArray());
+        Assert.Equal("candidate-request-invalid", document.RootElement.GetProperty("error").GetProperty("code").GetString());
+        Assert.True(!Encoding.UTF8.GetString(response.ToArray()).Contains(ConnectionCanary, StringComparison.Ordinal),
