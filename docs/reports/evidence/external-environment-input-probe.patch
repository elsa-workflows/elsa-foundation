+        Assert.Equal(EfToolingExitCode.Success, toolingExit);
+        Assert.True(tooling.GetProperty("configurationContext").GetProperty("participants").EnumerateArray()
+                .All(row => row.GetProperty("resource").GetString() == "root-base"),
+            "The existing internal tooling context must consume the identical frozen root.");
+        Assert.Equal("not-performed", tooling.GetProperty("configurationContext").GetProperty("targetVerification").GetString());
