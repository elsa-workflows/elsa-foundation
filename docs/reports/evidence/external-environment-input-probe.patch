+    [Fact]
+    public async Task Spike_external_capture_survives_source_mutation_reload_and_removal()
+    {
+        var files = BuildSameCaptureFiles("environment-resource-override");
+        using var ownedEnvironment = new SpikeOwnedEnvironment();
+        const string selector = "Elsa__Persistence__DefaultResource";
+        ownedEnvironment.Set(selector, "root-base");
+        using var first = ownedEnvironment.Capture(files);
+        ownedEnvironment.Set(selector, "primary");
+        first.Reload();
+        using var changed = ownedEnvironment.Capture(files);
+        ownedEnvironment.Set(selector, null);
+        using var removed = ownedEnvironment.Capture(files);
+
+        Assert.True((await SpikePrepareAsync(first)).ResolvedParticipants.All(row => row.ResourceName == "root-base"),
+            "An already captured root must not reread the mutable environment, even on Reload.");
+        Assert.True((await SpikePrepareAsync(changed)).ResolvedParticipants.All(row => row.ResourceName == "primary"),
+            "A deliberate new capture must observe the changed external selection.");
+        Assert.True((await SpikePrepareAsync(removed)).ResolvedParticipants.All(row => row.ResourceName == "primary"),
+            "Removing an environment variable must reveal the file selection, not write a null override.");
+        Assert.True(removed["Elsa:Persistence:DefaultResource"] == "primary",
+            "Environment removal must retain the existing JSON value.");
+        Assert.Empty(Directory.EnumerateFiles(temporaryDirectory));
+    }
